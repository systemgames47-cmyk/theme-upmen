<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="{{ settings.color_brand_dark }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}" sizes="32x32">
    {%- elsif settings.logo -%}
      <link rel="icon" type="image/png" href="{{ settings.logo | image_url: width: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'MM_ProductImages_PDP_1x1__1.png' | asset_url }}">
    {%- endif -%}

    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="canonical" href="{{ canonical_url }}">

    <title>
      {%- if page_title == blank -%}
        {{ shop.name }}
      {%- else -%}
        {{ page_title }}{% if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif %}{% if current_page != 1 %} &ndash; Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}
      {%- endif -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    {{ content_for_header }}

    {%- unless settings.use_custom_fonts -%}
      <link rel="preconnect" href="https://fonts.googleapis.com">
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
      <link href="https://fonts.googleapis.com/css2?family=Martian+Mono:wght@400;500;700;800&family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    {%- endunless -%}

    <link rel="stylesheet" href="{{ 'theme.css' | asset_url }}">
    <style>
      {%- if settings.use_custom_fonts -%}
        {{ settings.font_heading | font_face: font_display: 'swap' }}
        {{ settings.font_body | font_face: font_display: 'swap' }}
        {%- assign font_heading_bold = settings.font_heading | font_modify: 'weight', 'bolder' -%}
        {%- assign font_body_bold = settings.font_body | font_modify: 'weight', 'bolder' -%}
        {%- if font_heading_bold -%}{{ font_heading_bold | font_face: font_display: 'swap' }}{%- endif -%}
        {%- if font_body_bold -%}{{ font_body_bold | font_face: font_display: 'swap' }}{%- endif -%}
      {%- endif -%}
      :root {
        --brand: {{ settings.color_brand | default: '#ff5600' }};
        --brand-dark: {{ settings.color_brand_dark | default: '#120804' }};
        --brand-soft: {{ settings.color_brand_soft | default: '#fff4ec' }};
        --brand-green: {{ settings.color_brand_green | default: '#39c46e' }};
        --brand-yellow: {{ settings.color_brand_yellow | default: '#ff8a00' }};
        --text: {{ settings.color_text | default: '#ffffff' }};
        --mars-black: #0a0503;
        --mars-panel: #1a0e07;
        --mars-line: rgba(255, 255, 255, 0.12);
        {%- if settings.use_custom_fonts %}
        --font-body: {{ settings.font_body.family }}, {{ settings.font_body.fallback_families }};
        --font-heading: {{ settings.font_heading.family }}, {{ settings.font_heading.fallback_families }};
        {%- else %}
        --font-body: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        --font-heading: 'Martian Mono', 'Courier New', monospace;
        {%- endif %}
        --fs-h: {{ settings.heading_scale | default: 100 | divided_by: 100.0 }};
        --fs-b: {{ settings.body_scale | default: 100 | divided_by: 100.0 }};
      }
      body { background: var(--mars-black); }
    </style>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>
  <body class="template-{{ template | replace: '.', '-' | handle }}">
    <a class="sr-only" href="#MainContent">{{ 'general.accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% section 'footer' %}

    {% if template == 'index' %}
      {% section 'sticky-footer' %}
    {% endif %}

    {% render 'cart-drawer' %}
  </body>
</html>
