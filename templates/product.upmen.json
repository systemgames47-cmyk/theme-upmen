ents-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Fenugreek</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">Fuels testosterone, DHT and raw male drive</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">1,000mg</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__ingredients-row\">\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Taurine</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">Drives blood flow — the reason she thinks you got bigger</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">675mg</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__ingredients-row\">\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Shilajit</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">Ancient mineral resin. Boosts T and fertility.</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">400mg</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__ingredients-row\">\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Zinc</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">The mineral your testosterone can't live without</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">30mg</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__ingredients-row\">\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Boron</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">Frees up your T, keeps estrogen in check</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">4mg</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__ingredients-row\">\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Vitamin D</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">The sunshine hormone your T levels are begging for</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">100mcg</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__ingredients-row\">\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--name\">\n            <p class=\"mpv1-dtv2__ingredient-name\">Vitamin K1 + K2</p>\n            <p class=\"mpv1-dtv2__ingredient-sub\">Bone strength, better mood, more T production</p>\n          </div>\n          <div class=\"mpv1-dtv2__ingredients-divider\" aria-hidden=\"true\"></div>\n          <div class=\"mpv1-dtv2__ingredients-col mpv1-dtv2__ingredients-col--mg\">\n            <p class=\"mpv1-dtv2__ingredient-mg\">200mcg</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n    {%- comment -%} ===== Tab 5: FAQ's ===== {%- endcomment -%}\n    <div id=\"mpv1-dtv2-panel-4-{{ dtv2_id }}\" class=\"mpv1-dtv2__panel\" role=\"tabpanel\" data-dtv2-panel=\"4\">\n      <div class=\"mpv1-dtv2__faq\">\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-1\">\n            <span>How Do I Take UP MEN?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-1\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>Take 5 capsules daily with food. Consistency is key — daily use at the same time helps your body get the most from the formula's blend of Tongkat Ali, Fenugreek, Taurine, Shilajit, Zinc, Boron and Vitamins D, K1 and K2.</p>\n            <p>For best results, make UP MEN part of your daily routine.</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-2\">\n            <span>What If It Doesn't Work For Me?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-2\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>Your purchase is backed by our 90-Day Satisfaction Guarantee, according to the terms of the published policy. We encourage you to use UP MEN consistently to experience the full benefits of the formula.</p>\n            <p>If you're not completely satisfied, simply contact our support team and we'll make it right.</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-3\">\n            <span>When Will I See Results?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-3\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>Results vary from person to person. Some customers report feeling improvements in energy, focus, and overall vitality within the first few weeks of consistent use.</p>\n            <p>For optimal results, we recommend taking UP MEN daily for at least 8–12 weeks.</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-4\">\n            <span>How Fast Is Shipping?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-4\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>Orders are processed quickly and shipped directly from our fulfillment center. Tracking information is provided as soon as your order ships — and all physical welcome gifts ship together with your first order.</p>\n            <p>Delivery times may vary depending on your location.</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-5\">\n            <span>Is UP MEN Third-Party Tested?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-5\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>Yes. Every batch is made in the USA in a CGMP-certified facility and undergoes third-party testing for quality, purity, and safety. We believe you should know exactly what you're putting into your body.</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-6\">\n            <span>Who Is UP MEN For?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-6\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>UP MEN is designed for men who want to support their testosterone, energy, focus, confidence, and overall performance. Whether you're balancing work, fitness, family life, or all three, UP MEN is formulated to help you perform at your best every day.</p>\n          </div>\n        </div>\n\n        <div class=\"mpv1-dtv2__faq-item\">\n          <button type=\"button\" class=\"mpv1-dtv2__faq-question\" aria-expanded=\"false\" aria-controls=\"mpv1-dtv2-faq-{{ dtv2_id }}-7\">\n            <span>Is This Harmful To Take With Medication?</span>\n            <svg class=\"mpv1-dtv2__faq-chevron\" width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\" aria-hidden=\"true\"><path d=\"M7.29414 10.709C7.68477 11.0996 8.31914 11.0996 8.70977 10.709L14.7098 4.70896C15.1004 4.31834 15.1004 3.68396 14.7098 3.29333C14.3191 2.90271 13.6848 2.90271 13.2941 3.29333L8.00039 8.58709L2.70664 3.29646C2.31602 2.90583 1.68164 2.90583 1.29102 3.29646C0.900391 3.68708 0.900391 4.32146 1.29102 4.71208L7.29102 10.7121L7.29414 10.709Z\" fill=\"#1A1A1A\"></path></svg>\n          </button>\n          <div id=\"mpv1-dtv2-faq-{{ dtv2_id }}-7\" class=\"mpv1-dtv2__faq-answer\" hidden>\n            <p>The ingredients are generally well tolerated. However, if you take any medication (especially anticoagulants), have a medical condition, or already use supplements containing vitamin D, vitamin K, zinc or boron, consult a qualified healthcare professional before use.</p>\n          </div>\n        </div>\n\n      </div>\n    </div>\n\n  </div>\n</div>\n\n<script>\n  (function () {\n    var root = document.getElementById('{{ dtv2_id }}');\n    if (!root || root.hasAttribute('data-dtv2-init')) return;\n    root.setAttribute('data-dtv2-init', '');\n\n    /* ---- Tabs ---- */\n    var tabs = root.querySelectorAll('[data-dtv2-tab]');\n    var panels = root.querySelectorAll('[data-dtv2-panel]');\n    tabs.forEach(function (tab) {\n      tab.addEventListener('click', function () {\n        var idx = tab.getAttribute('data-dtv2-tab');\n        tabs.forEach(function (t) {\n          var active = t === tab;\n          t.classList.toggle('mpv1-dtv2__tab--active', active);\n          t.setAttribute('aria-selected', active ? 'true' : 'false');\n        });\n        panels.forEach(function (p) {\n          p.classList.toggle('mpv1-dtv2__panel--active', p.getAttribute('data-dtv2-panel') === idx);\n        });\n      });\n    });\n\n    /* ---- FAQ accordion ---- */\n    root.querySelectorAll('.mpv1-dtv2__faq-question').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var answer = document.getElementById(btn.getAttribute('aria-controls'));\n        var isOpen = btn.getAttribute('aria-expanded') === 'true';\n\n        /* close the others */\n        root.querySelectorAll('.mpv1-dtv2__faq-question[aria-expanded=\"true\"]').forEach(function (openBtn) {\n          if (openBtn !== btn) {\n            openBtn.setAttribute('aria-expanded', 'false');\n            var openAnswer = document.getElementById(openBtn.getAttribute('aria-controls'));\n            if (openAnswer) openAnswer.hidden = true;\n          }\n        });\n\n        btn.setAttribute('aria-expanded', isOpen ? 'false' : 'true');\n        if (answer) answer.hidden = isOpen;\n      });\n    });\n  })();\n</script>",
