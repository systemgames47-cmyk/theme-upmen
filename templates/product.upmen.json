    "custom_liquid_RfDALj": {
      "type": "custom-liquid",
      "name": "Custom Liquid",
      "settings": {
        "heading": "",
        "custom_liquid": "{% comment %}\n  ============================================================\n  UP MEN — \"Doctor Approved\" Tabs (original UltimaPeak design)\n  Single self-contained Custom Liquid block for Shopify\n  Keeps the original markup, classes (mpv1-dtv2), icons and\n  photos — only the content is adapted to UP MEN.\n  How to use: Theme editor → Add \"Custom Liquid\" block →\n  paste this entire code.\n  ============================================================\n{% endcomment %}\n\n{%- assign dtv2_id = 'doctor_tabs_v2_' | append: section.id -%}\n\n<style>\n  .mpv1-dtv2{max-width:640px;margin:0 auto;padding:8px 0;font-family:inherit;color:#1a1a1a;}\n  .mpv1-dtv2 *{box-sizing:border-box;}\n\n  /* ---------- Tabs header ---------- */\n  .mpv1-dtv2__header{display:flex;flex-wrap:nowrap;gap:8px;overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding:4px 2px;margin-bottom:16px;}\n  .mpv1-dtv2__header::-webkit-scrollbar{display:none;}\n  .mpv1-dtv2__tab{flex:0 0 auto;appearance:none;border:1px solid #e6e2da;background:#fff;color:#1a1a1a;\n    font-size:13px;font-weight:600;line-height:1.2;padding:10px 14px;border-radius:999px;cursor:pointer;white-space:nowrap;transition:all .2s ease;font-family:inherit;}\n  .mpv1-dtv2__tab:hover{border-color:#1a1a1a;}\n  .mpv1-dtv2__tab--active{background:#1a1a1a;border-color:#1a1a1a;color:#fff;}\n\n  /* ---------- Panels ---------- */\n  .mpv1-dtv2__panel{display:none;background:#faf8f4;border:1px solid #e6e2da;border-radius:16px;padding:20px;}\n  .mpv1-dtv2__panel--active{display:block;animation:dtv2Fade .25s ease;}\n  @keyframes dtv2Fade{from{opacity:0;transform:translateY(4px);}to{opacity:1;transform:none;}}\n\n  /* ---------- Doctor Approved ---------- */\n  .mpv1-dtv2__quote{font-size:15px;line-height:1.6;margin:0 0 16px;font-style:italic;}\n  .mpv1-dtv2__author{display:flex;align-items:center;gap:12px;}\n  .mpv1-dtv2__avatar{width:56px;height:56px;border-radius:50%;object-fit:cover;flex:0 0 auto;}\n  .mpv1-dtv2__author-name{margin:0;font-weight:700;font-size:14px;}\n  .mpv1-dtv2__author-specialty{margin:2px 0 0;font-size:13px;color:#6b6b6b;line-height:1.4;}\n\n  /* ---------- Comparison table ---------- */\n  .mpv1-dtv2__comparison-header,.mpv1-dtv2__comparison-row{display:grid;grid-template-columns:1fr 72px 72px;align-items:center;gap:8px;}\n  .mpv1-dtv2__comparison-header{padding:0 0 12px;border-bottom:1px solid #e6e2da;}\n  .mpv1-dtv2__comparison-row{padding:14px 0;border-bottom:1px solid #e6e2da;}\n  .mpv1-dtv2__comparison-row:last-child{border-bottom:none;padding-bottom:0;}\n  .mpv1-dtv2__comparison-col--brand,.mpv1-dtv2__comparison-col--others{text-align:center;font-size:13px;font-weight:700;}\n  .mpv1-dtv2__comparison-logo{max-width:44px;height:auto;display:inline-block;}\n  .mpv1-dtv2__comparison-brand-text{font-size:13px;font-weight:800;letter-spacing:.02em;}\n  .mpv1-dtv2__comparison-feature-name{margin:0;font-size:14px;font-weight:700;line-height:1.35;}\n  .mpv1-dtv2__comparison-feature-sub{margin:3px 0 0;font-size:12.5px;color:#6b6b6b;line-height:1.4;}\n  .mpv1-dtv2__comparison-col--check,.mpv1-dtv2__comparison-col--cross{display:flex;justify-content:center;}\n\n  /* ---------- Ingredients ---------- */\n  .mpv1-dtv2__ingredients-header,.mpv1-dtv2__ingredients-row{display:grid;grid-template-columns:1fr 1px 110px;align-items:center;gap:12px;}\n  .mpv1-dtv2__ingredients-header{font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#6b6b6b;padding-bottom:12px;border-bottom:1px solid #e6e2da;}\n  .mpv1-dtv2__ingredients-header .mpv1-dtv2__ingredients-col--mg{text-align:right;}\n  .mpv1-dtv2__ingredients-row{padding:14px 0;border-bottom:1px solid #e6e2da;}\n  .mpv1-dtv2__ingredients-row:last-child{border-bottom:none;padding-bottom:0;}\n  .mpv1-dtv2__ingredients-divider{width:1px;height:100%;background:transparent;}\n  .mpv1-dtv2__ingredient-name{margin:0;font-size:14px;font-weight:700;line-height:1.35;}\n  .mpv1-dtv2__ingredient-sub{margin:3px 0 0;font-size:12.5px;color:#6b6b6b;line-height:1.4;}\n  .mpv1-dtv2__ingredient-mg{margin:0;font-size:14px;font-weight:700;text-align:right;white-space:nowrap;}\n\n  /* ---------- FAQ ---------- */\n  .mpv1-dtv2__faq-item{border-bottom:1px solid #e6e2da;}\n  .mpv1-dtv2__faq-item:last-child{border-bottom:none;}\n  .mpv1-dtv2__faq-question{appearance:none;background:none;border:none;width:100%;display:flex;justify-content:space-between;align-items:center;gap:12px;\n    padding:14px 0;font-size:14px;font-weight:600;text-align:left;color:#1a1a1a;cursor:pointer;font-family:inherit;line-height:1.4;}\n  .mpv1-dtv2__faq-chevron{flex:0 0 auto;transition:transform .25s ease;}\n  .mpv1-dtv2__faq-question[aria-expanded=\"true\"] .mpv1-dtv2__faq-chevron{transform:rotate(180deg);}\n  .mpv1-dtv2__faq-answer{padding:0 0 14px;}\n  .mpv1-dtv2__faq-answer[hidden]{display:none;}\n  .mpv1-dtv2__faq-answer p{margin:0 0 12px;font-size:13.5px;line-height:1.6;color:#3a3a3a;}\n  .mpv1-dtv2__faq-answer p:last-child{margin-bottom:0;}\n\n  @media (max-width:480px){\n    .mpv1-dtv2__panel{padding:16px;}\n    .mpv1-dtv2__comparison-header,.mpv1-dtv2__comparison-row{grid-template-columns:1fr 56px 56px;}\n    .mpv1-dtv2__ingredients-header,.mpv1-dtv2__ingredients-row{grid-template-columns:1fr 1px 90px;}\n  }\n</style>\n\n<div class=\"mpv1-dtv2\" id=\"{{ dtv2_id }}\">\n  <div class=\"mpv1-dtv2__header\" role=\"tablist\">\n    <button type=\"button\" class=\"mpv1-dtv2__tab mpv1-dtv2__tab--active\" role=\"tab\" aria-selected=\"true\" aria-controls=\"mpv1-dtv2-panel-0-{{ dtv2_id }}\" data-dtv2-tab=\"0\">\n      Doctor Approved\n    </button>\n    <button type=\"button\" class=\"mpv1-dtv2__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"mpv1-dtv2-panel-1-{{ dtv2_id }}\" data-dtv2-tab=\"1\">\n      Product Details\n    </button>\n    <button type=\"button\" class=\"mpv1-dtv2__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"mpv1-dtv2-panel-2-{{ dtv2_id }}\" data-dtv2-tab=\"2\">\n      Comparison Table\n    </button>\n    <button type=\"button\" class=\"mpv1-dtv2__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"mpv1-dtv2-panel-3-{{ dtv2_id }}\" data-dtv2-tab=\"3\">\n      Ingredients\n    </button>\n    <button type=\"button\" class=\"mpv1-dtv2__tab\" role=\"tab\" aria-selected=\"false\" aria-controls=\"mpv1-dtv2-panel-4-{{ dtv2_id }}\" data-dtv2-tab=\"4\">\n      FAQ's\n    </button>\n  </div>\n\n  <div class=\"mpv1-dtv2__panels\">\n\n    {%- comment -%} ===== Tab 1: Doctor Approved ===== {%- endcomment -%}\n    <div id=\"mpv1-dtv2-panel-0-{{ dtv2_id }}\" class=\"mpv1-dtv2__panel mpv1-dtv2__panel--active\" role=\"tabpanel\" data-dtv2-panel=\"0\">\n      <p class=\"mpv1-dtv2__quote\">\"Most men don't have a bedroom problem - they have a hormone problem. This formula attacks it at the root, using full clinical doses of Tongkat Ali and Fenugreek to drive natural testosterone, and Taurine to fuel blood flow - restoring drive and performance naturally, without a prescription.\"</p>\n      <div class=\"mpv1-dtv2__author\">\n        <img src=\"//ultimapeak.com/cdn/shop/files/reviewr_image_beef_png_cb7820c0-bd79-42f2-8747-7a17d4ae6b17.webp?v=1780563794&amp;width=112\" alt=\"\" srcset=\"//ultimapeak.com/cdn/shop/files/reviewr_image_beef_png_cb7820c0-bd79-42f2-8747-7a17d4ae6b17.webp?v=1780563794&amp;width=56 56w\" width=\"56\" height=\"56\" loading=\"lazy\" class=\"mpv1-dtv2__avatar\">\n        <div class=\"mpv1-dtv2__author-info\">\n          <p class=\"mpv1-dtv2__author-name\">Dr. Marcus Thorne, M.D.</p>\n          <p class=\"mpv1-dtv2__author-specialty\">Board-Certified Physician &amp; Men's Health Specialist</p>\n        </div>\n      </div>\n    </div>\n\n    {%- comment -%} ===== Tab 2: Product Details ===== {%- endcomment -%}\n    <div id=\"mpv1-dtv2-panel-1-{{ dtv2_id }}\" class=\"mpv1-dtv2__panel\" role=\"tabpanel\" data-dtv2-panel=\"1\">\n      <p style=\"margin:0 0 12px;font-size:14px;line-height:1.6;\">UP MEN is a men's daily supplement with 9 active ingredients in each serving, formulated to support testosterone, energy, focus, muscle recovery and overall male vitality.</p>\n      <p style=\"margin:0 0 12px;font-size:14px;line-height:1.6;\">Suggested use: take 5 capsules daily with food, at the same time each day for consistent results.</p>\n      <p style=\"margin:0;font-size:14px;line-height:1.6;\">Made in the USA in a CGMP-certified facility and third-party tested for quality, purity and safety.</p>\n    </div>\n\n    {%- comment -%} ===== Tab 3: Comparison Table ===== {%- endcomment -%}\n    <div id=\"mpv1-dtv2-panel-2-{{ dtv2_id }}\" class=\"mpv1-dtv2__panel\" role=\"tabpanel\" data-dtv2-panel=\"2\">\n      <div class=\"mpv1-dtv2__comparison\">\n        <div class=\"mpv1-dtv2__comparison-header\">\n          <div class=\"mpv1-dtv2__comparison-col mpv1-dtv2__comparison-col--feature\"></div>\n          <div class=\"mpv1-dtv2__comparison-col mpv1-dtv2__comparison-col--brand\">\n            {%- comment -%}\n              To use your logo image instead of text, replace the span below with:\n              <img src=\"YOUR_UPMEN_LOGO_URL\" alt=\"UP MEN\" width=\"44\" height=\"29\" loading=\"lazy\" class=\"mpv1-dtv2__comparison-logo\">\n            {%- endcomment -%}\n            <span class=\"mpv1-dtv2__comparison-brand-text\">UP MEN</span>\n          </div>\n          <div class=\"mpv1-dtv2__comparison-col mpv1-dtv2__comparison-col--others\">\n            Others\n          </div>\n        </div>\n        <div class=\"mpv1-dtv2__comparison-body\">\n\n          <div class=\"mpv1-dtv2__comparison-row\">\n            <div class=\"mpv1-dtv2__comparison-col mpv1-dtv2__comparison-col--feature\">\n              <p class=\"mpv1-dtv2__comparison-feature-name\">Works Every Day, Not Just Date Night</p>\n              <p class=\"mpv1-dtv2__comparison-feature-sub\">Morning wood, random drive, all day</p>\n            </div>\n            <div class=\"mpv1-dtv2__comparison-col mp