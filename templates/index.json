        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "What is Up Men and how does it work?",
            "answer": "Up Men is a natural testosterone support supplement made with 8 clinically dosed ingredients — including Tongkat Ali, Shilajit, Fenugreek, Zinc and Boron — that work together to support your body's own testosterone production, energy, strength and focus."
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "How do I take Up Men?",
            "answer": "Take the daily serving with water, ideally in the morning with food. Consistency is key — take it every day for at least 90 days for full results."
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "When will I feel the results?",
            "answer": "Most men start noticing improved energy and workout intensity within the first 7 days. By day 30 you should see visible changes, and by day 90 your T-production is fully optimized. That's why we back it with a 90-day guarantee."
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "Is Up Men a hormone or a steroid?",
            "answer": "No. Up Men is 100% hormone-free. It doesn't put synthetic testosterone in your body — it supports your body's own natural ability to produce testosterone."
