    "faq": {
      "type": "faq",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "WHAT IS UP MEN?",
            "answer": "UP MEN is a men's dietary supplement with 9 active ingredients in each daily serving. It is designed to simplify the supplementation step inside a broader routine that can include nutrition, movement, training, sleep and consistent self-care."
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "WHAT DO I RECEIVE WITH THE 30-DAY PLAN?",
            "answer": "You receive 1 bottle with a 30-day supply, an UP MEN Branded Thermal Bottle, a Keychain Pill Case and the UP MEN Men's Wellness Guide (Digital). The physical gifts ship with your first order, and the digital guide is delivered by email."
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "WHAT DO I RECEIVE WITH THE 90-DAY PLAN?",
            "answer": "You receive 3 bottles delivered together for a complete 90-day supply, plus the Complete Welcome Kit: an UP MEN Branded Thermal Bottle, UP MEN Crossbody Pack, Keychain Pill Case, Smart Activity Band and the UP MEN Men's Wellness Guide (Digital — delivered by email)."
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "WHY IS THE 90-DAY PLAN THE BEST VALUE?",
            "answer": "The 90-day plan includes 3 bottles for $118, the same product cost as 2 monthly bottles at $59 each. Compared with three separate monthly shipments totaling $177, the 90-day subscriber rate saves $59 every 90 days. Welcome gifts are included once with the first shipment and are not repeated on renewals."
          }
        },
        "faq-5": {
          "type": "faq",
          "settings": {
            "question": "WHEN WILL MY WELCOME GIFTS ARRIVE?",
            "answer": "All physical welcome gifts ship with your first order. The digital guide is delivered by email after purchase. Welcome gifts are included once and are not repeated on subscription renewals."
          }
        },
        "faq-6": {
          "type": "faq",
          "settings": {
            "question": "HOW DOES THE 90-DAY SUBSCRIPTION RENEW?",
            "answer": "Your 90-day subscription is charged at the $118 subscriber rate shown at checkout, and it renews at that same rate every 90 days unless you skip, pause or cancel before renewal. Each renewal contains 3 bottles of UP MEN only — welcome gifts are included once with the first shipment."
          }
        },
        "faq-7": {
          "type": "faq",
          "settings": {
            "question": "CAN I SKIP, PAUSE OR CANCEL?",
            "answer": "To change or cancel a future renewal, contact UP MEN support before your next billing date. Changes must be requested before the next order is processed. Review the Subscription Policy for complete terms."
          }
        },
        "faq-8": {
          "type": "faq",
          "settings": {
            "question": "HOW DOES THE 90-DAY SATISFACTION GUARANTEE WORK?",
            "answer": "Your purchase is protected according to the terms of the published 90-day satisfaction guarantee. Review the Refund Policy for eligibility, deadlines, required steps and any conditions before ordering."
          }
        },
        "faq-9": {
          "type": "faq",
          "settings": {
            "question": "WHEN WILL MY ORDER SHIP?",
            "answer": "Shipping estimates and tracking information are shown during checkout and sent by email when available."
          }
        },
        "faq-10": {
          "type": "faq",
          "settings": {
            "question": "WHO SHOULD SPEAK WITH A HEALTHCARE PROFESSIONAL BEFORE USE?",
            "answer": "Consult a qualified healthcare professional before use if you take medication, particularly anticoagulants, have a medical condition, are preparing for surgery or use other supplements containing vitamin D, vitamin K, zinc or boron."
          }
        }
      },
