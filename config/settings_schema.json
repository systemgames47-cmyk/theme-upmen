[
  {
    "name": "theme_info",
    "theme_name": "Up Men",
    "theme_version": "1.0.0",
    "theme_author": "Up Men",
    "theme_documentation_url": "https://mengotomars.com",
    "theme_support_url": "mailto:support@mengotomars.com"
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "color_brand",
        "label": "Primary color (orange)",
        "default": "#ff5600"
      },
      {
        "type": "color",
        "id": "color_brand_dark",
        "label": "Dark background (near black)",
        "default": "#120804"
      },
      {
        "type": "color",
        "id": "color_brand_soft",
        "label": "Light cream background (utility pages)",
        "default": "#fff4ec"
      },
      {
        "type": "color",
        "id": "color_brand_green",
        "label": "Success green",
        "default": "#39c46e"
      },
      {
        "type": "color",
        "id": "color_brand_yellow",
        "label": "Highlight (secondary orange)",
        "default": "#ff8a00"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Text color (dark sections)",
        "default": "#ffffff"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "header",
        "content": "Fonts"
      },
      {
        "type": "paragraph",
        "content": "By default the theme uses Martian Mono (headings) and Inter (body) from Google Fonts. Enable the option below to pick different fonts from the Shopify font library."
      },
      {
        "type": "checkbox",
        "id": "use_custom_fonts",
        "label": "Use custom fonts",
        "default": false
      },
      {
        "type": "font_picker",
        "id": "font_heading",
        "label": "Heading font",
        "default": "roboto_mono_n4"
      },
      {
        "type": "font_picker",
        "id": "font_body",
        "label": "Body font",
        "default": "helvetica_n4"
      },
      {
        "type": "header",
        "content": "Sizes"
      },
      {
        "type": "range",
        "id": "heading_scale",
        "label": "Heading size scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      },
      {
        "type": "range",
        "id": "body_scale",
        "label": "Body text size scale",
        "min": 80,
        "max": 130,
        "step": 5,
        "unit": "%",
        "default": 100
      }
    ]
  },
  {
    "name": "Default Logo",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Store logo",
        "info": "Used as fallback in header and footer. Use PNG, SVG or WEBP. If empty, the UP MEN wordmark is used."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon",
        "info": "Icon shown in the browser tab. Upload a square image (32x32px recommended); it is automatically resized to 32x32. If empty, the store logo is used."
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "Logo height (px)",
        "min": 24,
        "max": 80,
        "step": 2,
        "default": 32
      }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_tiktok",
        "label": "TikTok URL"
      },
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email",
        "default": "support@mengotomars.com"
      }
    ]
  }
]
