{%- comment -%}
  Social icon SVG for the footer.
  Usage: {% render 'mm-social-icon', network: block.settings.network %}
{%- endcomment -%}
{%- case network -%}
  {%- when 'instagram' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
  {%- when 'facebook' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
  {%- when 'youtube' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M23 12s0-3.85-.5-5.7a3 3 0 0 0-2.1-2.1C18.6 3.7 12 3.7 12 3.7s-6.6 0-8.4.5A3 3 0 0 0 1.5 6.3C1 8.15 1 12 1 12s0 3.85.5 5.7a3 3 0 0 0 2.1 2.1c1.8.5 8.4.5 8.4.5s6.6 0 8.4-.5a3 3 0 0 0 2.1-2.1c.5-1.85.5-5.7.5-5.7zM9.75 15.5v-7l6 3.5-6 3.5z"/></svg>
  {%- when 'tiktok' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.6 6.3a4.8 4.8 0 0 1-3.5-1.6v7.6a5.6 5.6 0 1 1-5.6-5.6c.2 0 .4 0 .6.1v2.9a2.7 2.7 0 1 0 2 2.6V2h3a4.8 4.8 0 0 0 3.5 4.3z"/></svg>
  {%- when 'x' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.7 3h3.3l-7.2 8.2L22 21h-6.4l-5-6.5L4.8 21H1.5l7.7-8.8L2 3h6.6l4.5 6zm-1.2 16h1.8L7.6 4.8H5.7z"/></svg>
  {%- when 'linkedin' -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3zM9 9h3.8v1.7h.05A4.2 4.2 0 0 1 16.6 8.7c4 0 4.7 2.6 4.7 6V21h-4v-5.5c0-1.3 0-3-1.85-3s-2.15 1.4-2.15 2.9V21H9z"/></svg>
  {%- else -%}
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a15 15 0 0 1 0 18a15 15 0 0 1 0-18z"/></svg>
{%- endcase -%}
