<style>
  #pq-cart-drawer { position: fixed; inset: 0; z-index: 9999; pointer-events: none; }
  #pq-cart-drawer .pq-drawer-backdrop {
    position: absolute; inset: 0; background: rgba(0,0,0,0.65);
    opacity: 0; transition: opacity .3s ease;
  }
  #pq-cart-drawer .pq-drawer-panel {
    position: absolute; top: 0; right: 0; bottom: 0;
    width: 100%; max-width: 420px; background: #17100b; color: #fff;
    border-left: 1px solid rgba(255,255,255,0.12);
    box-shadow: -8px 0 32px rgba(0,0,0,0.6);
    transform: translateX(100%); transition: transform .35s cubic-bezier(.2,.7,.2,1);
    display: flex; flex-direction: column;
  }
  #pq-cart-drawer.is-open { pointer-events: auto; }
  #pq-cart-drawer.is-open .pq-drawer-backdrop { opacity: 1; }
  #pq-cart-drawer.is-open .pq-drawer-panel { transform: translateX(0); }

  #pq-cart-drawer .pq-drawer-head {
    display: flex; align-items: center; justify-content: space-between;
    padding: 18px 20px; border-bottom: 1px solid rgba(255,255,255,0.12);
    background: #0a0503;
  }
  #pq-cart-drawer .pq-drawer-head h2 {
    margin: 0; font-family: var(--font-heading); font-size: calc((16px) * var(--fs-h, 1)); font-weight: 800;
    color: #fff; text-transform: uppercase; letter-spacing: 0.08em;
  }
  #pq-cart-drawer .pq-drawer-close {
    background: transparent; border: 0; cursor: pointer;
    width: 32px; height: 32px; border-radius: 50%;
    color: #fff; font-size: calc((22px) * var(--fs-b, 1)); line-height: 1;
    display: inline-flex; align-items: center; justify-content: center;
    transition: background .15s;
  }
  #pq-cart-drawer .pq-drawer-close:hover { background: rgba(255,255,255,0.1); }

  #pq-cart-drawer .pq-drawer-body { flex: 1; overflow-y: auto; padding: 16px 20px; }
  #pq-cart-drawer .pq-drawer-empty {
    text-align: center; padding: 48px 16px;
    color: rgba(255,255,255,0.65); font-size: calc((15px) * var(--fs-b, 1));
  }
  #pq-cart-drawer .pq-drawer-loading {
    text-align: center; padding: 32px 16px;
    color: rgba(255,255,255,0.65); font-size: calc((14px) * var(--fs-b, 1));
  }
  #pq-cart-drawer .pq-drawer-items { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
  #pq-cart-drawer .pq-drawer-item {
    display: grid; grid-template-columns: 64px 1fr auto; gap: 12px;
    padding-bottom: 14px; border-bottom: 1px solid rgba(255,255,255,0.1);
  }
  #pq-cart-drawer .pq-drawer-item:last-child { border-bottom: 0; padding-bottom: 0; }
  #pq-cart-drawer .pq-drawer-item img {
    width: 64px; height: 64px; object-fit: cover; border-radius: 8px;
    background: #0a0503; border: 1px solid rgba(255,255,255,0.1);
  }
  #pq-cart-drawer .pq-drawer-item-info { min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  #pq-cart-drawer .pq-drawer-item-title {
    font-size: calc((14px) * var(--fs-h, 1)); font-weight: 700; color: #fff; line-height: 1.25;
  }
  #pq-cart-drawer .pq-drawer-item-variant { font-size: calc((12px) * var(--fs-b, 1)); color: rgba(255,255,255,0.55); }
  {%- comment -%} Theme setting: Cart → "Show the quantity stepper in the cart drawer".
    Hidden with CSS rather than skipped in the render, because the line markup is
    built client-side from /cart.js and this keeps one code path. Removing a line
    is unaffected. {%- endcomment -%}
  {%- unless settings.cart_show_quantity == false -%}
  #pq-cart-drawer .pq-drawer-item-qty {
    display: inline-flex; align-items: center; gap: 8px; margin-top: 6px;
    border: 1px solid rgba(255,255,255,0.25); border-radius: 6px; padding: 2px 4px;
    align-self: flex-start;
  }
  #pq-cart-drawer .pq-drawer-item-qty button {
    background: transparent; border: 0; cursor: pointer;
    width: 22px; height: 22px; color: #fff;
    font-size: calc((16px) * var(--fs-b, 1)); line-height: 1; border-radius: 4px;
  }
  #pq-cart-drawer .pq-drawer-item-qty button:hover { background: rgba(255,255,255,0.12); }
  #pq-cart-drawer .pq-drawer-item-qty button:disabled { opacity: 0.4; cursor: not-allowed; }
  #pq-cart-drawer .pq-drawer-item-qty .num { font-size: calc((13px) * var(--fs-b, 1)); font-weight: 700; min-width: 18px; text-align: center; color: #fff; }
  {%- else -%}
  #pq-cart-drawer .pq-drawer-item-qty { display: none; }
  {%- endunless -%}
  #pq-cart-drawer .pq-drawer-item-line {
    font-size: calc((14px) * var(--fs-b, 1)); font-weight: 800; color: var(--brand, #ff5600);
    text-align: right; white-space: nowrap;
  }
  #pq-cart-drawer .pq-drawer-item-remove {
    background: transparent; border: 0; cursor: pointer;
    color: rgba(255,255,255,0.5); font-size: calc((11px) * var(--fs-b, 1)); padding: 2px 0; margin-top: 4px;
    text-decoration: underline; align-self: flex-start;
  }
  #pq-cart-drawer .pq-drawer-item-remove:hover { color: var(--brand, #ff5600); }

  #pq-cart-drawer .pq-drawer-foot {
    border-top: 1px solid rgba(255,255,255,0.12); padding: 16px 20px 20px;
    display: flex; flex-direction: column; gap: 12px;
    background: #0a0503;
  }
  #pq-cart-drawer .pq-drawer-subtotal {
    display: flex; align-items: center; justify-content: space-between;
    font-size: calc((15px) * var(--fs-b, 1)); font-weight: 800; color: #fff;
  }
  #pq-cart-drawer .pq-drawer-subtotal .label { font-family: var(--font-heading); text-transform: uppercase; letter-spacing: 0.08em; font-size: calc((12px) * var(--fs-b, 1)); }
  #pq-cart-drawer .pq-drawer-checkout {
    display: flex; align-items: center; justify-content: center; gap: 8px;
    background: var(--brand, #ff5600); color: #fff;
    font-weight: 800; font-size: calc((15px) * var(--fs-b, 1)); text-transform: uppercase; letter-spacing: 0.06em;
    padding: 14px 20px; border-radius: 8px; text-decoration: none;
    box-shadow: 0 8px 24px rgba(255,86,0,0.35);
    transition: filter .15s, transform .1s;
  }
  #pq-cart-drawer .pq-drawer-checkout:hover { filter: brightness(1.1); }
  #pq-cart-drawer .pq-drawer-checkout:active { transform: translateY(2px); }
  #pq-cart-drawer .pq-drawer-viewcart {
    text-align: center; font-size: calc((13px) * var(--fs-b, 1)); color: rgba(255,255,255,0.7);
    text-decoration: underline;
  }
  #pq-cart-drawer .pq-drawer-viewcart:hover { color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    #pq-cart-drawer .pq-drawer-backdrop,
    #pq-cart-drawer .pq-drawer-panel { transition: none; }
  }
</style>

<div id="pq-cart-drawer" aria-hidden="true">
  <div class="pq-drawer-backdrop" data-pq-drawer-close></div>
  <aside class="pq-drawer-panel" role="dialog" aria-modal="true" aria-label="Your cart">
    <header class="pq-drawer-head">
      <h2>Your Cart</h2>
      <button type="button" class="pq-drawer-close" aria-label="Close cart" data-pq-drawer-close>×</button>
    </header>
    <div class="pq-drawer-body" data-pq-drawer-body>
      <div class="pq-drawer-empty">Your cart is empty.</div>
    </div>
    <footer class="pq-drawer-foot" data-pq-drawer-foot hidden>
      <div class="pq-drawer-subtotal">
        <span class="label">Subtotal</span>
        <span data-pq-drawer-subtotal>—</span>
      </div>
      <a href="/checkout" class="pq-drawer-checkout">Checkout &rarr;</a>
      <a href="{{ routes.cart_url }}" class="pq-drawer-viewcart">View full cart</a>
    </footer>
  </aside>
</div>

<script>
(function(){
  var drawer = document.getElementById('pq-cart-drawer');
  if (!drawer) return;
  var body = drawer.querySelector('[data-pq-drawer-body]');
  var foot = drawer.querySelector('[data-pq-drawer-foot]');
  var subEl = drawer.querySelector('[data-pq-drawer-subtotal]');
  var moneyFormat = {{ shop.money_format | json }};

  function fmt(cents){
    var n = (cents || 0) / 100;
    if (moneyFormat && /\{\{\s*amount/.test(moneyFormat)) {
      var formatted = n.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
      return moneyFormat.replace(/\{\{\s*amount[^}]*\}\}/g, formatted);
    }
    try {
      return new Intl.NumberFormat('en-US', {style:'currency', currency:'USD'}).format(n);
    } catch(e) { return '$' + n.toFixed(2); }
  }

  function open(){
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden','false');
    document.documentElement.style.overflow = 'hidden';
    document.body.style.overflow = 'hidden';
  }
  function close(){
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden','true');
    document.documentElement.style.overflow = '';
    document.body.style.overflow = '';
  }
  drawer.querySelectorAll('[data-pq-drawer-close]').forEach(function(el){
    el.addEventListener('click', close);
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
  });
  document.addEventListener('click', function(e){
    var trigger = e.target.closest('[data-mm-open-cart]');
    if (!trigger) return;
    e.preventDefault();
    refresh().then(open).catch(open);
  });

  function escapeHtml(s){
    return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){
      return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];
    });
  }

  function render(cart){
    if (!cart || !cart.item_count) {
      body.innerHTML = '<div class="pq-drawer-empty">Your cart is empty.</div>';
      foot.hidden = true;
      return;
    }
    var html = '<ul class="pq-drawer-items">';
    cart.items.forEach(function(it){
      var imgSrc = it.image ? it.image.replace(/(\.[a-zA-Z]{3,4})(\?.*)?$/, '_120x120$1$2') : '';
      html += '<li class="pq-drawer-item" data-key="' + escapeHtml(it.key) + '">'
        + (imgSrc ? '<img src="' + escapeHtml(imgSrc) + '" alt="" loading="lazy">' : '<div></div>')
        + '<div class="pq-drawer-item-info">'
          + '<div class="pq-drawer-item-title">' + escapeHtml(it.product_title) + '</div>'
          + (it.variant_title && it.variant_title !== 'Default Title' ? '<div class="pq-drawer-item-variant">' + escapeHtml(it.variant_title) + '</div>' : '')
          + '<div class="pq-drawer-item-qty">'
            + '<button type="button" data-pq-qty-dec aria-label="Decrease">−</button>'
            + '<span class="num">' + it.quantity + '</span>'
            + '<button type="button" data-pq-qty-inc aria-label="Increase">+</button>'
          + '</div>'
          + '<button type="button" class="pq-drawer-item-remove" data-pq-remove>Remove</button>'
        + '</div>'
        + '<div class="pq-drawer-item-line">' + fmt(it.final_line_price) + '</div>'
        + '</li>';
    });
    html += '</ul>';
    body.innerHTML = html;
    subEl.textContent = fmt(cart.total_price);
    foot.hidden = false;
  }

  function updateBadges(cart){
    document.querySelectorAll('.mm-cart .mm-count').forEach(function(el){
      el.textContent = (cart && cart.item_count) || 0;
    });
  }

  function refresh(){
    return fetch('/cart.js', { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
      .then(function(r){ return r.json(); })
      .then(function(cart){ render(cart); updateBadges(cart); return cart; });
  }

  function changeQty(key, qty){
    return fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      credentials: 'same-origin',
      body: JSON.stringify({ id: key, quantity: qty })
    }).then(function(r){ return r.json(); }).then(function(cart){ render(cart); updateBadges(cart); });
  }

  body.addEventListener('click', function(e){
    var li = e.target.closest('.pq-drawer-item');
    if (!li) return;
    var key = li.getAttribute('data-key');
    var num = parseInt(li.querySelector('.num').textContent, 10) || 1;
    if (e.target.matches('[data-pq-qty-inc]')) changeQty(key, num + 1);
    else if (e.target.matches('[data-pq-qty-dec]')) changeQty(key, Math.max(0, num - 1));
    else if (e.target.matches('[data-pq-remove]')) changeQty(key, 0);
  });

  // Intercept all add-to-cart forms (those pointing to /cart/add)
  document.addEventListener('submit', function(e){
    var f = e.target;
    if (!f || f.tagName !== 'FORM') return;
    var action = f.getAttribute('action') || '';
    if (!/\/cart\/add/.test(action)) return;
    // An app block ships its own cart UX — Kaching Bundles opens its own drawer,
    // for one — so handling its form here stacks two drawers on a single click.
    // Shopify wraps every app block in #shopify-block-*, which is what this looks for.
    if (f.closest && f.closest('[id^="shopify-block-"]')) return;
    // Explicit opt-out, for a theme section that has handed the cart to an app.
    if (f.hasAttribute('data-no-theme-drawer')) return;
    var returnTo = f.querySelector('input[name="return_to"]');
    if (returnTo && /checkout/.test(returnTo.value)) return; // straight to checkout, no drawer
    e.preventDefault();
    var fd = new FormData(f);
    fd.delete('return_to');
    var btn = f.querySelector('[type="submit"]');
    var origText;
    if (btn) { btn.disabled = true; origText = btn.innerHTML; btn.innerHTML = 'Adding…'; }
    fetch('/cart/add.js', {
      method: 'POST', body: fd, credentials: 'same-origin',
      headers: { 'Accept': 'application/json' }
    })
      .then(function(r){
        if (!r.ok) return r.json().then(function(j){ throw new Error(j.description || 'Error adding'); });
        return r.json();
      })
      .then(function(){ return refresh(); })
      .then(open)
      .catch(function(err){
        console.error('Cart add failed:', err);
        alert('Could not add to cart. ' + (err.message || ''));
      })
      .then(function(){ if (btn) { btn.disabled = false; btn.innerHTML = origText; } });
  });

  // Initial cart load (so drawer is correct if user opens manually later)
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', refresh);
  } else {
    refresh();
  }
})();
</script>
