{%- comment -%}
  PDP Comparison — "UP MEN vs the alternative" table.

  Rows are blocks. Each row states a claim and marks whether each column meets
  it, so the merchant controls both the wording and the ticks without touching
  the markup.

  On mobile the table keeps its three columns rather than collapsing into cards:
  the whole point of the block is the side-by-side read, and the column widths
  are set so two narrow tick columns still fit on a 320px screen.

  Anchor: #comparison — the tab strip in "PDP Tabs" links here.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}

<style>
  #mm-pdp-cmp-{{ sid }} {
    background: var(--mars-black, #0a0503); color: var(--text, #fff);
    padding: 48px 0;
  }
  @media (min-width: 768px) { #mm-pdp-cmp-{{ sid }} { padding: 80px 0; } }
  #mm-pdp-cmp-{{ sid }} .mm-wrap { max-width: 880px; margin: 0 auto; padding: 0 16px; }
  #mm-pdp-cmp-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(22px, 4.4vw, 36px)) * var(--fs-h, 1)); margin: 0 0 10px; line-height: 1.2;
  }
  #mm-pdp-cmp-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-pdp-cmp-{{ sid }} .mm-sub {
    text-align: center; font-family: var(--font-body); font-weight: 300;
    font-size: calc((14px) * var(--fs-b, 1)); line-height: 1.6;
    color: rgba(255,255,255,0.7); margin: 0 auto 28px; max-width: 620px;
  }

  #mm-pdp-cmp-{{ sid }} .mm-table {
    width: 100%; border-collapse: separate; border-spacing: 0;
    background: rgba(26,14,7,0.72); border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
    border-radius: 16px; overflow: hidden;
  }
  #mm-pdp-cmp-{{ sid }} th, #mm-pdp-cmp-{{ sid }} td {
    padding: 13px 10px; text-align: center; vertical-align: middle;
    border-bottom: 1px solid var(--mars-line, rgba(255,255,255,0.12));
  }
  @media (min-width: 768px) { #mm-pdp-cmp-{{ sid }} th, #mm-pdp-cmp-{{ sid }} td { padding: 18px 16px; } }
  #mm-pdp-cmp-{{ sid }} tr:last-child td { border-bottom: 0; }
  #mm-pdp-cmp-{{ sid }} th.mm-claim, #mm-pdp-cmp-{{ sid }} td.mm-claim {
    text-align: left; width: auto;
    font-family: var(--font-body); font-weight: 400; line-height: 1.45;
    font-size: calc((13px) * var(--fs-b, 1)); color: rgba(255,255,255,0.85);
  }
  @media (min-width: 768px) {
    #mm-pdp-cmp-{{ sid }} th.mm-claim, #mm-pdp-cmp-{{ sid }} td.mm-claim { font-size: calc((14.5px) * var(--fs-b, 1)); }
  }
  #mm-pdp-cmp-{{ sid }} th.mm-col { width: 74px; }
  @media (min-width: 768px) { #mm-pdp-cmp-{{ sid }} th.mm-col { width: 150px; } }
  #mm-pdp-cmp-{{ sid }} thead th {
    background: rgba(255,86,0,0.10);
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((10.5px) * var(--fs-b, 1)); letter-spacing: .04em; line-height: 1.3;
  }
  @media (min-width: 768px) { #mm-pdp-cmp-{{ sid }} thead th { font-size: calc((13px) * var(--fs-b, 1)); } }
  #mm-pdp-cmp-{{ sid }} thead th.mm-ours { color: var(--brand, #ff5600); }
  #mm-pdp-cmp-{{ sid }} thead th.mm-theirs { color: rgba(255,255,255,0.55); background: transparent; }
  #mm-pdp-cmp-{{ sid }} thead th.mm-claim { background: transparent; }
  #mm-pdp-cmp-{{ sid }} .mm-logo { display: block; max-width: 110px; height: auto; margin: 0 auto 4px; }
  #mm-pdp-cmp-{{ sid }} td.mm-ours { background: rgba(255,86,0,0.07); }
  #mm-pdp-cmp-{{ sid }} .mm-mark { font-size: 19px; line-height: 1; display: inline-block; }
  @media (min-width: 768px) { #mm-pdp-cmp-{{ sid }} .mm-mark { font-size: 22px; } }
  #mm-pdp-cmp-{{ sid }} .mm-mark.yes { color: var(--brand-green, #39c46e); }
  #mm-pdp-cmp-{{ sid }} .mm-mark.no { color: rgba(255,255,255,0.30); }
  #mm-pdp-cmp-{{ sid }} .mm-note {
    text-align: center; font-size: calc((11.5px) * var(--fs-b, 1)); line-height: 1.6;
    color: rgba(255,255,255,0.5); margin: 16px auto 0; max-width: 620px;
  }
  #mm-pdp-cmp-{{ sid }} .mm-cta-row { text-align: center; margin-top: 26px; }
  #mm-pdp-cmp-{{ sid }} .mm-cta {
    display: inline-block; text-decoration: none;
    background: var(--brand, #ff5600); color: #fff;
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((13px) * var(--fs-b, 1)); letter-spacing: .05em;
    padding: 16px 34px; border-radius: 999px;
    box-shadow: 0 6px 0 rgba(0,0,0,0.35); transition: background .16s ease, transform .12s ease;
  }
  #mm-pdp-cmp-{{ sid }} .mm-cta:hover { background: #ff6a1f; }
  #mm-pdp-cmp-{{ sid }} .mm-cta:active { transform: translateY(4px); box-shadow: 0 2px 0 rgba(0,0,0,0.35); }
  #mm-pdp-cmp-{{ sid }} .mm-warn {
    margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; line-height: 1.5;
    background: rgba(255,138,0,0.12); border: 1px solid rgba(255,138,0,0.45);
    font-size: calc((12px) * var(--fs-b, 1)); color: #ffd9b0;
  }
</style>

<section id="mm-pdp-cmp-{{ sid }}" class="reveal" data-testid="pdp-comparison">
  <a id="comparison" aria-hidden="true"></a>
  <div class="mm-wrap">
    {%- if s.title != blank or s.title_highlight != blank -%}
      <h2>{{ s.title }} {%- if s.title_highlight != blank %} <span class="orange">{{ s.title_highlight }}</span>{% endif -%}</h2>
    {%- endif -%}
    {%- if s.subtitle != blank -%}<p class="mm-sub">{{ s.subtitle }}</p>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <table class="mm-table">
        <caption class="sr-only">{{ s.table_caption | default: 'Comparison table' }}</caption>
        <thead>
          <tr>
            <th class="mm-claim" scope="col"><span class="sr-only">{{ s.claim_col_label | default: 'Feature' }}</span></th>
            <th class="mm-col mm-ours" scope="col">
              {%- if s.ours_logo != blank -%}
                <img class="mm-logo" src="{{ s.ours_logo | image_url: width: 260 }}"
                  width="{{ s.ours_logo.width }}" height="{{ s.ours_logo.height }}"
                  alt="{{ s.ours_label | escape }}" loading="lazy">
              {%- else -%}
                {{ s.ours_label }}
              {%- endif -%}
            </th>
            <th class="mm-col mm-theirs" scope="col">{{ s.theirs_label }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for block in section.blocks -%}
            <tr {{ block.shopify_attributes }}>
              <th class="mm-claim" scope="row">{{ block.settings.claim }}</th>
              <td class="mm-ours">
                {%- if block.settings.ours -%}
                  <span class="mm-mark yes" aria-hidden="true">✓</span><span class="sr-only">Yes</span>
                {%- else -%}
                  <span class="mm-mark no" aria-hidden="true">✕</span><span class="sr-only">No</span>
                {%- endif -%}
              </td>
              <td>
                {%- if block.settings.theirs -%}
                  <span class="mm-mark yes" aria-hidden="true">✓</span><span class="sr-only">Yes</span>
                {%- else -%}
                  <span class="mm-mark no" aria-hidden="true">✕</span><span class="sr-only">No</span>
                {%- endif -%}
              </td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    {%- elsif request.design_mode -%}
      <div class="mm-warn">⚙️ Add “Row” blocks to build the comparison table.</div>
    {%- endif -%}

    {%- if s.note != blank -%}<p class="mm-note">{{ s.note }}</p>{%- endif -%}

    {%- if s.cta_label != blank -%}
      <div class="mm-cta-row">
        <a class="mm-cta" href="{{ s.cta_link | default: '#buy' }}">{{ s.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PDP Comparison",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "UP MEN VS" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)", "default": "THE USUAL STACK" },
    { "type": "textarea", "id": "subtitle", "label": "Subtitle", "default": "What you get with one daily UP MEN serving, next to buying separate products month by month." },
    { "type": "header", "content": "Columns" },
    { "type": "text", "id": "ours_label", "label": "Our column label", "default": "UP MEN" },
    { "type": "image_picker", "id": "ours_logo", "label": "Our column logo", "info": "Replaces the label text when set." },
    { "type": "text", "id": "theirs_label", "label": "Other column label", "default": "OTHERS" },
    { "type": "text", "id": "claim_col_label", "label": "Screen-reader label for the first column", "default": "Feature" },
    { "type": "text", "id": "table_caption", "label": "Screen-reader table caption", "default": "UP MEN compared with buying supplements separately" },
    { "type": "header", "content": "Footer" },
    { "type": "textarea", "id": "note", "label": "Note under the table" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "CHOOSE MY ROUTINE" },
    { "type": "url", "id": "cta_link", "label": "Button link", "info": "Defaults to the buy box on this page (#buy)." }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "text", "id": "claim", "label": "Claim" },
        { "type": "checkbox", "id": "ours", "label": "Our column: yes", "default": true },
        { "type": "checkbox", "id": "theirs", "label": "Other column: yes", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Comparison",
      "blocks": [
        { "type": "row", "settings": { "claim": "9 active ingredients in a single daily serving", "ours": true, "theirs": false } },
        { "type": "row", "settings": { "claim": "Exact amounts shown on the Supplement Facts panel", "ours": true, "theirs": false } },
        { "type": "row", "settings": { "claim": "3 bottles for the price of 2 on the 90-day plan", "ours": true, "theirs": false } },
        { "type": "row", "settings": { "claim": "Welcome kit included with your first shipment", "ours": true, "theirs": false } },
        { "type": "row", "settings": { "claim": "Made in a CGMP-certified facility in the USA", "ours": true, "theirs": false } },
        { "type": "row", "settings": { "claim": "Skip, pause or cancel before renewal", "ours": true, "theirs": false } },
        { "type": "row", "settings": { "claim": "90-day satisfaction guarantee", "ours": true, "theirs": false } }
      ]
    }
  ]
}
{% endschema %}
