<section class="list-collections">
  <div class="container">
    <h1>{{ section.settings.title }}</h1>
    <div class="grid">
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          <article class="card">
            {% if collection.image %}
              <a href="{{ collection.url }}"><img src="{{ collection.image | image_url: width: 400 }}" alt="{{ collection.title | escape }}" loading="lazy"></a>
            {% endif %}
            <h3><a href="{{ collection.url }}">{{ collection.title }}</a></h3>
            <p>{{ collection.products_count }} {{ section.settings.products_label }}</p>
          </article>
        {% endunless %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Collections" },
    { "type": "text", "id": "products_label", "label": "Products label", "default": "products" }
  ],
  "presets": [{ "name": "Collections list" }]
}
{% endschema %}
