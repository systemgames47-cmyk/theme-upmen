{%- comment -%} Ingredients — 9 active ingredients in 1 daily formula (K1 and K2 share one card) {%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.bg_mobile != blank -%}
  {%- assign ing_bg_mobile = section.settings.bg_mobile | image_url: width: 1200 -%}
{%- else -%}
  {%- assign ing_bg_mobile = 'rdm-Ingredients-section-bg-mob.webp' | asset_url -%}
{%- endif -%}
{%- if section.settings.bg_desktop != blank -%}
  {%- assign ing_bg_desktop = section.settings.bg_desktop | image_url: width: 2400 -%}
{%- else -%}
  {%- assign ing_bg_desktop = 'rdm-Ingredients-section-bg-desk.webp' | asset_url -%}
{%- endif -%}
{%- case section.settings.height_mobile -%}
  {%- when 'small' -%}{%- assign minh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign minh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign minh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign minh_mobile = '100svh' -%}
  {%- else -%}{%- assign minh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.height_desktop -%}
  {%- when 'small' -%}{%- assign minh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign minh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign minh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign minh_desktop = '100vh' -%}
  {%- else -%}{%- assign minh_desktop = 'auto' -%}
{%- endcase -%}
<style>
  #mm-ing-{{ sid }} {
    background: #0a0503 url('{{ ing_bg_mobile }}') center top / cover no-repeat;
    padding: 64px 0; color: #fff;
    min-height: {{ minh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
  @media (min-width: 768px) {
    #mm-ing-{{ sid }} { background-image: url('{{ ing_bg_desktop }}'); padding: 96px 0; min-height: {{ minh_desktop }}; }
  }
  #mm-ing-{{ sid }} .mm-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  #mm-ing-{{ sid }} .mm-head { text-align: center; margin-bottom: 40px; }
  #mm-ing-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((clamp(26px, 4.6vw, 46px)) * var(--fs-h, 1)); line-height: 1.15; margin: 0 0 12px; letter-spacing: 0.02em;
  }
  #mm-ing-{{ sid }} .mm-sub {
    font-family: var(--font-heading); font-size: calc((13px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.18em;
    text-transform: uppercase; color: var(--brand, #ff5600); margin: 0;
  }
  #mm-ing-{{ sid }} .mm-grid { display: grid; grid-template-columns: 1fr; gap: 14px; }
  @media (min-width: 640px) { #mm-ing-{{ sid }} .mm-grid { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 990px) { #mm-ing-{{ sid }} .mm-grid { grid-template-columns: repeat(4, 1fr); } }
  #mm-ing-{{ sid }} .mm-card {
    background: rgba(26,14,7,0.85); border: 1px solid rgba(255,255,255,0.12); border-radius: 14px;
    padding: 20px; backdrop-filter: blur(4px);
  }
  #mm-ing-{{ sid }} .mm-card-top { display: flex; align-items: center; gap: 12px; margin-bottom: 10px; }
  #mm-ing-{{ sid }} .mm-card img { width: 56px; height: 56px; object-fit: cover; border-radius: 50%; border: 1px solid rgba(255,255,255,0.2); flex-shrink: 0; }
  #mm-ing-{{ sid }} .mm-dose {
    font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.1em;
    color: var(--brand, #ff5600); text-transform: uppercase; display: block; margin-bottom: 2px;
    /* The K1 + K2 card carries two amounts, so let it wrap to a second line cleanly. */
    line-height: 1.25;
  }
  #mm-ing-{{ sid }} .mm-name { font-family: var(--font-body); font-weight: 800; font-size: calc((18px) * var(--fs-h, 1)); margin: 0; }
  #mm-ing-{{ sid }} .mm-desc { font-size: calc((13.5px) * var(--fs-b, 1)); line-height: 1.5; color: rgba(255,255,255,0.8); margin: 0; }
  #mm-ing-{{ sid }} .mm-cta-row { text-align: center; margin-top: 36px; }
  #mm-ing-{{ sid }} .mm-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--brand, #ff5600); color: #fff; text-decoration: none;
    font-weight: 800; font-size: calc((16px) * var(--fs-b, 1)); text-transform: uppercase;
    padding: 16px 40px; border-radius: 6px; box-shadow: 0 8px 28px rgba(255,86,0,0.4);
  }
  #mm-ing-{{ sid }} .mm-cta:hover { filter: brightness(1.1); }
</style>

<section id="mm-ing-{{ sid }}" class="reveal" data-testid="ingredients">
  <a id="ingredients" aria-hidden="true"></a>
  <div class="mm-wrap">
    <div class="mm-head">
      <h2>{{ section.settings.title }}</h2>
      <p class="mm-sub">{{ section.settings.subtitle }}</p>
    </div>
    <div class="mm-grid">
      {%- for block in section.blocks -%}
        <div class="mm-card" {{ block.shopify_attributes }}>
          <div class="mm-card-top">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.name }}" loading="lazy">
            {%- elsif block.settings.image_asset != blank -%}
              <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name }}" loading="lazy">
            {%- endif -%}
            <div>
              <span class="mm-dose">{{ block.settings.dose }}</span>
              <h3 class="mm-name">{{ block.settings.name }}</h3>
            </div>
          </div>
          <p class="mm-desc">{{ block.settings.description }}</p>
        </div>
      {%- endfor -%}
    </div>
    <div class="mm-cta-row">
      <a href="{{ section.settings.cta_link | default: '#join_pkg' }}" class="mm-cta">{{ section.settings.cta_label }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ingredients",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "9 ACTIVE INGREDIENTS IN 1 DAILY FORMULA" },
    { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "EXACT AMOUNTS SHOWN ON THE SUPPLEMENT FACTS" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "TRY IT NOW" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Banner size" },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (55% of screen)" },
        { "value": "medium", "label": "Medium (70% of screen)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (520px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "bg_mobile", "label": "Background (mobile)" },
    { "type": "image_picker", "id": "bg_desktop", "label": "Background (desktop)" }
  ],
  "blocks": [
    {
      "type": "ingredient",
      "name": "Ingredient",
      "settings": [
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "dose", "label": "Dose" },
        { "type": "textarea", "id": "description", "label": "Description" },
        { "type": "image_picker", "id": "image", "label": "Ingredient image" },
        { "type": "text", "id": "image_asset", "label": "Asset filename (fallback)", "info": "Image file in the theme assets folder, e.g. ing-1.png. Used only when no image is uploaded above." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ingredients",
      "blocks": [
        { "type": "ingredient", "settings": { "name": "Tongkat Ali", "dose": "1,000 mg", "description": "Boosts testosterone, enhances libido, improves fertility & supports muscle growth", "image_asset": "ing-1.png" } },
        { "type": "ingredient", "settings": { "name": "Shilajit", "dose": "400 mg", "description": "Improves fertility and boosts testosterone levels", "image_asset": "ing-2.png" } },
        { "type": "ingredient", "settings": { "name": "Vitamin K1 + K2", "dose": "100 mcg K1 + 100 mcg K2", "description": "Supports bone health and density, improves mood, and encourages T production", "image_asset": "ing-3.png" } },
        { "type": "ingredient", "settings": { "name": "Vitamin D", "dose": "100 mcg (4,000 IU)", "description": "Essential for maintaining cellular health and helping regulate testosterone", "image_asset": "ing-4.png" } },
        { "type": "ingredient", "settings": { "name": "Zinc", "dose": "30 mg", "description": "An essential trace mineral that plays a role in testosterone metabolism and immune function", "image_asset": "ing-5.png" } },
        { "type": "ingredient", "settings": { "name": "Taurine", "dose": "675 mg", "description": "Reduces oxidative stress, improves blood flow, and supports increased testosterone levels", "image_asset": "ing-6.png" } },
        { "type": "ingredient", "settings": { "name": "Fenugreek", "dose": "1,000 mg", "description": "Supports testosterone production, DHT levels, and male vitality", "image_asset": "ing-7.png" } },
        { "type": "ingredient", "settings": { "name": "Boron", "dose": "4 mg", "description": "Trace mineral with the potential to increase free T and regulate estrogen levels", "image_asset": "ing-8.png" } }
      ]
    }
  ]
}
{% endschema %}
