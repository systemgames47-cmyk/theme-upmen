{%- comment -%} Facility — video/image placeholder + quality badges {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-fac-{{ sid }} { background: var(--mars-black, #0a0503); color: var(--text, #fff); padding: 64px 0; }
  @media (min-width: 768px) { #mm-fac-{{ sid }} { padding: 96px 0; } }
  #mm-fac-{{ sid }} .mm-wrap { max-width: 900px; margin: 0 auto; padding: 0 16px; }
  #mm-fac-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(24px, 4.2vw, 38px)) * var(--fs-h, 1)); margin: 0 0 36px;
  }
  #mm-fac-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-fac-{{ sid }} .mm-media {
    border-radius: 16px; overflow: hidden; border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
    background: var(--mars-panel, #1a0e07); box-shadow: 0 20px 60px rgba(0,0,0,0.5);
  }
  #mm-fac-{{ sid }} .mm-media video, #mm-fac-{{ sid }} .mm-media img { width: 100%; display: block; }
  #mm-fac-{{ sid }} .mm-video-box { position: relative; cursor: pointer; }
  #mm-fac-{{ sid }} .mm-play {
    position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    background: rgba(10,5,3,0.35); border: 0; cursor: pointer; padding: 0; transition: opacity .2s ease;
  }
  #mm-fac-{{ sid }} .mm-play .mm-play-circle {
    width: 84px; height: 84px; border-radius: 50%; background: var(--brand, #ff5600);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 10px 36px rgba(255,86,0,0.55); transition: transform .15s ease;
  }
  #mm-fac-{{ sid }} .mm-play:hover .mm-play-circle { transform: scale(1.08); }
  #mm-fac-{{ sid }} .mm-play svg { margin-left: 5px; color: #fff; }
  #mm-fac-{{ sid }} .mm-video-box.is-playing .mm-play { opacity: 0; pointer-events: none; }
  #mm-fac-{{ sid }} .mm-ph {
    aspect-ratio: 16/9; display: flex; flex-direction: column; gap: 10px;
    align-items: center; justify-content: center; text-align: center; padding: 24px;
    border: 2px dashed rgba(255,86,0,0.5); border-radius: 16px; background: rgba(255,86,0,0.05);
    font-family: var(--font-heading); font-size: calc((12px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; color: rgba(255,255,255,0.55); line-height: 1.7;
  }
  #mm-fac-{{ sid }} .mm-ph svg { opacity: 0.6; }
  #mm-fac-{{ sid }} .mm-badges {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; margin-top: 28px;
    list-style: none; padding: 0;
  }
  #mm-fac-{{ sid }} .mm-badges li {
    display: inline-flex; align-items: center; gap: 8px;
    font-family: var(--font-heading); font-size: calc((12px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
  }
  #mm-fac-{{ sid }} .mm-badges svg { width: 18px; height: 18px; color: var(--brand-green, #39c46e); flex-shrink: 0; }
</style>

<section id="mm-fac-{{ sid }}" class="reveal" data-testid="facility">
  <div class="mm-wrap">
    <h2>{{ section.settings.title_pre }} <span class="orange">{{ section.settings.title_highlight }}</span></h2>

    <div>
      {%- if section.settings.video != blank -%}
        <div class="mm-media">
          <div class="mm-video-box" data-mm-video-box>
            <video muted loop playsinline preload="metadata"{% if section.settings.autoplay_preview %} autoplay{% endif %}>
              {%- for source in section.settings.video.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            </video>
            <button type="button" class="mm-play" aria-label="Play video with sound">
              <span class="mm-play-circle">
                <svg width="34" height="34" viewBox="0 0 24 24" fill="currentColor"><polygon points="6 4 20 12 6 20"/></svg>
              </span>
            </button>
          </div>
        </div>
      {%- elsif section.settings.image != blank -%}
        <div class="mm-media">
          <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.title_pre }} {{ section.settings.title_highlight }}" loading="lazy">
        </div>
      {%- else -%}
        <div class="mm-media">
          <img src="{{ 'upmen-preview-facility.jpg' | asset_url }}" alt="{{ section.settings.title_pre }} {{ section.settings.title_highlight }}" loading="lazy">
        </div>
      {%- endif -%}
    </div>

    <ul class="mm-badges">
      {%- for block in section.blocks -%}
        <li {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>
          <span>{{ block.settings.text }}</span>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

<script>
  (function () {
    if (window.__mmFacilityVideo) return;
    window.__mmFacilityVideo = true;
    document.addEventListener('click', function (e) {
      var box = e.target.closest ? e.target.closest('[data-mm-video-box]') : null;
      if (!box) return;
      var video = box.querySelector('video');
      if (!video) return;
      if (box.classList.contains('is-playing')) {
        video.pause();
        box.classList.remove('is-playing');
      } else {
        video.muted = false;
        video.volume = 1;
        var p = video.play();
        if (p && p.catch) p.catch(function () {});
        box.classList.add('is-playing');
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Facility",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "title_pre", "label": "Title", "default": "MADE IN A CGMP" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)", "default": "FACILITY IN THE USA" },
    { "type": "video", "id": "video", "label": "Facility video" },
    { "type": "checkbox", "id": "autoplay_preview", "label": "Autoplay muted preview", "default": true },
    { "type": "image_picker", "id": "image", "label": "Facility banner (used if no video)" }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Facility",
      "blocks": [
        { "type": "badge", "settings": { "text": "CGMP Certified" } },
        { "type": "badge", "settings": { "text": "Third-Party Tested" } },
        { "type": "badge", "settings": { "text": "Made in the USA" } }
      ]
    }
  ]
}
{% endschema %}
