{%- comment -%} Badges marquee — quality claims scrolling strip {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-marq-{{ sid }} { background: var(--brand, #ff5600); color: #fff; overflow: hidden; padding: 14px 0; }
  #mm-marq-{{ sid }} .mm-track {
    display: flex; gap: 40px; width: max-content;
    animation: mm-marq-{{ sid }}-scroll 28s linear infinite;
  }
  #mm-marq-{{ sid }}:hover .mm-track { animation-play-state: paused; }
  #mm-marq-{{ sid }} .mm-item {
    display: inline-flex; align-items: center; gap: 10px; white-space: nowrap;
    font-family: var(--font-heading); font-size: calc((13px) * var(--fs-b, 1)); font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
  }
  #mm-marq-{{ sid }} .mm-item::before { content: '✦'; font-size: calc((12px) * var(--fs-b, 1)); }
  @keyframes mm-marq-{{ sid }}-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<section id="mm-marq-{{ sid }}" aria-hidden="true">
  <div class="mm-track">
    {%- for i in (1..2) -%}
      {%- for block in section.blocks -%}
        <span class="mm-item">{{ block.settings.text }}</span>
      {%- endfor -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Badges Marquee",
  "settings": [],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [{ "type": "text", "id": "text", "label": "Text" }]
    }
  ],
  "presets": [
    {
      "name": "Badges Marquee",
      "blocks": [
        { "type": "item", "settings": { "text": "Made In A CGMP Facility" } },
        { "type": "item", "settings": { "text": "Non-GMO" } },
        { "type": "item", "settings": { "text": "Vegan" } },
        { "type": "item", "settings": { "text": "Hormone-Free" } },
        { "type": "item", "settings": { "text": "Made in USA" } },
        { "type": "item", "settings": { "text": "Third Party Tested" } }
      ]
    }
  ]
}
{% endschema %}
