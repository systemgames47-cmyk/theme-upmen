{%- comment -%}
  PDP Hero — gallery + buy box.

  Two columns on desktop (gallery sticky on the left, buy column on the right),
  stacked on mobile. The buy column carries the rating, the short description,
  the benefit icons, the supplement-facts image, the plan selector and the CTA,
  which is the same order the column has on mobile.

  Plans are blocks, so a merchant can run one, two or four of them without a
  code change. Each plan block resolves its own product: the block's product
  picker first, then the handles below, then the product this template is
  rendering. The submitted variant id and selling plan are swapped by the radio
  group into the single form, so only one CTA ever exists on the page.

  Add-to-cart is a plain POST to routes.cart_add_url. snippets/cart-drawer.liquid
  intercepts every form pointing at /cart/add and turns it into an AJAX add that
  opens the drawer, so no fetch() is needed here.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}

{%- assign plan_blocks = section.blocks | where: 'type', 'plan' -%}
{%- assign benefit_blocks = section.blocks | where: 'type', 'benefit' -%}
{%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}

{%- comment -%} Resolve which plan starts selected: the first block flagged as
  default, otherwise the first plan block. Tracked by position rather than by
  block.id — those ids are generated by Shopify and must not be relied on. {%- endcomment -%}
{%- assign default_plan_index = -1 -%}
{%- for block in plan_blocks -%}
  {%- if block.settings.is_default and default_plan_index == -1 -%}
    {%- assign default_plan_index = forloop.index0 -%}
  {%- endif -%}
{%- endfor -%}
{%- if default_plan_index == -1 -%}
  {%- assign default_plan_index = 0 -%}
{%- endif -%}

{%- comment -%} Gallery source: the section's own images when the merchant
  uploaded them, otherwise the images of the product the page is rendering. {%- endcomment -%}
{%- assign gallery_product = s.gallery_product -%}
{%- if gallery_product == blank or gallery_product.id == blank -%}
  {%- assign gallery_product = product -%}
{%- endif -%}

<style>
  #mm-pdp-hero-{{ sid }} {
    background: var(--mars-black, #0a0503);
    color: var(--text, #fff);
    padding: 24px 0 48px;
  }
  @media (min-width: 900px) { #mm-pdp-hero-{{ sid }} { padding: 40px 0 72px; } }
  #mm-pdp-hero-{{ sid }} .mm-wrap { max-width: 1180px; margin: 0 auto; padding: 0 16px; }
  #mm-pdp-hero-{{ sid }} .mm-cols { display: grid; grid-template-columns: 1fr; gap: 28px; }
  @media (min-width: 900px) {
    #mm-pdp-hero-{{ sid }} .mm-cols { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 48px; align-items: start; }
    #mm-pdp-hero-{{ sid }} .mm-media { position: sticky; top: 24px; }
  }

  /* ---------- gallery ---------- */
  #mm-pdp-hero-{{ sid }} .mm-gal { position: relative; }
  #mm-pdp-hero-{{ sid }} .mm-gal-track {
    display: flex; overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: none; -ms-overflow-style: none; border-radius: 16px;
    background: var(--mars-panel, #1a0e07); border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
  }
  #mm-pdp-hero-{{ sid }} .mm-gal-track::-webkit-scrollbar { display: none; }
  #mm-pdp-hero-{{ sid }} .mm-gal-slide { flex: 0 0 100%; scroll-snap-align: start; }
  #mm-pdp-hero-{{ sid }} .mm-gal-slide img { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; }
  #mm-pdp-hero-{{ sid }} .mm-gal-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 40px; height: 40px; border-radius: 50%; border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
    background: rgba(10,5,3,0.72); color: #fff; font-size: 22px; line-height: 1; cursor: pointer;
    display: none; align-items: center; justify-content: center; backdrop-filter: blur(4px);
  }
  #mm-pdp-hero-{{ sid }} .mm-gal.has-many .mm-gal-nav { display: flex; }
  #mm-pdp-hero-{{ sid }} .mm-gal-nav.prev { left: 10px; }
  #mm-pdp-hero-{{ sid }} .mm-gal-nav.next { right: 10px; }
  #mm-pdp-hero-{{ sid }} .mm-gal-nav[disabled] { opacity: .35; cursor: default; }
  #mm-pdp-hero-{{ sid }} .mm-gal-thumbs {
    display: flex; gap: 8px; margin-top: 10px; overflow-x: auto;
    scrollbar-width: none; -ms-overflow-style: none;
  }
  #mm-pdp-hero-{{ sid }} .mm-gal-thumbs::-webkit-scrollbar { display: none; }
  #mm-pdp-hero-{{ sid }} .mm-gal-thumb {
    flex: 0 0 64px; width: 64px; height: 64px; padding: 0; cursor: pointer;
    border-radius: 10px; overflow: hidden; background: var(--mars-panel, #1a0e07);
    border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
  }
  @media (min-width: 900px) { #mm-pdp-hero-{{ sid }} .mm-gal-thumb { flex-basis: 76px; width: 76px; height: 76px; } }
  #mm-pdp-hero-{{ sid }} .mm-gal-thumb.is-active { border-color: var(--brand, #ff5600); }
  #mm-pdp-hero-{{ sid }} .mm-gal-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* ---------- heading ---------- */
  #mm-pdp-hero-{{ sid }} .mm-rating { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin: 0 0 10px; }
  #mm-pdp-hero-{{ sid }} .mm-stars { color: var(--brand-yellow, #ff8a00); letter-spacing: 2px; font-size: calc((15px) * var(--fs-b, 1)); }
  #mm-pdp-hero-{{ sid }} .mm-rating-text {
    font-size: calc((12.5px) * var(--fs-b, 1)); letter-spacing: .06em; text-transform: uppercase;
    color: rgba(255,255,255,0.72); font-weight: 600;
  }
  #mm-pdp-hero-{{ sid }} h1 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((clamp(23px, 4.6vw, 34px)) * var(--fs-h, 1));
    line-height: 1.18; margin: 0 0 12px;
  }
  #mm-pdp-hero-{{ sid }} h1 .orange { color: var(--brand, #ff5600); }
  #mm-pdp-hero-{{ sid }} .mm-lede {
    font-family: var(--font-body); font-weight: 300; line-height: 1.65;
    font-size: calc((14.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.78); margin: 0 0 20px;
  }

  /* ---------- benefit icons ---------- */
  #mm-pdp-hero-{{ sid }} .mm-benefits {
    display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin: 0 0 22px;
  }
  @media (min-width: 480px) { #mm-pdp-hero-{{ sid }} .mm-benefits { grid-template-columns: repeat(4, 1fr); } }
  #mm-pdp-hero-{{ sid }} .mm-benefit {
    text-align: center; padding: 12px 8px; border-radius: 12px;
    background: rgba(26,14,7,0.72); border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
  }
  #mm-pdp-hero-{{ sid }} .mm-benefit .ic { display: block; font-size: 20px; line-height: 1; margin: 0 auto 6px; }
  #mm-pdp-hero-{{ sid }} .mm-benefit img.ic { width: 28px; height: 28px; object-fit: contain; }
  #mm-pdp-hero-{{ sid }} .mm-benefit .tt {
    display: block; font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    font-size: calc((10px) * var(--fs-b, 1)); letter-spacing: .04em; line-height: 1.3;
  }
  #mm-pdp-hero-{{ sid }} .mm-benefit .tx {
    display: block; font-size: calc((11px) * var(--fs-b, 1)); line-height: 1.45;
    color: rgba(255,255,255,0.62); margin-top: 4px; font-weight: 300;
  }

  /* ---------- supplement facts ---------- */
  #mm-pdp-hero-{{ sid }} .mm-facts { margin: 0 0 22px; }
  #mm-pdp-hero-{{ sid }} .mm-facts img {
    display: block; width: 100%; height: auto; border-radius: 12px;
    border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
  }
  #mm-pdp-hero-{{ sid }} .mm-facts figcaption {
    font-size: calc((11.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.55);
    margin-top: 8px; line-height: 1.5;
  }

  /* ---------- plan selector ---------- */
  #mm-pdp-hero-{{ sid }} .mm-plans-title {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((13px) * var(--fs-b, 1)); letter-spacing: .06em; margin: 0 0 10px;
  }
  #mm-pdp-hero-{{ sid }} .mm-plans { display: grid; gap: 10px; margin: 0 0 16px; border: 0; padding: 0; }
  #mm-pdp-hero-{{ sid }} .mm-plans legend { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  #mm-pdp-hero-{{ sid }} .mm-plan { position: relative; display: block; cursor: pointer; }
  #mm-pdp-hero-{{ sid }} .mm-plan input {
    position: absolute; opacity: 0; width: 1px; height: 1px; pointer-events: none;
  }
  #mm-pdp-hero-{{ sid }} .mm-plan-box {
    display: grid; grid-template-columns: 22px minmax(0, 1fr) auto; align-items: center; gap: 12px;
    padding: 14px 14px; border-radius: 14px;
    background: rgba(26,14,7,0.72); border: 2px solid var(--mars-line, rgba(255,255,255,0.12));
    transition: border-color .16s ease, background .16s ease;
  }
  #mm-pdp-hero-{{ sid }} .mm-plan:hover .mm-plan-box { border-color: rgba(255,86,0,0.5); }
  #mm-pdp-hero-{{ sid }} .mm-plan input:checked ~ .mm-plan-box {
    border-color: var(--brand, #ff5600); background: rgba(255,86,0,0.09);
  }
  #mm-pdp-hero-{{ sid }} .mm-plan input:focus-visible ~ .mm-plan-box { outline: 2px solid var(--brand-yellow, #ff8a00); outline-offset: 2px; }
  #mm-pdp-hero-{{ sid }} .mm-dot {
    width: 20px; height: 20px; border-radius: 50%; border: 2px solid rgba(255,255,255,0.35);
    display: flex; align-items: center; justify-content: center;
  }
  #mm-pdp-hero-{{ sid }} .mm-plan input:checked ~ .mm-plan-box .mm-dot { border-color: var(--brand, #ff5600); }
  #mm-pdp-hero-{{ sid }} .mm-dot::after { content: ''; width: 9px; height: 9px; border-radius: 50%; background: transparent; }
  #mm-pdp-hero-{{ sid }} .mm-plan input:checked ~ .mm-plan-box .mm-dot::after { background: var(--brand, #ff5600); }
  #mm-pdp-hero-{{ sid }} .mm-plan-name {
    display: block; font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    font-size: calc((13px) * var(--fs-b, 1)); line-height: 1.25;
  }
  #mm-pdp-hero-{{ sid }} .mm-plan-sub {
    display: block; font-size: calc((12px) * var(--fs-b, 1)); color: rgba(255,255,255,0.62);
    margin-top: 3px; line-height: 1.4; font-weight: 300;
  }
  #mm-pdp-hero-{{ sid }} .mm-plan-save {
    display: inline-block; margin-top: 6px; font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700;
    color: var(--brand-green, #39c46e); text-transform: uppercase; letter-spacing: .04em;
  }
  #mm-pdp-hero-{{ sid }} .mm-plan-price { text-align: right; white-space: nowrap; }
  #mm-pdp-hero-{{ sid }} .mm-plan-price .now {
    display: block; font-family: var(--font-heading); font-weight: 800;
    font-size: calc((17px) * var(--fs-b, 1));
  }
  #mm-pdp-hero-{{ sid }} .mm-plan-price .old {
    display: block; font-size: calc((12px) * var(--fs-b, 1)); color: rgba(255,255,255,0.45);
    text-decoration: line-through; margin-top: 2px;
  }
  #mm-pdp-hero-{{ sid }} .mm-ribbon {
    position: absolute; top: -9px; right: 12px; z-index: 2;
    background: var(--brand, #ff5600); color: #fff;
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((9.5px) * var(--fs-b, 1)); letter-spacing: .06em;
    padding: 4px 9px; border-radius: 999px; line-height: 1;
  }
  #mm-pdp-hero-{{ sid }} .mm-ribbon.alt { background: var(--brand-green, #39c46e); color: #06210f; }

  /* ---------- app block slot (Kaching Bundles and similar) ---------- */
  #mm-pdp-hero-{{ sid }} .mm-app-slot { margin: 0 0 16px; }
  #mm-pdp-hero-{{ sid }} .mm-app-slot:empty { display: none; }

  /* ---------- standard product form ---------- */
  #mm-pdp-hero-{{ sid }} .mm-options { display: grid; gap: 12px; margin: 0 0 16px; }
  #mm-pdp-hero-{{ sid }} .mm-option-label {
    display: block; margin-bottom: 6px;
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    font-size: calc((11px) * var(--fs-b, 1)); letter-spacing: .05em; color: rgba(255,255,255,0.72);
  }
  #mm-pdp-hero-{{ sid }} .mm-option select {
    width: 100%; padding: 13px 14px; border-radius: 12px; cursor: pointer;
    background: rgba(26,14,7,0.72); color: #fff;
    border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
    font-family: var(--font-body); font-size: calc((14px) * var(--fs-b, 1));
  }
  #mm-pdp-hero-{{ sid }} .mm-option select:focus-visible { outline: 2px solid var(--brand-yellow, #ff8a00); outline-offset: 2px; }
  #mm-pdp-hero-{{ sid }} .mm-qty-row {
    display: flex; align-items: center; flex-wrap: wrap; gap: 12px; margin: 0 0 16px;
  }
  #mm-pdp-hero-{{ sid }} .mm-qty-label {
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    font-size: calc((11px) * var(--fs-b, 1)); letter-spacing: .05em; color: rgba(255,255,255,0.72);
  }
  #mm-pdp-hero-{{ sid }} .mm-stepper {
    display: flex; align-items: center; gap: 2px; border-radius: 999px; overflow: hidden;
    background: rgba(26,14,7,0.72); border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
  }
  #mm-pdp-hero-{{ sid }} .mm-stepper button {
    width: 38px; height: 38px; border: 0; cursor: pointer; background: transparent; color: #fff;
    font-size: 17px; line-height: 1;
  }
  #mm-pdp-hero-{{ sid }} .mm-stepper button:hover { background: rgba(255,255,255,0.08); }
  #mm-pdp-hero-{{ sid }} .mm-stepper .num {
    min-width: 30px; text-align: center;
    font-family: var(--font-heading); font-weight: 700; font-size: calc((14px) * var(--fs-b, 1));
  }
  #mm-pdp-hero-{{ sid }} .mm-std-price {
    margin-left: auto; font-family: var(--font-heading); font-weight: 800;
    font-size: calc((19px) * var(--fs-b, 1));
  }

  /* ---------- CTA ---------- */
  #mm-pdp-hero-{{ sid }} .mm-cta {
    display: block; width: 100%; cursor: pointer; border: 0;
    background: var(--brand, #ff5600); color: #fff;
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((15px) * var(--fs-b, 1)); letter-spacing: .05em;
    padding: 18px 20px; border-radius: 999px;
    box-shadow: 0 6px 0 rgba(0,0,0,0.35); transition: transform .12s ease, background .16s ease;
  }
  #mm-pdp-hero-{{ sid }} .mm-cta:hover { background: #ff6a1f; }
  #mm-pdp-hero-{{ sid }} .mm-cta:active { transform: translateY(4px); box-shadow: 0 2px 0 rgba(0,0,0,0.35); }
  #mm-pdp-hero-{{ sid }} .mm-cta[disabled] { background: #4a3629; cursor: not-allowed; box-shadow: none; }
  #mm-pdp-hero-{{ sid }} .mm-cta-note {
    text-align: center; font-size: calc((11.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.6);
    margin: 10px 0 0; line-height: 1.5;
  }

  /* ---------- trust rows ---------- */
  #mm-pdp-hero-{{ sid }} .mm-trust { margin: 18px 0 0; padding: 0; list-style: none; display: grid; gap: 10px; }
  #mm-pdp-hero-{{ sid }} .mm-trust li {
    display: grid; grid-template-columns: 22px minmax(0, 1fr); gap: 10px; align-items: start;
    font-size: calc((12.5px) * var(--fs-b, 1)); line-height: 1.5; color: rgba(255,255,255,0.75);
  }
  #mm-pdp-hero-{{ sid }} .mm-trust .ic { font-size: 15px; line-height: 1.35; text-align: center; }
  #mm-pdp-hero-{{ sid }} .mm-trust strong { color: #fff; font-weight: 700; }
  #mm-pdp-hero-{{ sid }} .mm-guarantee {
    margin-top: 16px; padding: 12px 14px; border-radius: 12px; text-align: center;
    background: rgba(57,196,110,0.10); border: 1px solid rgba(57,196,110,0.35);
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    font-size: calc((11px) * var(--fs-b, 1)); letter-spacing: .05em; color: var(--brand-green, #39c46e);
    line-height: 1.45;
  }
  #mm-pdp-hero-{{ sid }} .mm-warn {
    margin: 12px 0; padding: 10px 12px; border-radius: 10px; line-height: 1.5;
    background: rgba(255,138,0,0.12); border: 1px solid rgba(255,138,0,0.45);
    font-size: calc((12px) * var(--fs-b, 1)); color: #ffd9b0;
  }
  #mm-pdp-hero-{{ sid }} .mm-warn code { background: rgba(0,0,0,0.35); padding: 1px 5px; border-radius: 4px; }
</style>

<section id="mm-pdp-hero-{{ sid }}" class="reveal" data-testid="pdp-hero">
  <a id="buy" aria-hidden="true"></a>
  <div class="mm-wrap">
    <div class="mm-cols">

      {%- comment -%} ---------------- media column ---------------- {%- endcomment -%}
      <div class="mm-media">
        {%- assign gal_images = gallery_product.images -%}
        {%- if gallery_product != blank and gallery_product.id != blank and gal_images.size > 0 -%}
          {%- assign img_count = gal_images.size -%}
          <div class="mm-gal{% if img_count > 1 %} has-many{% endif %}" data-gal>
            <div class="mm-gal-track" data-gal-track tabindex="0" role="group" aria-label="{{ gallery_product.title | escape }}">
              {%- for image in gal_images -%}
                <div class="mm-gal-slide">
                  <img src="{{ image | image_url: width: 900 }}" width="900" height="900"
                    alt="{{ image.alt | default: gallery_product.title | escape }}"
                    loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                    {% if forloop.first %}fetchpriority="high"{% endif %}>
                </div>
              {%- endfor -%}
            </div>
            {%- if img_count > 1 -%}
              <button type="button" class="mm-gal-nav prev" data-gal-prev aria-label="Previous image">‹</button>
              <button type="button" class="mm-gal-nav next" data-gal-next aria-label="Next image">›</button>
              <div class="mm-gal-thumbs" data-gal-thumbs>
                {%- for image in gal_images -%}
                  <button type="button" class="mm-gal-thumb{% if forloop.first %} is-active{% endif %}"
                    data-gal-thumb="{{ forloop.index0 }}" aria-label="Show image {{ forloop.index }}">
                    <img src="{{ image | image_url: width: 180 }}" width="180" height="180" alt="" loading="lazy">
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>
        {%- elsif s.fallback_image != blank -%}
          <div class="mm-gal">
            <div class="mm-gal-track">
              <div class="mm-gal-slide">
                <img src="{{ s.fallback_image | image_url: width: 900 }}" width="900" height="900"
                  alt="{{ s.title | default: shop.name | escape }}" loading="eager">
              </div>
            </div>
          </div>
        {%- else -%}
          <div class="mm-gal">
            <div class="mm-gal-track">
              <div class="mm-gal-slide">
                <img src="{{ 'MM_ProductImages_PDP_1x1__1.png' | asset_url }}" width="900" height="900"
                  alt="{{ s.title | default: shop.name | escape }}" loading="eager">
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------------- buy column ---------------- {%- endcomment -%}
      <div class="mm-buy">

        {%- if s.rating_text != blank or s.show_stars -%}
          <p class="mm-rating">
            {%- if s.show_stars -%}
              {%- assign full_stars = s.rating_value | round -%}
              <span class="mm-stars" aria-hidden="true">
                {%- for i in (1..5) -%}{% if i <= full_stars %}★{% else %}☆{% endif %}{%- endfor -%}
              </span>
            {%- endif -%}
            {%- if s.rating_text != blank -%}
              <span class="mm-rating-text">{{ s.rating_text }}</span>
            {%- endif -%}
          </p>
        {%- endif -%}

        <h1>
          {%- if s.title != blank -%}
            {{ s.title }}
          {%- else -%}
            {{ product.title | default: shop.name }}
          {%- endif -%}
          {%- if s.title_highlight != blank -%} <span class="orange">{{ s.title_highlight }}</span>{%- endif -%}
        </h1>

        {%- if s.lede != blank -%}
          <div class="mm-lede">{{ s.lede }}</div>
        {%- elsif product.description != blank -%}
          <div class="mm-lede">{{ product.description | strip_html | truncatewords: 70 }}</div>
        {%- endif -%}

        {%- if benefit_blocks.size > 0 -%}
          <div class="mm-benefits">
            {%- for block in benefit_blocks -%}
              <div class="mm-benefit" {{ block.shopify_attributes }}>
                {%- if block.settings.icon_image != blank -%}
                  <img class="ic" src="{{ block.settings.icon_image | image_url: width: 80 }}" width="80" height="80"
                    alt="" loading="lazy">
                {%- elsif block.settings.icon != blank -%}
                  <span class="ic" aria-hidden="true">{{ block.settings.icon }}</span>
                {%- endif -%}
                {%- if block.settings.title != blank -%}<span class="tt">{{ block.settings.title }}</span>{%- endif -%}
                {%- if block.settings.text != blank -%}<span class="tx">{{ block.settings.text }}</span>{%- endif -%}
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if s.facts_image != blank -%}
          <figure class="mm-facts">
            <img src="{{ s.facts_image | image_url: width: 1000 }}"
              alt="{{ s.facts_alt | default: 'Supplement Facts' | escape }}" loading="lazy" width="1000" height="1000">
            {%- if s.facts_caption != blank -%}<figcaption>{{ s.facts_caption }}</figcaption>{%- endif -%}
          </figure>
        {%- endif -%}

        {%- comment -%} ---------------- buy area ----------------

          Three modes, set by "Buy box mode":

            plans     the theme's own plan selector (below)
            standard  a plain variant + quantity + add-to-cart form, which is the
                      shape bundle apps such as Kaching Bundles look for
            app       no theme form at all; an app block provides the whole offer

          App blocks render in their own slot above the form in every mode, so a
          bundle app can sit over the standard form or replace it entirely.
        {%- endcomment -%}
        {%- assign buy_mode = s.buy_mode | default: 'plans' -%}

        {%- assign has_app_block = false -%}
        {%- for block in section.blocks -%}
          {%- if block.type == '@app' -%}{%- assign has_app_block = true -%}{%- break -%}{%- endif -%}
        {%- endfor -%}
        {%- if has_app_block -%}
          <div class="mm-app-slot">
            {%- for block in section.blocks -%}
              {%- if block.type == '@app' -%}{% render block %}{%- endif -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- case buy_mode -%}

        {%- when 'standard' -%}
          {%- assign std_product = blank -%}
          {%- if s.standard_product_handle != blank -%}
            {%- assign std_product = all_products[s.standard_product_handle] -%}
          {%- endif -%}
          {%- if std_product == blank or std_product.id == blank -%}{%- assign std_product = product -%}{%- endif -%}
          {%- if std_product != blank and std_product.id != blank -%}
            {%- assign std_variant = std_product.selected_or_first_available_variant -%}

            {%- comment -%} A subscription-only product is rejected by /cart/add unless a
              selling plan travels with it, so attach one whenever the product demands it.
              This is the same rule sections/pricing.liquid applies. {%- endcomment -%}
            {%- assign std_plan = s.standard_selling_plan_id -%}
            {%- if std_plan == blank and std_product.requires_selling_plan and std_product.selling_plan_groups.size > 0 -%}
              {%- assign std_plan = std_product.selling_plan_groups.first.selling_plans.first.id -%}
            {%- endif -%}
            {%- assign std_plan_s = std_plan | append: '' -%}

            {%- comment -%} Show what the shopper is actually charged: the plan's
              per-delivery price when a plan is attached, not the bare variant price. {%- endcomment -%}
            {%- assign std_price = std_variant.price -%}
            {%- if std_plan != blank -%}
              {%- for allocation in std_variant.selling_plan_allocations -%}
                {%- assign alloc_s = allocation.selling_plan.id | append: '' -%}
                {%- if alloc_s == std_plan_s -%}
                  {%- assign std_price = allocation.per_delivery_price -%}
                  {%- break -%}
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}

            <form action="{{ routes.cart_add_url }}" method="post" data-buy-form data-standard-form
              data-selling-plan="{{ std_plan }}">
              {%- if s.after_add == 'checkout' -%}
                <input type="hidden" name="return_to" value="/checkout">
              {%- endif -%}
              <input type="hidden" name="id" value="{{ std_variant.id }}" data-variant-input>
              {%- if std_plan != blank -%}
                <input type="hidden" name="selling_plan" value="{{ std_plan }}">
              {%- endif -%}

              {%- unless std_product.has_only_default_variant -%}
                <div class="mm-options">
                  {%- for option in std_product.options_with_values -%}
                    {%- comment -%} No name attribute on purpose: the submitted variant is
                      carried by the hidden id above, so the POST stays unambiguous when a
                      bundle app rewrites it. {%- endcomment -%}
                    <label class="mm-option">
                      <span class="mm-option-label">{{ option.name }}</span>
                      <select data-option-select data-option-index="{{ forloop.index0 }}">
                        {%- for value in option.values -%}
                          <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                        {%- endfor -%}
                      </select>
                    </label>
                  {%- endfor -%}
                </div>
              {%- endunless -%}

              <div class="mm-qty-row">
                <span class="mm-qty-label">{{ s.qty_label }}</span>
                <div class="mm-stepper" data-stepper>
                  <button type="button" aria-label="Decrease quantity">−</button>
                  <span class="num">1</span>
                  <button type="button" aria-label="Increase quantity">+</button>
                </div>
                <input type="hidden" name="quantity" value="1">
                <span class="mm-std-price" data-std-price>{{ std_price | money }}</span>
              </div>

              <button type="submit" class="mm-cta" data-buy-submit
                data-label-available="{{ s.cta_label | escape }}"
                data-label-soldout="{{ s.sold_out_label | escape }}"
                {% unless std_variant.available %}disabled{% endunless %}>
                {%- if std_variant.available -%}{{ s.cta_label }}{%- else -%}{{ s.sold_out_label }}{%- endif -%}
              </button>

              {%- comment -%} Pre-formatted money strings so the client never has to guess
                the shop's currency format. {%- endcomment -%}
              <script type="application/json" data-variant-json>
                [
                  {%- for v in std_product.variants -%}
                    {%- assign v_price = v.price -%}
                    {%- if std_plan != blank -%}
                      {%- for allocation in v.selling_plan_allocations -%}
                        {%- assign a_s = allocation.selling_plan.id | append: '' -%}
                        {%- if a_s == std_plan_s -%}
                          {%- assign v_price = allocation.per_delivery_price -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- endif -%}
                    {
                      "id": {{ v.id }},
                      "available": {{ v.available }},
                      "price": {{ v_price | money | json }},
                      "options": {{ v.options | json }}
                    }{% unless forloop.last %},{% endunless %}
                  {%- endfor -%}
                ]
              </script>
            </form>

            {%- if s.cta_note != blank -%}
              <p class="mm-cta-note">{{ s.cta_note }}</p>
            {%- endif -%}
          {%- elsif request.design_mode -%}
            <div class="mm-warn">⚙️ Buy box mode is “Standard product form”, but no product is connected. Assign this template to a product, or pick one under “Standard form product”.</div>
          {%- endif -%}

        {%- when 'app' -%}
          {%- if request.design_mode and has_app_block == false -%}
            <div class="mm-warn">⚙️ Buy box mode is “App block only”, so the theme renders no cart form here. Add your bundle app's block to this section (Add block → under Apps), or switch the mode back.</div>
          {%- endif -%}

        {%- else -%}
        {%- if plan_blocks.size > 0 -%}
          {%- assign any_buyable = false -%}

          <form action="{{ routes.cart_add_url }}" method="post" data-buy-form>
            {%- comment -%} snippets/cart-drawer.liquid bails out of its AJAX intercept when
              it finds a return_to pointing at checkout, so this input is what decides
              between "add and open the drawer" and "skip the cart entirely". {%- endcomment -%}
            {%- if s.after_add == 'checkout' -%}
              <input type="hidden" name="return_to" value="/checkout">
            {%- endif -%}
            <input type="hidden" name="id" value="" data-variant-input>
            <input type="hidden" name="selling_plan" value="" data-plan-input disabled>
            <input type="hidden" name="quantity" value="1">

            {%- if s.plans_title != blank -%}
              <p class="mm-plans-title">{{ s.plans_title }}</p>
            {%- endif -%}

            <fieldset class="mm-plans">
              <legend>{{ s.plans_title | default: 'Choose your plan' }}</legend>
              {%- for block in plan_blocks -%}
                {%- assign bs = block.settings -%}

                {%- comment -%} product: block picker → handle fallbacks → the page's product {%- endcomment -%}
                {%- assign bp = bs.product -%}
                {%- if bp == blank or bp.id == blank -%}
                  {%- if bs.product_handle != blank -%}
                    {%- assign bp = all_products[bs.product_handle] -%}
                  {%- endif -%}
                {%- endif -%}
                {%- if bp == blank or bp.id == blank -%}{%- assign bp = product -%}{%- endif -%}

                {%- assign b_variant = blank -%}
                {%- assign b_variant_id = blank -%}
                {%- assign b_plan_id = blank -%}
                {%- assign b_available = false -%}

                {%- if bp != blank and bp.id != blank -%}
                  {%- assign b_variant = bp.selected_or_first_available_variant -%}
                  {%- if bs.variant_id != blank -%}
                    {%- for v in bp.variants -%}
                      {%- assign v_id_s = v.id | append: '' -%}
                      {%- if v_id_s == bs.variant_id -%}{%- assign b_variant = v -%}{%- break -%}{%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- if b_variant != blank -%}
                    {%- assign b_variant_id = b_variant.id -%}
                    {%- assign b_available = b_variant.available -%}
                  {%- endif -%}

                  {%- assign b_plan_id = bs.selling_plan_id -%}
                  {%- if b_plan_id == blank and bp.selling_plan_groups.size > 0 -%}
                    {%- assign b_plan_id = bp.selling_plan_groups.first.selling_plans.first.id -%}
                  {%- endif -%}
                {%- endif -%}

                {%- if b_available -%}{%- assign any_buyable = true -%}{%- endif -%}

                {%- comment -%} Price actually charged: the selling-plan allocation when a plan
                  is attached, else the variant price, else the merchant's text fallback. {%- endcomment -%}
                {%- assign b_price = blank -%}
                {%- assign b_compare = blank -%}
                {%- if b_variant != blank -%}
                  {%- assign b_price = b_variant.price -%}
                  {%- assign b_compare = b_variant.compare_at_price -%}
                  {%- if b_plan_id != blank -%}
                    {%- assign b_plan_id_s = b_plan_id | append: '' -%}
                    {%- for allocation in b_variant.selling_plan_allocations -%}
                      {%- assign alloc_id_s = allocation.selling_plan.id | append: '' -%}
                      {%- if alloc_id_s == b_plan_id_s -%}
                        {%- assign b_price = allocation.per_delivery_price -%}
                        {%- assign b_compare = allocation.compare_at_price -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                {%- endif -%}

                {%- assign is_checked = false -%}
                {%- if forloop.index0 == default_plan_index -%}{%- assign is_checked = true -%}{%- endif -%}

                <label class="mm-plan" {{ block.shopify_attributes }}>
                  {%- if bs.ribbon != blank -%}
                    <span class="mm-ribbon{% if bs.ribbon_style == 'green' %} alt{% endif %}">{{ bs.ribbon }}</span>
                  {%- endif -%}
                  <input type="radio" name="mm-plan-{{ sid }}"
                    value="{{ block.id }}"
                    data-plan-radio
                    data-variant="{{ b_variant_id }}"
                    data-selling-plan="{{ b_plan_id }}"
                    {% if is_checked %}checked{% endif %}
                    {% unless b_available %}disabled{% endunless %}>
                  <span class="mm-plan-box">
                    <span class="mm-dot" aria-hidden="true"></span>
                    <span>
                      <span class="mm-plan-name">{{ bs.name }}</span>
                      {%- if bs.sub != blank -%}<span class="mm-plan-sub">{{ bs.sub }}</span>{%- endif -%}
                      {%- if bs.save_text != blank -%}<span class="mm-plan-save">{{ bs.save_text }}</span>{%- endif -%}
                    </span>
                    <span class="mm-plan-price">
                      {%- if b_price != blank -%}
                        <span class="now">{{ b_price | money }}</span>
                        {%- if b_compare > b_price -%}<span class="old">{{ b_compare | money }}</span>{%- endif -%}
                      {%- else -%}
                        {%- if bs.price_text != blank -%}<span class="now">{{ bs.price_text }}</span>{%- endif -%}
                        {%- if bs.compare_text != blank -%}<span class="old">{{ bs.compare_text }}</span>{%- endif -%}
                      {%- endif -%}
                    </span>
                  </span>
                </label>
              {%- endfor -%}
            </fieldset>

            {%- if request.design_mode and any_buyable == false -%}
              <div class="mm-warn">⚙️ No plan is connected to a purchasable product yet. Open each “Plan” block and pick a product (or type its handle, e.g. <code>3-month-auto-renew-subscription</code> / <code>monthly-plan</code>). Until then the prices shown come from the text fields and the button stays disabled.</div>
            {%- endif -%}

            <button type="submit" class="mm-cta" data-buy-submit {% unless any_buyable %}disabled{% endunless %}>
              {%- if any_buyable -%}{{ s.cta_label }}{%- else -%}{{ s.sold_out_label }}{%- endif -%}
            </button>

            {%- if s.cta_note != blank -%}
              <p class="mm-cta-note">{{ s.cta_note }}</p>
            {%- endif -%}
          </form>
        {%- elsif request.design_mode -%}
          <div class="mm-warn">⚙️ Add at least one “Plan” block to this section so the page has something to sell — or switch “Buy box mode” to use a bundle app instead.</div>
        {%- endif -%}

        {%- endcase -%}

        {%- if trust_blocks.size > 0 -%}
          <ul class="mm-trust">
            {%- for block in trust_blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="ic" aria-hidden="true">{{ block.settings.icon }}</span>
                <span>
                  {%- if block.settings.strong != blank -%}<strong>{{ block.settings.strong }}</strong> {% endif -%}
                  {{ block.settings.text }}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if s.guarantee_text != blank -%}
          <p class="mm-guarantee">{{ s.guarantee_text }}</p>
        {%- endif -%}

      </div>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;

  /* ---- gallery: arrows + thumbs. Horizontal drag comes free from overflow-x. ---- */
  root.querySelectorAll('[data-gal]').forEach(function (gal) {
    var track = gal.querySelector('[data-gal-track]');
    if (!track) return;
    var slides = track.querySelectorAll('.mm-gal-slide');
    if (slides.length < 2) return;
    var prev = gal.querySelector('[data-gal-prev]');
    var next = gal.querySelector('[data-gal-next]');
    var thumbs = gal.querySelectorAll('[data-gal-thumb]');

    function current() {
      var w = track.clientWidth;
      return w ? Math.round(track.scrollLeft / w) : 0;
    }
    function goTo(i) {
      var max = slides.length - 1;
      if (i < 0) i = 0;
      if (i > max) i = max;
      track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
    }
    function sync() {
      var i = current();
      thumbs.forEach(function (t, n) { t.classList.toggle('is-active', n === i); });
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= slides.length - 1;
    }

    if (prev) prev.addEventListener('click', function () { goTo(current() - 1); });
    if (next) next.addEventListener('click', function () { goTo(current() + 1); });
    thumbs.forEach(function (t, n) { t.addEventListener('click', function () { goTo(n); }); });
    track.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current() + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current() - 1); }
    });
    var raf;
    track.addEventListener('scroll', function () {
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    }, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });

  /* ---- quantity stepper (standard mode) ---- */
  root.querySelectorAll('[data-stepper]').forEach(function (st) {
    var btns = st.querySelectorAll('button');
    var numEl = st.querySelector('.num');
    var owner = st.closest('form');
    if (btns.length < 2 || !numEl || !owner) return;
    function set(n) {
      if (n < 1) n = 1;
      numEl.textContent = n;
      var q = owner.querySelector('input[name="quantity"]');
      if (q) q.value = n;
    }
    btns[0].addEventListener('click', function () { set((parseInt(numEl.textContent, 10) || 1) - 1); });
    btns[1].addEventListener('click', function () { set((parseInt(numEl.textContent, 10) || 1) + 1); });
  });

  /* ---- standard mode: keep the hidden variant id in step with the selects ---- */
  var stdForm = root.querySelector('[data-standard-form]');
  if (stdForm) {
    var dataEl = stdForm.querySelector('[data-variant-json]');
    var variants = [];
    try { variants = JSON.parse(dataEl.textContent); } catch (e) { variants = []; }
    var selects = stdForm.querySelectorAll('[data-option-select]');
    var stdId = stdForm.querySelector('[data-variant-input]');
    var stdPrice = stdForm.querySelector('[data-std-price]');
    var stdBtn = stdForm.querySelector('[data-buy-submit]');

    function updateVariant() {
      var chosen = Array.prototype.map.call(selects, function (sel) { return sel.value; });
      var match = null;
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var ok = true;
        for (var j = 0; j < chosen.length; j++) { if (v.options[j] !== chosen[j]) { ok = false; break; } }
        if (ok) { match = v; break; }
      }
      if (!match) return;
      if (stdId) stdId.value = match.id;
      if (stdPrice) stdPrice.textContent = match.price;
      if (stdBtn) {
        stdBtn.disabled = !match.available;
        /* Labels come from the section settings, so they are read back off the
           button rather than hard-coded here. */
        stdBtn.textContent = match.available
          ? stdBtn.getAttribute('data-label-available')
          : stdBtn.getAttribute('data-label-soldout');
      }
      document.dispatchEvent(new CustomEvent('mm:plan-change', {
        detail: {
          variant: String(match.id),
          sellingPlan: stdForm.getAttribute('data-selling-plan') || ''
        }
      }));
    }

    selects.forEach(function (sel) { sel.addEventListener('change', updateVariant); });
  }

  /* ---- plan selector: point the single form at the selected plan ---- */
  var form = root.querySelector('[data-buy-form]');
  if (!form) return;
  var variantInput = form.querySelector('[data-variant-input]');
  var planInput = form.querySelector('[data-plan-input]');
  var radios = form.querySelectorAll('[data-plan-radio]');
  if (!radios.length) return;

  function apply(radio) {
    if (!radio) return;
    var variant = radio.getAttribute('data-variant') || '';
    var plan = radio.getAttribute('data-selling-plan') || '';
    if (variantInput) variantInput.value = variant;
    if (planInput) {
      planInput.value = plan;
      /* A blank selling_plan must not be submitted at all — Shopify rejects it.
         Disabled inputs are left out of the POST body. */
      planInput.disabled = plan === '';
    }
  }

  radios.forEach(function (r) {
    r.addEventListener('change', function () { if (r.checked) apply(r); });
  });

  var checked = form.querySelector('[data-plan-radio]:checked');
  if (!checked) {
    /* The default block may be sold out and therefore disabled — fall back to
       the first plan that can actually be bought. */
    checked = form.querySelector('[data-plan-radio]:not([disabled])');
    if (checked) checked.checked = true;
  }
  apply(checked);

  /* The sticky bar mirrors this form's selection. */
  form.addEventListener('change', function () {
    var c = form.querySelector('[data-plan-radio]:checked');
    if (!c) return;
    document.dispatchEvent(new CustomEvent('mm:plan-change', {
      detail: {
        variant: c.getAttribute('data-variant') || '',
        sellingPlan: c.getAttribute('data-selling-plan') || ''
      }
    }));
  });
})();
</script>

{% schema %}
{
  "name": "PDP Hero",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "title", "label": "Product title", "info": "Leave empty to use the product's own title." },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)" },
    { "type": "richtext", "id": "lede", "label": "Short description", "info": "Leave empty to use the product description." },
    { "type": "header", "content": "Rating" },
    { "type": "checkbox", "id": "show_stars", "label": "Show stars", "default": true },
    { "type": "range", "id": "rating_value", "label": "Stars filled", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "text", "id": "rating_text", "label": "Rating text", "default": "RATED 4.8 · VERIFIED CUSTOMER FEEDBACK" },
    { "type": "header", "content": "Gallery" },
    { "type": "product", "id": "gallery_product", "label": "Gallery product", "info": "Leave empty to use the product this page is showing." },
    { "type": "image_picker", "id": "fallback_image", "label": "Fallback image", "info": "Used when the product has no images." },
    { "type": "header", "content": "Supplement facts" },
    { "type": "image_picker", "id": "facts_image", "label": "Supplement Facts image" },
    { "type": "text", "id": "facts_alt", "label": "Image alt text", "default": "UP MEN Supplement Facts" },
    { "type": "textarea", "id": "facts_caption", "label": "Caption", "default": "Suggested use: take 5 capsules daily with food." },
    { "type": "header", "content": "Buy box" },
    {
      "type": "select",
      "id": "buy_mode",
      "label": "Buy box mode",
      "info": "Switch to a standard form or an app block to sell with a bundle app such as Kaching Bundles instead of the theme's own plan selector.",
      "options": [
        { "value": "plans", "label": "Theme plan selector" },
        { "value": "standard", "label": "Standard product form (for bundle apps)" },
        { "value": "app", "label": "App block only (no theme cart form)" }
      ],
      "default": "plans"
    },
    { "type": "text", "id": "standard_product_handle", "label": "Standard form product handle", "info": "Standard mode only. Leave empty to use the product this page is showing. A handle rather than a picker because Shopify allows only one product picker per section, and the gallery already uses it." },
    { "type": "text", "id": "standard_selling_plan_id", "label": "Standard form selling plan ID (optional)", "info": "Standard mode only. If empty, a subscription-only product falls back to its first selling plan, which /cart/add requires." },
    { "type": "text", "id": "qty_label", "label": "Quantity label", "default": "Quantity" },
    { "type": "text", "id": "plans_title", "label": "Selector heading", "default": "CHOOSE YOUR ROUTINE" },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "ADD TO CART" },
    {
      "type": "select",
      "id": "after_add",
      "label": "After adding to cart",
      "options": [
        { "value": "drawer", "label": "Open the cart drawer" },
        { "value": "checkout", "label": "Go straight to checkout" }
      ],
      "default": "drawer"
    },
    { "type": "text", "id": "sold_out_label", "label": "Button label when unavailable", "default": "CURRENTLY UNAVAILABLE" },
    { "type": "text", "id": "cta_note", "label": "Note under the button", "default": "Order processing and delivery estimates are shown at checkout." },
    { "type": "text", "id": "guarantee_text", "label": "Guarantee strip", "default": "COVERED BY OUR 90-DAY SATISFACTION GUARANTEE" }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "plan",
      "name": "Plan",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        { "type": "text", "id": "product_handle", "label": "Or product handle", "info": "Used only when no product is selected above." },
        { "type": "text", "id": "variant_id", "label": "Variant ID (optional)" },
        { "type": "text", "id": "selling_plan_id", "label": "Selling plan ID (optional)", "info": "Required for subscription pricing. If empty, the product's first selling plan is used." },
        { "type": "checkbox", "id": "is_default", "label": "Selected by default", "default": false },
        { "type": "header", "content": "Copy" },
        { "type": "text", "id": "name", "label": "Plan name", "default": "90-DAY ROUTINE" },
        { "type": "text", "id": "sub", "label": "Plan subtitle", "default": "3 bottles delivered together" },
        { "type": "text", "id": "save_text", "label": "Savings line" },
        { "type": "text", "id": "ribbon", "label": "Ribbon" },
        {
          "type": "select",
          "id": "ribbon_style",
          "label": "Ribbon colour",
          "options": [
            { "value": "orange", "label": "Orange" },
            { "value": "green", "label": "Green" }
          ],
          "default": "orange"
        },
