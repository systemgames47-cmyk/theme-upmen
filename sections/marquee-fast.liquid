{%- comment -%} Fast marquee — brand slogan strip {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-fast-{{ sid }} { background: #000; color: #fff; overflow: hidden; padding: 16px 0; border-top: 1px solid rgba(255,255,255,0.1); border-bottom: 1px solid rgba(255,255,255,0.1); }
  #mm-fast-{{ sid }} .mm-track {
    display: flex; gap: 48px; width: max-content;
    animation: mm-fast-{{ sid }}-scroll 16s linear infinite;
  }
  #mm-fast-{{ sid }}:hover .mm-track { animation-play-state: paused; }
  #mm-fast-{{ sid }} .mm-item {
    display: inline-flex; align-items: center; gap: 14px; white-space: nowrap;
    font-family: var(--font-heading); font-size: calc((16px) * var(--fs-b, 1)); font-weight: 800;
    letter-spacing: 0.16em; text-transform: uppercase;
  }
  #mm-fast-{{ sid }} .mm-item .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--brand, #ff5600); display: inline-block; }
  @keyframes mm-fast-{{ sid }}-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
</style>

<section id="mm-fast-{{ sid }}" aria-hidden="true">
  <div class="mm-track">
    {%- for i in (1..8) -%}
      <span class="mm-item">{{ section.settings.text }} <span class="dot"></span></span>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Fast Marquee",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "ONE GIANT BOOST FOR MANKIND." }
  ],
  "presets": [{ "name": "Fast Marquee" }]
}
{% endschema %}
