{%- comment -%} Experts — trusted by men's health experts & world-class athletes {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-exp-{{ sid }} { background: #0a0503; color: var(--text, #fff); padding: 64px 0; overflow: hidden; }
  @media (min-width: 768px) { #mm-exp-{{ sid }} { padding: 96px 0; } }
  #mm-exp-{{ sid }} .mm-wrap { max-width: 1200px; margin: 0 auto; padding: 0 16px; }
  #mm-exp-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(24px, 4.2vw, 40px)) * var(--fs-h, 1)); line-height: 1.2; margin: 0 0 44px;
  }
  #mm-exp-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-exp-{{ sid }} .mm-slider { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; padding-bottom: 12px; -webkit-overflow-scrolling: touch; }
  #mm-exp-{{ sid }} .mm-slider::-webkit-scrollbar { height: 6px; }
  #mm-exp-{{ sid }} .mm-slider::-webkit-scrollbar-thumb { background: var(--brand, #ff5600); border-radius: 3px; }
  #mm-exp-{{ sid }} .mm-slider::-webkit-scrollbar-track { background: rgba(255,255,255,0.08); border-radius: 3px; }
  #mm-exp-{{ sid }} .mm-card {
    flex: 0 0 280px; scroll-snap-align: start;
    background: #1a0e07; border: 1px solid rgba(255,255,255,0.12); border-radius: 16px; overflow: hidden;
    display: flex; flex-direction: column;
  }
  @media (min-width: 768px) { #mm-exp-{{ sid }} .mm-card { flex-basis: 320px; } }
  #mm-exp-{{ sid }} .mm-card img { width: 100%; aspect-ratio: 1/1; object-fit: cover; object-position: top; display: block; }
  #mm-exp-{{ sid }} .mm-body { padding: 20px; }
  #mm-exp-{{ sid }} .mm-name {
    font-family: var(--font-heading); font-size: calc((15px) * var(--fs-h, 1)); font-weight: 800; text-transform: uppercase;
    letter-spacing: 0.06em; margin: 0 0 4px;
  }
  #mm-exp-{{ sid }} .mm-role {
    font-family: var(--font-heading); font-size: calc((10.5px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.12em;
    text-transform: uppercase; color: var(--brand, #ff5600); margin: 0 0 12px;
  }
  #mm-exp-{{ sid }} .mm-bio { font-size: calc((13.5px) * var(--fs-b, 1)); line-height: 1.55; color: rgba(255,255,255,0.78); margin: 0; }
  #mm-exp-{{ sid }} .mm-hint {
    text-align: center; margin-top: 16px;
    font-family: var(--font-heading); font-size: calc((10px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.2em;
    text-transform: uppercase; color: rgba(255,255,255,0.45);
  }
</style>

<section id="mm-exp-{{ sid }}" class="reveal" data-testid="experts">
  <div class="mm-wrap">
    <h2>{{ section.settings.title_pre }} <span class="orange">{{ section.settings.title_highlight }}</span></h2>
    <div class="mm-slider">
      {%- for block in section.blocks -%}
        <div class="mm-card" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            <img src="{{ block.settings.image | image_url: width: 640 }}" alt="{{ block.settings.name }}" loading="lazy">
          {%- elsif block.settings.image_asset != blank -%}
            <img src="{{ block.settings.image_asset | asset_url }}" alt="{{ block.settings.name }}" loading="lazy">
          {%- endif -%}
          <div class="mm-body">
            <h3 class="mm-name">{{ block.settings.name }}</h3>
            <p class="mm-role">{{ block.settings.role }}</p>
            <p class="mm-bio">{{ block.settings.bio }}</p>
          </div>
        </div>
      {%- endfor -%}
    </div>
    <p class="mm-hint">{{ section.settings.hint }}</p>
  </div>
</section>

{% schema %}
{
  "name": "Experts",
  "settings": [
    { "type": "text", "id": "title_pre", "label": "Title", "default": "TRUSTED BY MEN'S HEALTH" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)", "default": "EXPERTS & WORLD-CLASS ATHLETES" },
    { "type": "text", "id": "hint", "label": "Hint text", "default": "SWIPE TO SEE MORE →" }
  ],
  "blocks": [
    {
      "type": "expert",
      "name": "Expert",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "image_asset", "label": "Asset filename (fallback)", "info": "Image file in theme assets, e.g. rdm-experts-1.jpg" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role / credentials" },
        { "type": "textarea", "id": "bio", "label": "Bio" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Experts",
      "blocks": [
        { "type": "expert", "settings": { "image_asset": "rdm-experts-1.jpg", "name": "DR. ROBERT DORFMAN", "role": "PLASTIC SURGEON · FOUNDER, DONE BY DORFMAN", "bio": "Beverly Hills plastic surgeon trained at Northwestern, Oxford, and UCLA. Through his work with thousands of patients, he helps men take ownership of their health and show up more confidently." } },
        { "type": "expert", "settings": { "image_asset": "rdm-experts-2.jpg", "name": "ERIC LEIJA", "role": "PRIMAL SWOLEDIER", "bio": "Eric Leija has dedicated his career to helping men build functional strength and train in ways that enhance everyday life — emphasizing longevity, athleticism, and resilience." } },
        { "type": "expert", "settings": { "image_asset": "Dr._Schilling.png", "name": "DR. BLAINE SCHILLING", "role": "HORMONAL HEALTH SPECIALIST", "bio": "With over 30 years of experience in family medicine, Dr. Schilling has spent his career helping men navigate the realities of aging — a trusted voice on health, energy, and performance." } },
        { "type": "expert", "settings": { "image_asset": "rdm-experts-6.jpg", "name": "DR. KYLE GILLETT", "role": "DOUBLE BOARD-CERTIFIED PHYSICIAN", "bio": "Specializes in hormone optimization, longevity, and men's health. He combines advanced testing, evidence-based medicine, and personalized plans to help men perform at their highest level." } },
        { "type": "expert", "settings": { "image_asset": "rdm-experts-13.jpg", "name": "DANIEL CORMIER", "role": "UFC HALL OF FAME · UFC CHAMPION · OLYMPIAN", "bio": "Beyond his accomplishments in combat sports, Daniel embodies the values at the core of Up Men: consistency, accountability, and the belief that strong men are built through daily habits." } }
      ]
    }
  ]
}
{% endschema %}
