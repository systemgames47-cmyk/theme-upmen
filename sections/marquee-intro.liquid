{%- comment -%} Featured in — press logos strip (GQ, Men's Health, Forbes) {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-press-{{ sid }} { background: #0a0503; padding: 36px 16px; border-bottom: 1px solid rgba(255,255,255,0.08); }
  #mm-press-{{ sid }} .mm-row {
    max-width: 900px; margin: 0 auto;
    display: flex; align-items: center; justify-content: center; gap: 32px; flex-wrap: wrap;
  }
  #mm-press-{{ sid }} .mm-label {
    font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: rgba(255,255,255,0.6);
    white-space: nowrap;
  }
  #mm-press-{{ sid }} img { height: 26px; width: auto; opacity: 0.65; filter: brightness(0) invert(1); }
  @media (min-width: 768px) {
    #mm-press-{{ sid }} .mm-row { gap: 56px; }
    #mm-press-{{ sid }} img { height: 32px; }
  }
</style>

{%- capture mm_sel -%}mm-press-{{ section.id }}{%- endcapture -%}
{% render 'mm-section-colors', sel: mm_sel, s: section.settings %}

<section id="mm-press-{{ sid }}" class="reveal" aria-label="Featured in">
  <div class="mm-row">
    <span class="mm-label">{{ section.settings.label }}</span>
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.logo != blank -%}
          <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ block.settings.alt }}" loading="lazy" {{ block.shopify_attributes }}>
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      <img src="{{ 'gq.svg' | asset_url }}" alt="GQ" loading="lazy">
      <img src="{{ 'menshealth.svg' | asset_url }}" alt="Men's Health" loading="lazy">
      <img src="{{ 'forbes.svg' | asset_url }}" alt="Forbes" loading="lazy">
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured In",
  "max_blocks": 8,
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "paragraph", "content": "Leave a colour empty to keep the section's built-in styling." },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "heading_color", "label": "Headings" },
    { "type": "color", "id": "text_color", "label": "Body text" },
    { "type": "color", "id": "accent_color", "label": "Accent" },
    { "type": "color", "id": "accent_on", "label": "Text on accent" },
    { "type": "color", "id": "panel_color", "label": "Cards and panels" },
    { "type": "color", "id": "border_color", "label": "Borders" },
    { "type": "text", "id": "label", "label": "Label", "default": "FEATURED IN" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        { "type": "image_picker", "id": "logo", "label": "Logo image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [{ "name": "Featured In" }]
}
{% endschema %}
