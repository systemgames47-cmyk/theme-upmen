{%- comment -%} FAQ — accordion over Mars background {%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.bg_image != blank -%}
  {%- assign faq_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- else -%}
  {%- assign faq_bg = 'faq-bg_65302be7-39e3-444c-9a17-b48d6d01f1f8.jpg' | asset_url -%}
{%- endif -%}
{%- case section.settings.height_mobile -%}
  {%- when 'small' -%}{%- assign minh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign minh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign minh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign minh_mobile = '100svh' -%}
  {%- else -%}{%- assign minh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.height_desktop -%}
  {%- when 'small' -%}{%- assign minh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign minh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign minh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign minh_desktop = '100vh' -%}
  {%- else -%}{%- assign minh_desktop = 'auto' -%}
{%- endcase -%}
<style>
  #mm-faq-{{ sid }} {
    background: #0a0503 url('{{ faq_bg }}') center / cover no-repeat;
    color: var(--text, #fff); padding: 64px 0;
    min-height: {{ minh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
  @media (min-width: 768px) { #mm-faq-{{ sid }} { padding: 96px 0; min-height: {{ minh_desktop }}; } }
  #mm-faq-{{ sid }} .mm-wrap { max-width: 820px; margin: 0 auto; padding: 0 16px; }
  #mm-faq-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(26px, 4.6vw, 42px)) * var(--fs-h, 1)); margin: 0 0 40px;
  }
  #mm-faq-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-faq-{{ sid }} details {
    background: rgba(26,14,7,0.85); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px;
    margin-bottom: 12px; overflow: hidden;
  }
  #mm-faq-{{ sid }} summary {
    cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 20px; font-weight: 700; font-size: calc((15.5px) * var(--fs-b, 1));
  }
  #mm-faq-{{ sid }} summary::-webkit-details-marker { display: none; }
  #mm-faq-{{ sid }} summary::after {
    content: '+'; font-family: var(--font-heading); font-size: calc((20px) * var(--fs-b, 1)); font-weight: 700;
    color: var(--brand, #ff5600); flex-shrink: 0; transition: transform .2s ease;
  }
  #mm-faq-{{ sid }} details[open] summary::after { transform: rotate(45deg); }
  #mm-faq-{{ sid }} .mm-a {
    padding: 0 20px 18px; font-size: calc((14.5px) * var(--fs-b, 1)); line-height: 1.7; color: rgba(255,255,255,0.78);
    font-family: var(--font-body); font-weight: 300; letter-spacing: 0.01em;
  }
</style>

<section id="mm-faq-{{ sid }}" class="reveal" data-testid="faq">
  <a id="faq" aria-hidden="true"></a>
  <div class="mm-wrap">
    <h2>{{ section.settings.title_pre }} <span class="orange">{{ section.settings.title_highlight }}</span></h2>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
        <summary>{{ block.settings.question }}</summary>
        <div class="mm-a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "title_pre", "label": "Title", "default": "FREQUENTLY ASKED" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)", "default": "QUESTIONS" },
    { "type": "header", "content": "Banner size" },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (55% of screen)" },
        { "value": "medium", "label": "Medium (70% of screen)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (520px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "WHAT IS UP MEN?", "answer": "UP MEN is a men's dietary supplement with 9 active ingredients in each daily serving. It is designed to simplify the supplementation step inside a broader routine that can include nutrition, movement, training, sleep and consistent self-care." } },
        { "type": "faq", "settings": { "question": "WHAT DO I RECEIVE WITH THE 30-DAY PLAN?", "answer": "You receive 1 bottle with a 30-day supply, an UP MEN Branded Thermal Bottle, a Keychain Pill Case and the UP MEN Men's Wellness Guide (Digital). The physical gifts ship with your first order, and the digital guide is delivered by email." } },
        { "type": "faq", "settings": { "question": "WHAT DO I RECEIVE WITH THE 90-DAY PLAN?", "answer": "You receive 3 bottles delivered together for a complete 90-day supply, plus the Complete Welcome Kit: an UP MEN Branded Thermal Bottle, UP MEN Crossbody Pack, Keychain Pill Case, Smart Activity Band and the UP MEN Men's Wellness Guide (Digital — delivered by email)." } },
        { "type": "faq", "settings": { "question": "WHY IS THE 90-DAY PLAN THE BEST VALUE?", "answer": "The 90-day plan includes 3 bottles for $118, the same product cost as 2 monthly bottles at $59 each. Compared with three separate monthly shipments totaling $177, the 90-day subscriber rate saves $59 every 90 days. Welcome gifts are included once with the first shipment and are not repeated on renewals." } },
        { "type": "faq", "settings": { "question": "WHEN WILL MY WELCOME GIFTS ARRIVE?", "answer": "All physical welcome gifts ship with your first order. The digital guide is delivered by email after purchase. Welcome gifts are included once and are not repeated on subscription renewals." } },
        { "type": "faq", "settings": { "question": "HOW DOES THE 90-DAY SUBSCRIPTION RENEW?", "answer": "Your 90-day subscription is charged at the $118 subscriber rate shown at checkout, and it renews at that same rate every 90 days unless you skip, pause or cancel before renewal. Each renewal contains 3 bottles of UP MEN only — welcome gifts are included once with the first shipment." } },
        { "type": "faq", "settings": { "question": "CAN I SKIP, PAUSE OR CANCEL?", "answer": "To change or cancel a future renewal, contact UP MEN support before your next billing date. Changes must be requested before the next order is processed. Review the Subscription Policy for complete terms." } },
        { "type": "faq", "settings": { "question": "HOW DOES THE 90-DAY SATISFACTION GUARANTEE WORK?", "answer": "Your purchase is protected according to the terms of the published 90-day satisfaction guarantee. Review the Refund Policy for eligibility, deadlines, required steps and any conditions before ordering." } },
        { "type": "faq", "settings": { "question": "WHEN WILL MY ORDER SHIP?", "answer": "Shipping estimates and tracking information are shown during checkout and sent by email when available." } },
        { "type": "faq", "settings": { "question": "WHO SHOULD SPEAK WITH A HEALTHCARE PROFESSIONAL BEFORE USE?", "answer": "Consult a qualified healthcare professional before use if you take medication, particularly anticoagulants, have a medical condition, are preparing for surgery or use other supplements containing vitamin D, vitamin K, zinc or boron." } }
      ]
    }
  ]
}
{% endschema %}
