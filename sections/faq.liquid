{%- comment -%} FAQ — accordion over Mars background {%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.bg_image != blank -%}
  {%- assign faq_bg = section.settings.bg_image | image_url: width: 2400 -%}
{%- else -%}
  {%- assign faq_bg = 'faq-bg_65302be7-39e3-444c-9a17-b48d6d01f1f8.jpg' | asset_url -%}
{%- endif -%}
{%- case section.settings.height_mobile -%}
  {%- when 'small' -%}{%- assign minh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign minh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign minh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign minh_mobile = '100svh' -%}
  {%- else -%}{%- assign minh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.height_desktop -%}
  {%- when 'small' -%}{%- assign minh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign minh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign minh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign minh_desktop = '100vh' -%}
  {%- else -%}{%- assign minh_desktop = 'auto' -%}
{%- endcase -%}
<style>
  #mm-faq-{{ sid }} {
    background: #0a0503 url('{{ faq_bg }}') center / cover no-repeat;
    color: var(--text, #fff); padding: 64px 0;
    min-height: {{ minh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
  @media (min-width: 768px) { #mm-faq-{{ sid }} { padding: 96px 0; min-height: {{ minh_desktop }}; } }
  #mm-faq-{{ sid }} .mm-wrap { max-width: 820px; margin: 0 auto; padding: 0 16px; }
  #mm-faq-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(26px, 4.6vw, 42px)) * var(--fs-h, 1)); margin: 0 0 40px;
  }
  #mm-faq-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-faq-{{ sid }} details {
    background: rgba(26,14,7,0.85); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px;
    margin-bottom: 12px; overflow: hidden;
  }
  #mm-faq-{{ sid }} summary {
    cursor: pointer; list-style: none; display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px 20px; font-weight: 700; font-size: calc((15.5px) * var(--fs-b, 1));
  }
  #mm-faq-{{ sid }} summary::-webkit-details-marker { display: none; }
  #mm-faq-{{ sid }} summary::after {
    content: '+'; font-family: var(--font-heading); font-size: calc((20px) * var(--fs-b, 1)); font-weight: 700;
    color: var(--brand, #ff5600); flex-shrink: 0; transition: transform .2s ease;
  }
  #mm-faq-{{ sid }} details[open] summary::after { transform: rotate(45deg); }
  #mm-faq-{{ sid }} .mm-a {
    padding: 0 20px 18px; font-size: calc((14.5px) * var(--fs-b, 1)); line-height: 1.7; color: rgba(255,255,255,0.78);
    font-family: var(--font-body); font-weight: 300; letter-spacing: 0.01em;
  }
</style>

<section id="mm-faq-{{ sid }}" class="reveal" data-testid="faq">
  <a id="faq" aria-hidden="true"></a>
  <div class="mm-wrap">
    <h2>{{ section.settings.title_pre }} <span class="orange">{{ section.settings.title_highlight }}</span></h2>
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
        <summary>{{ block.settings.question }}</summary>
        <div class="mm-a">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "title_pre", "label": "Title", "default": "FREQUENTLY ASKED" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)", "default": "QUESTIONS" },
    { "type": "header", "content": "Banner size" },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (55% of screen)" },
        { "value": "medium", "label": "Medium (70% of screen)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (520px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "bg_image", "label": "Background image" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "textarea", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "faq", "settings": { "question": "What is Up Men and how does it work?", "answer": "Up Men is a natural testosterone support supplement made with 8 clinically dosed ingredients — including Tongkat Ali, Shilajit, Fenugreek, Zinc and Boron — that work together to support your body's own testosterone production, energy, strength and focus." } },
        { "type": "faq", "settings": { "question": "How do I take Up Men?", "answer": "Take the daily serving with water, ideally in the morning with food. Consistency is key — take it every day for at least 90 days for full results." } },
        { "type": "faq", "settings": { "question": "When will I feel the results?", "answer": "Most men start noticing improved energy and workout intensity within the first 7 days. By day 30 you should see visible changes, and by day 90 your T-production is fully optimized. That's why we back it with a 90-day guarantee." } },
        { "type": "faq", "settings": { "question": "Is Up Men a hormone or a steroid?", "answer": "No. Up Men is 100% hormone-free. It doesn't put synthetic testosterone in your body — it supports your body's own natural ability to produce testosterone." } },
        { "type": "faq", "settings": { "question": "Are there any side effects?", "answer": "Up Men is made with natural ingredients at clinically studied doses and is generally well tolerated. If you have a medical condition or take medication, consult your doctor before use." } },
        { "type": "faq", "settings": { "question": "Is it third-party tested?", "answer": "Yes. Every batch is manufactured in a CGMP facility in the USA and third-party tested for purity and potency. Non-GMO, vegan and hormone-free." } },
        { "type": "faq", "settings": { "question": "How does the 90-day guarantee work?", "answer": "Try Up Men for 90 days. If you don't feel a difference, contact our support and we'll refund your purchase — no questions asked." } },
        { "type": "faq", "settings": { "question": "How does the subscription work? Can I cancel?", "answer": "Your Launch Kit ships every 30 days at 50% off the one-time price. You can cancel, skip or pause your subscription anytime through the customer portal — no phone calls, no hassle." } },
        { "type": "faq", "settings": { "question": "How long does shipping take?", "answer": "Orders placed today ship within 24 hours. Delivery typically takes 2–5 business days within the continental USA." } },
        { "type": "faq", "settings": { "question": "Who should use Up Men?", "answer": "Up Men was designed for men 18+ who want to support healthy testosterone levels, energy, strength and drive — whether you're in your 20s and want an edge, or 40+ and want to feel like yourself again." } }
      ]
    }
  ]
}
{% endschema %}
