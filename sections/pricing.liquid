<script>
(function(){
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  root.querySelectorAll('.mm-stepper').forEach(function(st){
    var btns = st.querySelectorAll('button');
    var numEl = st.querySelector('.num');
    var form = st.closest('form');
    if (btns.length < 2 || !numEl) return;
    btns[0].addEventListener('click', function(){
      var n = parseInt(numEl.textContent, 10) || 1; if (n > 1) n--;
      numEl.textContent = n; if (form) form.querySelector('input[name="quantity"]').value = n;
    });
    btns[1].addEventListener('click', function(){
      var n = parseInt(numEl.textContent, 10) || 1; n++;
      numEl.textContent = n; if (form) form.querySelector('input[name="quantity"]').value = n;
    });
  });
  /* Add-to-cart submits are intercepted globally by the cart drawer
     (snippets/cart-drawer.liquid), which adds the item and opens the drawer. */
})();
</script>

