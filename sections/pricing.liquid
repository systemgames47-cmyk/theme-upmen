{%- comment -%} Pricing — UP MEN subscription plans with direct checkout {%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.bg_mobile != blank -%}
  {%- assign pr_bg_mobile = section.settings.bg_mobile | image_url: width: 1200 -%}
{%- else -%}
  {%- assign pr_bg_mobile = 'bg-mobile.jpg' | asset_url -%}
{%- endif -%}
{%- if section.settings.bg_desktop != blank -%}
  {%- assign pr_bg_desktop = section.settings.bg_desktop | image_url: width: 2400 -%}
{%- else -%}
  {%- assign pr_bg_desktop = 'bg-desktop.jpg' | asset_url -%}
{%- endif -%}
<section class="mm-pricing" id="join_pkg" data-section-id="{{ sid }}">
  {%- case section.settings.height_mobile -%}
  {%- when 'small' -%}{%- assign minh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign minh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign minh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign minh_mobile = '100svh' -%}
  {%- else -%}{%- assign minh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.height_desktop -%}
  {%- when 'small' -%}{%- assign minh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign minh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign minh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign minh_desktop = '100vh' -%}
  {%- else -%}{%- assign minh_desktop = 'auto' -%}
{%- endcase -%}
<style>
    #shopify-section-{{ sid }} .mm-pricing {
      background: #0a0503 url('{{ pr_bg_mobile }}') center / cover no-repeat;
      padding: 64px 0; color: #fff;
    min-height: {{ minh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
    @media (min-width: 768px) {
      #shopify-section-{{ sid }} .mm-pricing { background-image: url('{{ pr_bg_desktop }}'); padding: 96px 0; min-height: {{ minh_desktop }}; }
    }
    #shopify-section-{{ sid }} .mm-gifts { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin-bottom: 16px; }
    #shopify-section-{{ sid }} .mm-gifts img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 8px; border: 1px solid rgba(255,255,255,0.12); display: block; }
    /* Empty gift slot. Same box as a real tile so the row keeps its rhythm, but
       obviously a placeholder rather than a product photo. */
    #shopify-section-{{ sid }} .mm-gifts .mm-gift-ph {
      width: 100%; aspect-ratio: 1/1; border-radius: 8px; box-sizing: border-box;
      border: 1px dashed rgba(255,255,255,0.28); background: rgba(255,255,255,0.04);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 3px; padding: 6px; text-align: center;
    }
    #shopify-section-{{ sid }} .mm-gifts .mm-gift-ph .ph-name {
      font-family: var(--font-heading); font-weight: 700; line-height: 1.15;
      font-size: calc((8.5px) * var(--fs-b, 1)); letter-spacing: 0.04em;
      text-transform: uppercase; color: rgba(255,255,255,0.82);
    }
    #shopify-section-{{ sid }} .mm-gifts .mm-gift-ph .ph-note {
      font-size: calc((7.5px) * var(--fs-b, 1)); line-height: 1.1; color: rgba(255,255,255,0.42);
    }
    @media (min-width: 768px) {
      #shopify-section-{{ sid }} .mm-gifts .mm-gift-ph .ph-name { font-size: calc((10px) * var(--fs-b, 1)); }
      #shopify-section-{{ sid }} .mm-gifts .mm-gift-ph .ph-note { font-size: calc((9px) * var(--fs-b, 1)); }
    }
    #shopify-section-{{ sid }} .mm-wrap { max-width: 1024px; margin: 0 auto; padding: 0 16px; }
    #shopify-section-{{ sid }} .mm-head { text-align: center; margin-bottom: 36px; }
    #shopify-section-{{ sid }} .mm-eyebrow {
      display: inline-block; font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700;
      color: #fff; background: var(--brand, #ff5600); padding: 6px 14px; border-radius: 4px;
      text-transform: uppercase; letter-spacing: 0.14em; margin-bottom: 14px;
    }
    #shopify-section-{{ sid }} .mm-title {
      font-family: var(--font-heading); font-size: calc((clamp(26px, 4.6vw, 44px)) * var(--fs-h, 1)); line-height: 1.12;
      font-weight: 800; text-transform: uppercase; margin: 0;
    }
    #shopify-section-{{ sid }} .mm-title strong { color: var(--brand, #ff5600); font-weight: 800; }
    #shopify-section-{{ sid }} .mm-grid { display: grid; grid-template-columns: 1fr; gap: 28px; }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .mm-grid { grid-template-columns: 1fr 1fr; } }
    /* Three packages: wider shell and a 3-up row from desktop. */
    #shopify-section-{{ sid }} .mm-wrap.is-3 { max-width: 1200px; }
    @media (min-width: 1024px) {
      #shopify-section-{{ sid }} .mm-grid.is-3 { grid-template-columns: repeat(3, 1fr); gap: 20px; }
      #shopify-section-{{ sid }} .mm-grid.is-3 .mm-card { padding: 24px 18px; }
    }
    #shopify-section-{{ sid }} .mm-card {
      position: relative; background: #17100b; border-radius: 16px; border: 1px solid rgba(255,255,255,0.14);
      padding: 24px 20px; display: flex; flex-direction: column;
    }
    @media (min-width: 768px) { #shopify-section-{{ sid }} .mm-card { padding: 28px; } }
    #shopify-section-{{ sid }} .mm-card.popular { border: 2px solid var(--brand, #ff5600); box-shadow: 0 16px 48px rgba(255,86,0,0.25); }
    #shopify-section-{{ sid }} .mm-ribbon {
      position: absolute; top: -14px; left: 50%; transform: translateX(-50%);
      background: var(--brand, #ff5600); color: #fff; font-family: var(--font-heading);
      font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em;
      padding: 6px 16px; border-radius: 999px; font-size: calc((11px) * var(--fs-b, 1)); white-space: nowrap;
    }
    #shopify-section-{{ sid }} .mm-card-head { text-align: center; padding: 8px 0 16px; border-bottom: 1px solid rgba(255,255,255,0.12); margin-bottom: 16px; }
    #shopify-section-{{ sid }} .mm-badge { font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700; color: var(--brand, #ff5600); text-transform: uppercase; letter-spacing: 0.14em; margin: 0 0 4px; }
    #shopify-section-{{ sid }} .mm-name { font-family: var(--font-heading); font-size: calc((22px) * var(--fs-h, 1)); font-weight: 800; text-transform: uppercase; margin: 4px 0; }
    #shopify-section-{{ sid }} .mm-sub { font-size: calc((14px) * var(--fs-b, 1)); color: rgba(255,255,255,0.7); font-weight: 600; margin: 0; }
    #shopify-section-{{ sid }} .mm-img { width: 100%; aspect-ratio: 1/1; object-fit: cover; border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: #0a0503; margin-bottom: 16px; display: block; }
    /* ===== Product gallery (swipe + arrows + thumbnails) ===== */
    #shopify-section-{{ sid }} .mm-gal { position: relative; margin-bottom: 16px; }
    #shopify-section-{{ sid }} .mm-gal-track {
      display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-behavior: smooth;
      border-radius: 12px; border: 1px solid rgba(255,255,255,0.1); background: #0a0503;
      scrollbar-width: none; -ms-overflow-style: none; -webkit-overflow-scrolling: touch;
    }
    #shopify-section-{{ sid }} .mm-gal-track::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .mm-gal-track:focus-visible { outline: 2px solid var(--brand, #ff5600); outline-offset: 2px; }
    #shopify-section-{{ sid }} .mm-gal-slide { flex: 0 0 100%; scroll-snap-align: center; }
    #shopify-section-{{ sid }} .mm-gal-slide img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
    #shopify-section-{{ sid }} .mm-gal-nav {
      position: absolute; top: calc(50% - 30px); transform: translateY(-50%);
      width: 34px; height: 34px; border-radius: 50%; cursor: pointer;
      background: rgba(10,5,3,0.72); border: 1px solid rgba(255,255,255,0.28); color: #fff;
      font-size: calc((22px) * var(--fs-b, 1)); line-height: 1; padding: 0 0 3px;
      display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .18s;
    }
    #shopify-section-{{ sid }} .mm-gal-nav.prev { left: 8px; }
    #shopify-section-{{ sid }} .mm-gal-nav.next { right: 8px; }
    #shopify-section-{{ sid }} .mm-gal:hover .mm-gal-nav,
    #shopify-section-{{ sid }} .mm-gal-nav:focus-visible { opacity: 1; }
    @media (hover: none) { #shopify-section-{{ sid }} .mm-gal-nav { opacity: 1; } }
    #shopify-section-{{ sid }} .mm-gal-nav:hover { background: var(--brand, #ff5600); border-color: var(--brand, #ff5600); }
    #shopify-section-{{ sid }} .mm-gal-nav[disabled] { opacity: 0 !important; pointer-events: none; }
    #shopify-section-{{ sid }} .mm-gal-thumbs {
      display: flex; gap: 8px; margin-top: 8px; overflow-x: auto;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    #shopify-section-{{ sid }} .mm-gal-thumbs::-webkit-scrollbar { display: none; }
    #shopify-section-{{ sid }} .mm-gal-thumb {
      flex: 0 0 58px; padding: 0; cursor: pointer; background: none;
      border: 1px solid rgba(255,255,255,0.18); border-radius: 8px; overflow: hidden; opacity: 0.55; transition: opacity .18s, border-color .18s;
    }
    #shopify-section-{{ sid }} .mm-gal-thumb img { width: 100%; aspect-ratio: 1/1; object-fit: cover; display: block; }
    #shopify-section-{{ sid }} .mm-gal-thumb:hover { opacity: 0.85; }
    #shopify-section-{{ sid }} .mm-gal-thumb.is-active { opacity: 1; border-color: var(--brand, #ff5600); }
    @media (prefers-reduced-motion: reduce) { #shopify-section-{{ sid }} .mm-gal-track { scroll-behavior: auto; } }
    #shopify-section-{{ sid }} .mm-addons { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; }
    #shopify-section-{{ sid }} .mm-addon { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: calc((13px) * var(--fs-b, 1)); color: rgba(255,255,255,0.9); }
    #shopify-section-{{ sid }} .mm-addon .left { display: flex; align-items: center; gap: 7px; }
    #shopify-section-{{ sid }} .mm-addon .left .ck { color: var(--brand, #ff5600); font-weight: 800; }
    #shopify-section-{{ sid }} .mm-addon .free { color: #39c46e; font-weight: 700; }
    #shopify-section-{{ sid }} .mm-addon .val { font-weight: 700; }
    #shopify-section-{{ sid }} .mm-addon .val.free { color: #39c46e; text-decoration: line-through; }
    #shopify-section-{{ sid }} .mm-addon .val.save { color: #39c46e; }
    #shopify-section-{{ sid }} .mm-addon .val .was { color: rgba(255,255,255,0.45); font-weight: 400; }
    #shopify-section-{{ sid }} .mm-gifts .mm-lb-trigger { aspect-ratio: 1/1; border-radius: 8px; }
    #shopify-section-{{ sid }} .mm-qty-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.12); border-bottom: 1px solid rgba(255,255,255,0.12); margin-bottom: 14px; }
    #shopify-section-{{ sid }} .mm-qty-label { font-size: calc((13px) * var(--fs-b, 1)); font-weight: 700; }
    #shopify-section-{{ sid }} .mm-stepper { display: inline-flex; align-items: center; gap: 8px; border: 1px solid rgba(255,255,255,0.25); border-radius: 8px; padding: 4px 6px; }
    #shopify-section-{{ sid }} .mm-stepper button { background: none; border: none; cursor: pointer; padding: 4px; color: #fff; font-size: calc((15px) * var(--fs-b, 1)); }
    #shopify-section-{{ sid }} .mm-stepper .num { font-weight: 800; min-width: 18px; text-align: center; }
    #shopify-section-{{ sid }} .mm-price { display: inline-flex; align-items: baseline; gap: 8px; }
    #shopify-section-{{ sid }} .mm-price .old { color: rgba(255,255,255,0.45); text-decoration: line-through; font-size: calc((14px) * var(--fs-b, 1)); }
    #shopify-section-{{ sid }} .mm-price .now { color: var(--brand, #ff5600); font-weight: 900; font-size: calc((24px) * var(--fs-b, 1)); }
    #shopify-section-{{ sid }} .mm-cta {
      background: var(--brand, #ff5600); color: #fff; font-weight: 800; text-transform: uppercase;
      padding: 15px 16px; border: none; border-radius: 8px; font-size: calc((16px) * var(--fs-b, 1)); cursor: pointer; width: 100%;
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; margin-bottom: 12px;
      box-shadow: 0 8px 24px rgba(255,86,0,0.35);
    }
    #shopify-section-{{ sid }} .mm-cta:hover { filter: brightness(1.1); }
    #shopify-section-{{ sid }} .mm-cta:disabled { opacity: 0.6; cursor: not-allowed; }
    #shopify-section-{{ sid }} .mm-perks { list-style: none; padding: 0; margin: 0 0 12px 0; display: flex; flex-direction: column; gap: 6px; }
    #shopify-section-{{ sid }} .mm-perks li { font-size: calc((12.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.8); padding-left: 18px; position: relative; }
    #shopify-section-{{ sid }} .mm-perks li::before { content: '✓'; position: absolute; left: 0; color: #39c46e; font-weight: 900; }
    #shopify-section-{{ sid }} .mm-ship { font-size: calc((12px) * var(--fs-b, 1)); text-align: center; padding: 8px; background: rgba(255,255,255,0.06); border-radius: 8px; }
    #shopify-section-{{ sid }} .mm-warn { font-size: calc((12px) * var(--fs-b, 1)); color: #fecaca; background: rgba(185,28,28,0.25); border: 1px solid rgba(185,28,28,0.5); padding: 10px; border-radius: 8px; margin-bottom: 12px; }
    #shopify-section-{{ sid }} .mm-guar-note { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 28px; font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.7); }

    /* ===== Offer header (tags + countdown + scarcity) ===== */
    #shopify-section-{{ sid }} .mm-offer { text-align: center; margin-bottom: 32px; }
    #shopify-section-{{ sid }} .mm-offer-title { display: flex; align-items: center; justify-content: center; gap: 14px; margin-bottom: 18px; }
    #shopify-section-{{ sid }} .mm-offer-arrow { font-size: calc((26px) * var(--fs-h, 1)); color: var(--brand, #ff5600); line-height: 1; animation: mm-offer-bob 1.4s ease-in-out infinite; }
    @keyframes mm-offer-bob { 0%,100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
    #shopify-section-{{ sid }} .mm-offer-title h2 {
      font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; margin: 0;
      font-size: calc((clamp(26px, 4.6vw, 44px)) * var(--fs-h, 1)); line-height: 1.12;
    }
    #shopify-section-{{ sid }} .mm-offer-row { display: flex; align-items: center; justify-content: center; gap: 10px; margin-bottom: 20px; }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-row { gap: 20px; } }
    #shopify-section-{{ sid }} .mm-offer-tag {
      position: relative; flex: 0 0 auto; width: 82px; height: 82px; border-radius: 50%;
      background: var(--brand, #ff5600); border: 2px dashed rgba(255,255,255,0.7);
      box-shadow: 0 0 0 5px var(--brand, #ff5600), 0 10px 26px rgba(255,86,0,0.45);
      display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center;
      transform: rotate(-8deg);
    }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-tag { width: 118px; height: 118px; } }
    #shopify-section-{{ sid }} .mm-offer-tag.right { transform: rotate(8deg); }
    #shopify-section-{{ sid }} .mm-offer-tag img { position: absolute; inset: -7px; width: calc(100% + 14px); height: calc(100% + 14px); object-fit: contain; }
    #shopify-section-{{ sid }} .mm-offer-tag .t1 { position: relative; z-index: 1; font-size: calc((10px) * var(--fs-b, 1)); font-weight: 400; letter-spacing: 0.14em; color: #fff; text-transform: uppercase; }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-tag .t1 { font-size: calc((14px) * var(--fs-b, 1)); } }
    #shopify-section-{{ sid }} .mm-offer-tag .t2 {
      position: relative; z-index: 1; font-family: var(--font-heading); font-weight: 900; text-transform: uppercase;
      font-size: calc((11px) * var(--fs-b, 1)); line-height: 1.05; color: #ffd44d; padding: 0 8px;
      animation: mm-offer-pulse 1.2s ease-in-out infinite;
    }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-tag .t2 { font-size: calc((16px) * var(--fs-b, 1)); } }
    @keyframes mm-offer-pulse { 0%,100% { transform: scale(1); } 50% { transform: scale(1.12); } }
    #shopify-section-{{ sid }} .mm-offer-timer { display: flex; align-items: stretch; justify-content: center; gap: 4px; }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-timer { gap: 8px; } }
    #shopify-section-{{ sid }} .mm-offer-unit {
      background: #1a0e07; border: 1px solid rgba(255,86,0,0.45); border-radius: 8px;
      padding: 8px 6px; min-width: 52px; text-align: center;
    }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-unit { padding: 14px 10px; min-width: 80px; } }
    #shopify-section-{{ sid }} .mm-offer-unit .num { font-family: var(--font-heading); font-weight: 800; color: #ffd44d; font-size: calc((16px) * var(--fs-b, 1)); }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-unit .num { font-size: calc((22px) * var(--fs-b, 1)); } }
    #shopify-section-{{ sid }} .mm-offer-unit .lbl { font-size: calc((10px) * var(--fs-b, 1)); color: rgba(255,255,255,0.75); text-transform: uppercase; letter-spacing: 0.08em; }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-unit .lbl { font-size: calc((13px) * var(--fs-b, 1)); } }
    /* Stand-in for the timer while no real, fixed end date exists. Same box, same
       footprint, so the offer row keeps its height either way. */
    #shopify-section-{{ sid }} .mm-offer-static {
      background: #1a0e07; border: 1px solid rgba(255,86,0,0.45); border-radius: 8px;
      padding: 8px 14px; min-height: 52px; display: flex; align-items: center; justify-content: center;
      text-align: center; font-family: var(--font-heading); font-weight: 800;
      letter-spacing: 0.1em; text-transform: uppercase; color: #ffd44d;
      font-size: calc((12px) * var(--fs-b, 1)); line-height: 1.25;
    }
    @media (min-width: 640px) {
      #shopify-section-{{ sid }} .mm-offer-static { padding: 14px 22px; min-height: 74px; font-size: calc((16px) * var(--fs-b, 1)); }
    }
    #shopify-section-{{ sid }} .mm-sub-head {
      font-size: calc((15px) * var(--fs-b, 1)); line-height: 1.55; color: rgba(255,255,255,0.75);
      max-width: 620px; margin: 12px auto 0;
    }
    /* "Heading" rows inside a card's ✓ list — used to title the welcome-kit group. */
    #shopify-section-{{ sid }} .mm-addon-heading {
      font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase; color: var(--brand, #ff5600); margin: 5px 0 0;
    }
    #shopify-section-{{ sid }} .mm-price .suffix {
      color: rgba(255,255,255,0.7); font-weight: 700; font-size: calc((12px) * var(--fs-b, 1));
      letter-spacing: 0.08em; text-transform: uppercase;
    }
    #shopify-section-{{ sid }} .mm-offer-scarcity {
      display: inline-block; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.14);
      border-radius: 999px; padding: 7px 16px; margin-top: 20px;
      font-size: calc((12.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.9);
    }
    @media (min-width: 640px) { #shopify-section-{{ sid }} .mm-offer-scarcity { font-size: calc((15px) * var(--fs-b, 1)); } }
    #shopify-section-{{ sid }} .mm-offer-scarcity strong { font-weight: 800; }
    #shopify-section-{{ sid }} .mm-offer-scarcity .u { text-decoration: underline; font-weight: 800; }
    @media (prefers-reduced-motion: reduce) {
      #shopify-section-{{ sid }} .mm-offer-arrow, #shopify-section-{{ sid }} .mm-offer-tag .t2 { animation: none; }
    }
  </style>

  {%- assign show_third = section.settings.third_enabled -%}
  <div class="mm-wrap{% if show_third %} is-3{% endif %}">
    {%- if section.settings.offer_enabled -%}
    <div class="mm-offer">
      {%- if section.settings.offer_title != blank -%}
        <div class="mm-offer-title">
          <span class="mm-offer-arrow" aria-hidden="true">↓</span>
          <h2>{{ section.settings.offer_title }}</h2>
          <span class="mm-offer-arrow" aria-hidden="true">↓</span>
        </div>
      {%- endif -%}
      <div class="mm-offer-row">
        {%- if section.settings.offer_tag_enabled -%}
          <div class="mm-offer-tag">
            {%- if section.settings.offer_tag_image != blank -%}<img src="{{ section.settings.offer_tag_image | image_url: width: 300 }}" alt="" aria-hidden="true">{%- endif -%}
            <span class="t1">{{ section.settings.offer_tag_top }}</span>
            <span class="t2">{{ section.settings.offer_tag_main }}</span>
          </div>
        {%- endif -%}
        {%- comment -%} The countdown only runs against a real, fixed end date. With no date
          set it falls back to a static label that occupies the same space, so the timer can
          never be a per-visitor or self-restarting deadline. {%- endcomment -%}
        {%- if section.settings.countdown_enabled and section.settings.countdown_target != blank -%}
          <div class="mm-offer-timer" data-countdown-block data-target="{{ section.settings.countdown_target }}">
            <div class="mm-offer-unit"><div class="num" data-unit="days">0</div><div class="lbl">{{ section.settings.label_days }}</div></div>
            <div class="mm-offer-unit"><div class="num" data-unit="hours">0</div><div class="lbl">{{ section.settings.label_hours }}</div></div>
            <div class="mm-offer-unit"><div class="num" data-unit="minutes">0</div><div class="lbl">{{ section.settings.label_min }}</div></div>
            <div class="mm-offer-unit"><div class="num" data-unit="seconds">0</div><div class="lbl">{{ section.settings.label_sec }}</div></div>
          </div>
        {%- elsif section.settings.countdown_fallback != blank -%}
          <div class="mm-offer-static">{{ section.settings.countdown_fallback }}</div>
        {%- endif -%}
        {%- if section.settings.offer_tag_enabled -%}
          <div class="mm-offer-tag right">
            {%- if section.settings.offer_tag_image != blank -%}<img src="{{ section.settings.offer_tag_image | image_url: width: 300 }}" alt="" aria-hidden="true">{%- endif -%}
            <span class="t1">{{ section.settings.offer_tag_top }}</span>
            <span class="t2">{{ section.settings.offer_tag_main }}</span>
          </div>
        {%- endif -%}
      </div>
      {%- if section.settings.scarcity_enabled -%}
        <div class="mm-offer-scarcity">
          {%- comment -%} &nbsp; keeps the separating spaces, which the whitespace-stripping
            tags would otherwise swallow. {%- endcomment -%}
          {%- if section.settings.scarcity_icon != blank -%}<span aria-hidden="true">{{ section.settings.scarcity_icon }}</span>&nbsp;{%- endif -%}
          {%- if section.settings.scarcity_show_month -%}<strong>{{ 'now' | date: '%B' }}</strong>&nbsp;{%- endif -%}
          {{- section.settings.scarcity_text_1 -}}
          {%- if section.settings.scarcity_number != blank -%}&nbsp;<span class="u">{{ section.settings.scarcity_number }}</span>{%- endif -%}
          {%- if section.settings.scarcity_text_2 != blank -%}&nbsp;{{ section.settings.scarcity_text_2 }}{%- endif -%}
        </div>
      {%- endif -%}
    </div>
    {%- endif -%}
    <div class="mm-head">
      {%- if section.settings.eyebrow != blank -%}
        <p class="mm-eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="mm-title">{{ section.settings.title | replace: '<p>', '' | replace: '</p>', '' }}</h2>
      {%- if section.settings.subtitle != blank -%}
        <p class="mm-sub-head">{{ section.settings.subtitle }}</p>
      {%- endif -%}
    </div>

    <div class="mm-grid{% if show_third %} is-3{% endif %}">

      {%- comment -%} Package 1: 90-day subscription (popular) {%- endcomment -%}
      {%- assign pk = section.settings.product_kit -%}
      {%- if pk == blank or pk.id == blank -%}{%- assign pk = all_products['up-men-launch-kit'] -%}{%- endif -%}
      {%- if pk == blank or pk.id == blank -%}{%- assign pk = all_products['up-men-subscription'] -%}{%- endif -%}
      {%- if pk == blank or pk.id == blank -%}{%- assign pk = all_products['launch-kit'] -%}{%- endif -%}
      {%- if pk == blank or pk.id == blank -%}{%- assign pk = all_products['up-men'] -%}{%- endif -%}
      {%- if pk == blank or pk.id == blank -%}
        {%- for prod in collections.all.products limit: 250 -%}
          {%- if prod.tags contains 'up-men-launch-kit' or prod.tags contains 'launch-kit' or prod.tags contains 'mm-subscription' -%}
            {%- assign pk = prod -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <div class="mm-card popular">
        {%- if section.settings.kit_ribbon != blank -%}
          <div class="mm-ribbon">{{ section.settings.kit_ribbon }}</div>
        {%- endif -%}
        <div class="mm-card-head">
          <p class="mm-badge">{{ section.settings.kit_badge }}</p>
          <h3 class="mm-name">{{ section.settings.kit_name }}</h3>
          <p class="mm-sub">{{ section.settings.kit_sub }}</p>
        </div>
        {% render 'mm-product-gallery', product: pk, fallback: section.settings.fallback_image, alt: section.settings.kit_name %}
        {%- if section.settings.kit_show_addons -%}
          {%- assign kit_addons = section.blocks | where: 'type', 'kit_addon' -%}
          {%- if kit_addons.size > 0 -%}
            <div class="mm-addons">
              {%- for block in kit_addons -%}{% render 'mm-addon-row', block: block %}{%- endfor -%}
            </div>
          {%- elsif request.design_mode -%}
            <div class="mm-warn">⚙️ Add "Benefit — subscription" blocks to this section to fill the ✓ list.</div>
          {%- endif -%}
        {%- endif -%}
        {%- comment -%} Welcome-gift strip. This lives inside the 90-day card only — the
          monthly card has no gift grid, so nothing here can imply the monthly plan
          includes all four physical gifts.

          The grid renders only once all four slots hold an approved image. The old
          fallback to assets/free-gift-N.png was removed rather than repointed: those
          files showed a competitor-branded e-book, a workout app on a phone and a
          premium smartwatch, none of which match the items actually shipped. Showing
          nothing is correct until real photography lands. {%- endcomment -%}
        <div class="mm-gifts" aria-label="{{ section.settings.gifts_label | escape }}">
          {%- for i in (1..4) -%}
            {%- assign gift_key = 'gift_' | append: i -%}
            {%- assign gift_alt_key = gift_key | append: '_alt' -%}
            {%- assign gift_img = section.settings[gift_key] -%}
            {%- assign gift_alt = section.settings[gift_alt_key] -%}
            {%- assign gift_name = gift_alt | remove: 'Welcome gift: ' -%}
            {%- if gift_img != blank -%}
              <button type="button" class="mm-lb-trigger"
                data-lightbox="gifts-{{ sid }}"
                data-lightbox-src="{{ gift_img | image_url: width: 1600 }}"
                data-lightbox-alt="{{ gift_alt | escape }}"
                aria-label="{{ 'Enlarge: ' | append: gift_alt | escape }}">
                <img src="{{ gift_img | image_url: width: 400 }}" alt="{{ gift_alt | escape }}" loading="lazy">
              </button>
            {%- else -%}
              {%- comment -%} Deliberately reads as a placeholder rather than a product shot,
                so an empty slot never implies an item that does not ship. Upload an image
                to this slot in the theme editor and it replaces this automatically. {%- endcomment -%}
              <div class="mm-gift-ph" role="img" aria-label="{{ gift_name | escape }} — photo coming soon">
                <span class="ph-name">{{ gift_name }}</span>
                <span class="ph-note">Photo coming soon</span>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if request.design_mode -%}
          {%- assign gifts_missing = 0 -%}
          {%- for i in (1..4) -%}
            {%- assign gift_key = 'gift_' | append: i -%}
            {%- if section.settings[gift_key] == blank -%}{%- assign gifts_missing = gifts_missing | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          {%- if gifts_missing > 0 -%}
            <div class="mm-warn">⚙️ {{ gifts_missing }} welcome-gift slot(s) still show a placeholder. Upload the real item photo under "Free gift images" — each slot must match its caption, and the activity band must not show heart rate, blood pressure, ECG or glucose readouts.</div>
          {%- endif -%}
        {%- endif -%}
        {%- if pk != blank and pk.id != blank and pk.available -%}
          {%- assign vk = pk.selected_or_first_available_variant -%}
          {%- assign vk_id = section.settings.variant_id_kit -%}
          {%- if vk_id == blank -%}{%- assign vk_id = vk.id -%}{%- endif -%}
          {%- assign spk = section.settings.selling_plan_kit -%}
          {%- if spk == blank and pk.selling_plan_groups.size > 0 -%}
            {%- assign spk = pk.selling_plan_groups.first.selling_plans.first.id -%}
          {%- endif -%}
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="return_to" value="/checkout">
            <input type="hidden" name="id" value="{{ vk_id }}">
            {%- if spk != blank -%}
              <input type="hidden" name="selling_plan" value="{{ spk }}">
            {%- endif -%}
            <input type="hidden" name="quantity" value="1">
            <div class="mm-qty-row">
              <span class="mm-qty-label">{{ section.settings.qty_label }}</span>
              <div class="mm-stepper">
                <button type="button" aria-label="Decrease">−</button>
                <span class="num">1</span>
                <button type="button" aria-label="Increase">+</button>
              </div>
              {% render 'mm-plan-price', variant: vk, selling_plan_id: spk, suffix: section.settings.price_suffix %}
            </div>
            <button type="submit" class="mm-cta">{{ section.settings.kit_cta_label }}</button>
          </form>
        {%- else -%}
          {%- comment -%} No product connected: show the editable placeholder price and a
            disabled button. The setup note is merchant-only. {%- endcomment -%}
          {%- if request.design_mode -%}
            <div class="mm-warn">⚙️ Select a product in the theme editor (Packages section → "Product") OR create a Shopify product with handle <code>up-men-launch-kit</code> (or <code>up-men</code>). Until then the prices below are the placeholders from "Placeholder price" and the button stays disabled.</div>
          {%- endif -%}
          <div class="mm-qty-row">
            <span class="mm-qty-label">{{ section.settings.qty_label }}</span>
            <div class="mm-stepper"><button type="button" disabled>−</button><span class="num">1</span><button type="button" disabled>+</button></div>
            <div class="mm-price">
              {%- if section.settings.kit_price_compare != blank -%}<span class="old">{{ section.settings.kit_price_compare }}</span>{%- endif -%}
              <span class="now">{{ section.settings.kit_price }}</span>
            </div>
          </div>
          <button type="button" class="mm-cta" disabled>{{ section.settings.kit_cta_label }}</button>
        {%- endif -%}
        {%- if section.settings.kit_show_perks -%}
          {%- assign kit_perk_blocks = section.blocks | where: 'type', 'kit_perk' -%}
          {%- if kit_perk_blocks.size > 0 -%}
            <ul class="mm-perks">
              {%- for block in kit_perk_blocks -%}
                {%- if block.settings.text != blank -%}
                  <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            {%- comment -%} Fallback: the "one per line" textarea, used when no
              "Perk — subscription card" blocks exist. {%- endcomment -%}
            {%- assign kit_perks = section.settings.kit_perks | strip | newline_to_br | split: '<br />' -%}
            {%- if kit_perks.size > 0 -%}
              <ul class="mm-perks">
                {%- for perk in kit_perks -%}
                  {%- assign perk_t = perk | strip -%}
                  {%- if perk_t != blank -%}<li>{{ perk_t }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.ship_strong != blank or section.settings.ship_rest != blank -%}
          <div class="mm-ship">{% if section.settings.ship_strong != blank %}<strong>{{ section.settings.ship_strong }}</strong> {% endif %}{{ section.settings.ship_rest }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} Package 2: Try once {%- endcomment -%}
      {%- assign p1 = section.settings.product_once -%}
      {%- if p1 == blank or p1.id == blank -%}{%- assign p1 = all_products['up-men-try-once'] -%}{%- endif -%}
      {%- if p1 == blank or p1.id == blank -%}{%- assign p1 = all_products['up-men-one-time'] -%}{%- endif -%}
      {%- if p1 == blank or p1.id == blank -%}{%- assign p1 = all_products['try-once'] -%}{%- endif -%}
      {%- if p1 == blank or p1.id == blank -%}{%- assign p1 = all_products['up-men'] -%}{%- endif -%}
      {%- if p1 == blank or p1.id == blank -%}
        {%- for prod in collections.all.products limit: 250 -%}
          {%- if prod.tags contains 'up-men-try-once' or prod.tags contains 'try-once' or prod.tags contains 'mm-one-time' -%}
            {%- assign p1 = prod -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      <div class="mm-card">
        <div class="mm-card-head">
          <p class="mm-badge">{{ section.settings.once_badge }}</p>
          <h3 class="mm-name">{{ section.settings.once_name }}</h3>
          <p class="mm-sub">{{ section.settings.once_sub }}</p>
        </div>
        {% render 'mm-product-gallery', product: p1, fallback: section.settings.fallback_image, alt: section.settings.once_name %}
        {%- if section.settings.once_show_addons -%}
          {%- assign once_addons = section.blocks | where: 'type', 'once_addon' -%}
          {%- if once_addons.size > 0 -%}
            <div class="mm-addons">
              {%- for block in once_addons -%}{% render 'mm-addon-row', block: block %}{%- endfor -%}
            </div>
          {%- elsif request.design_mode -%}
            <div class="mm-warn">⚙️ Add "Benefit — monthly card" blocks to this section to fill the ✓ list.</div>
          {%- endif -%}
        {%- endif -%}
        {%- if p1 != blank and p1.id != blank and p1.available -%}
          {%- assign v1 = p1.selected_or_first_available_variant -%}
          {%- assign v1_id = section.settings.variant_id_once -%}
          {%- if v1_id == blank -%}{%- assign v1_id = v1.id -%}{%- endif -%}
          {%- comment -%} Same rule as the subscription card: attach the selling plan whenever
            the product has one. Gating this on requires_selling_plan silently turned the
            monthly card into a one-time purchase while the copy promised a renewal. {%- endcomment -%}
          {%- assign sp1 = section.settings.selling_plan_once -%}
          {%- if sp1 == blank and p1.selling_plan_groups.size > 0 -%}
            {%- assign sp1 = p1.selling_plan_groups.first.selling_plans.first.id -%}
          {%- endif -%}
          <form action="{{ routes.cart_add_url }}" method="post">
            <input type="hidden" name="return_to" value="/checkout">
            <input type="hidden" name="id" value="{{ v1_id }}">
            {%- if sp1 != blank -%}
              <input type="hidden" name="selling_plan" value="{{ sp1 }}">
            {%- endif -%}
            <input type="hidden" name="quantity" value="1">
            <div class="mm-qty-row">
              <span class="mm-qty-label">{{ section.settings.qty_label }}</span>
              <div class="mm-stepper">
                <button type="button" aria-label="Decrease">−</button>
                <span class="num">1</span>
                <button type="button" aria-label="Increase">+</button>
              </div>
              {% render 'mm-plan-price', variant: v1, selling_plan_id: sp1, suffix: section.settings.price_suffix %}
            </div>
            <button type="submit" class="mm-cta">{{ section.settings.once_cta_label }}</button>
          </form>
        {%- else -%}
          {%- if request.design_mode -%}
            <div class="mm-warn">⚙️ Select a product in the theme editor (Packages section → "Product") OR create a Shopify product with handle <code>up-men-try-once</code> (or <code>up-men</code>). Until then the prices below are the placeholders from "Placeholder price" and the button stays disabled.</div>
          {%- endif -%}
          <div class="mm-qty-row">
            <span class="mm-qty-label">{{ section.settings.qty_label }}</span>
            <div class="mm-stepper"><button type="button" disabled>−</button><span class="num">1</span><button type="button" disabled>+</button></div>
            <div class="mm-price">
              {%- if section.settings.once_price_compare != blank -%}<span class="old">{{ section.settings.once_price_compare }}</span>{%- endif -%}
              <span class="now">{{ section.settings.once_price }}</span>
            </div>
          </div>
          <button type="button" class="mm-cta" disabled>{{ section.settings.once_cta_label }}</button>
        {%- endif -%}
        {%- if section.settings.once_show_perks -%}
          {%- assign once_perk_blocks = section.blocks | where: 'type', 'once_perk' -%}
          {%- if once_perk_blocks.size > 0 -%}
            <ul class="mm-perks">
              {%- for block in once_perk_blocks -%}
                {%- if block.settings.text != blank -%}
                  <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          {%- else -%}
            {%- comment -%} Fallback: the "one per line" textarea, used when no
              "Perk — monthly card" blocks exist. {%- endcomment -%}
            {%- assign once_perks = section.settings.once_perks | strip | newline_to_br | split: '<br />' -%}
            {%- if once_perks.size > 0 -%}
              <ul class="mm-perks">
                {%- for perk in once_perks -%}
                  {%- assign perk_t = perk | strip -%}
                  {%- if perk_t != blank -%}<li>{{ perk_t }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- if section.settings.ship_strong != blank or section.settings.ship_rest != blank -%}
          <div class="mm-ship">{% if section.settings.ship_strong != blank %}<strong>{{ section.settings.ship_strong }}</strong> {% endif %}{{ section.settings.ship_rest }}</div>
        {%- endif -%}
      </div>

      {%- comment -%} Package 3: optional extra bundle {%- endcomment -%}
      {%- if show_third -%}
        {%- assign p3 = section.settings.product_third -%}
        {%- if p3 == blank or p3.id == blank -%}{%- assign p3 = all_products['up-men-6-month'] -%}{%- endif -%}
        {%- if p3 == blank or p3.id == blank -%}{%- assign p3 = all_products['up-men-bundle'] -%}{%- endif -%}
        {%- if p3 == blank or p3.id == blank -%}{%- assign p3 = all_products['up-men'] -%}{%- endif -%}
        {%- if p3 == blank or p3.id == blank -%}
          {%- for prod in collections.all.products limit: 250 -%}
            {%- if prod.tags contains 'up-men-6-month' or prod.tags contains 'up-men-bundle' -%}
              {%- assign p3 = prod -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
        <div class="mm-card{% if section.settings.third_highlight %} popular{% endif %}">
          {%- if section.settings.third_ribbon != blank -%}
            <div class="mm-ribbon">{{ section.settings.third_ribbon }}</div>
          {%- endif -%}
          <div class="mm-card-head">
            <p class="mm-badge">{{ section.settings.third_badge }}</p>
            <h3 class="mm-name">{{ section.settings.third_name }}</h3>
            <p class="mm-sub">{{ section.settings.third_sub }}</p>
          </div>
          {% render 'mm-product-gallery', product: p3, fallback: section.settings.fallback_image, alt: section.settings.third_name %}
          {%- if section.settings.third_show_addons -%}
            {%- assign third_addons = section.blocks | where: 'type', 'third_addon' -%}
            {%- if third_addons.size > 0 -%}
              <div class="mm-addons">
                {%- for block in third_addons -%}{% render 'mm-addon-row', block: block %}{%- endfor -%}
              </div>
            {%- elsif request.design_mode -%}
              <div class="mm-warn">⚙️ Add "Benefit — third card" blocks to this section to fill the ✓ list.</div>
            {%- endif -%}
          {%- endif -%}
          {%- if p3 != blank and p3.id != blank and p3.available -%}
            {%- assign v3 = p3.selected_or_first_available_variant -%}
            {%- assign v3_id = section.settings.variant_id_third -%}
            {%- if v3_id == blank -%}{%- assign v3_id = v3.id -%}{%- endif -%}
            {%- assign sp3 = section.settings.selling_plan_third -%}
            {%- if sp3 == blank and p3.selling_plan_groups.size > 0 -%}
              {%- assign sp3 = p3.selling_plan_groups.first.selling_plans.first.id -%}
            {%- endif -%}
            <form action="{{ routes.cart_add_url }}" method="post">
              <input type="hidden" name="return_to" value="/checkout">
              <input type="hidden" name="id" value="{{ v3_id }}">
              {%- if sp3 != blank -%}
                <input type="hidden" name="selling_plan" value="{{ sp3 }}">
              {%- endif -%}
              <input type="hidden" name="quantity" value="1">
              <div class="mm-qty-row">
                <span class="mm-qty-label">{{ section.settings.qty_label }}</span>
                <div class="mm-stepper">
                  <button type="button" aria-label="Decrease">−</button>
                  <span class="num">1</span>
                  <button type="button" aria-label="Increase">+</button>
                </div>
                {% render 'mm-plan-price', variant: v3, selling_plan_id: sp3, suffix: section.settings.price_suffix %}
              </div>
              <button type="submit" class="mm-cta">{{ section.settings.third_cta_label }}</button>
            </form>
          {%- else -%}
            {%- if request.design_mode -%}
              <div class="mm-warn">⚙️ Select a product in the theme editor (Packages section → "Product") OR create a Shopify product with handle <code>up-men-6-month</code> (or <code>up-men</code>). Until then the prices below are the placeholders from "Placeholder price" and the button stays disabled.</div>
            {%- endif -%}
            <div class="mm-qty-row">
              <span class="mm-qty-label">{{ section.settings.qty_label }}</span>
              <div class="mm-stepper"><button type="button" disabled>−</button><span class="num">1</span><button type="button" disabled>+</button></div>
              <div class="mm-price">
                {%- if section.settings.third_price_compare != blank -%}<span class="old">{{ section.settings.third_price_compare }}</span>{%- endif -%}
                <span class="now">{{ section.settings.third_price }}</span>
              </div>
            </div>
            <button type="button" class="mm-cta" disabled>{{ section.settings.third_cta_label }}</button>
          {%- endif -%}
          {%- if section.settings.third_show_perks -%}
            {%- assign third_perk_blocks = section.blocks | where: 'type', 'third_perk' -%}
            {%- if third_perk_blocks.size > 0 -%}
              <ul class="mm-perks">
                {%- for block in third_perk_blocks -%}
                  {%- if block.settings.text != blank -%}
                    <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- else -%}
              {%- comment -%} Fallback: the "one per line" textarea, used when no
                "Perk — third card" blocks exist. {%- endcomment -%}
              {%- assign third_perks = section.settings.third_perks | strip | newline_to_br | split: '<br />' -%}
              {%- if third_perks.size > 0 -%}
                <ul class="mm-perks">
                  {%- for perk in third_perks -%}
                    {%- assign perk_t = perk | strip -%}
                    {%- if perk_t != blank -%}<li>{{ perk_t }}</li>{%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}
            {%- endif -%}
          {%- endif -%}
          {%- if section.settings.ship_strong != blank or section.settings.ship_rest != blank -%}
            <div class="mm-ship">{% if section.settings.ship_strong != blank %}<strong>{{ section.settings.ship_strong }}</strong> {% endif %}{{ section.settings.ship_rest }}</div>
          {%- endif -%}
        </div>
      {%- endif -%}

    </div>

    <p class="mm-guar-note">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
      {{ section.settings.guarantee_note }}
    </p>
  </div>
</section>

<script>
(function(){
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  root.querySelectorAll('.mm-stepper').forEach(function(st){
    var btns = st.querySelectorAll('button');
    var numEl = st.querySelector('.num');
    var form = st.closest('form');
    if (btns.length < 2 || !numEl) return;
    btns[0].addEventListener('click', function(){
      var n = parseInt(numEl.textContent, 10) || 1; if (n > 1) n--;
      numEl.textContent = n; if (form) form.querySelector('input[name="quantity"]').value = n;
    });
    btns[1].addEventListener('click', function(){
      var n = parseInt(numEl.textContent, 10) || 1; n++;
      numEl.textContent = n; if (form) form.querySelector('input[name="quantity"]').value = n;
    });
  });
  /* Product galleries: horizontal drag comes free from overflow-x, so this only
     wires the arrows, the thumbnails, and keeping the active thumb in sync. */
  root.querySelectorAll('[data-mm-gal]').forEach(function(gal){
    var track = gal.querySelector('[data-mm-gal-track]');
    if (!track) return;
    var slides = track.querySelectorAll('.mm-gal-slide');
    if (slides.length < 2) return;
    var prev = gal.querySelector('[data-mm-gal-prev]');
    var next = gal.querySelector('[data-mm-gal-next]');
    var thumbs = gal.querySelectorAll('[data-mm-gal-thumb]');

    function current(){
      var w = track.clientWidth;
      return w ? Math.round(track.scrollLeft / w) : 0;
    }
    function goTo(i){
      var max = slides.length - 1;
      if (i < 0) i = 0; if (i > max) i = max;
      track.scrollTo({ left: i * track.clientWidth, behavior: 'smooth' });
    }
    function sync(){
      var i = current();
      thumbs.forEach(function(t, n){ t.classList.toggle('is-active', n === i); });
      if (prev) prev.disabled = i <= 0;
      if (next) next.disabled = i >= slides.length - 1;
    }

    if (prev) prev.addEventListener('click', function(){ goTo(current() - 1); });
    if (next) next.addEventListener('click', function(){ goTo(current() + 1); });
    thumbs.forEach(function(t, n){
      t.addEventListener('click', function(){ goTo(n); });
    });
    track.addEventListener('keydown', function(e){
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current() + 1); }
      if (e.key === 'ArrowLeft')  { e.preventDefault(); goTo(current() - 1); }
    });

    var raf;
    track.addEventListener('scroll', function(){
      if (raf) cancelAnimationFrame(raf);
      raf = requestAnimationFrame(sync);
    }, { passive: true });
    window.addEventListener('resize', sync);
    sync();
  });

  /* Add-to-cart submits are intercepted globally by the cart drawer
     (snippets/cart-drawer.liquid), which adds the item and opens the drawer. */
})();
</script>

