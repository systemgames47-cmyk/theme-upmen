{%- liquid
  assign sz = section.settings.box_size
  case sz
    when 'small'
      assign box_max = '480px'
    when 'medium'
      assign box_max = '620px'
    when 'large'
      assign box_max = '760px'
    else
      assign box_max = '900px'
  endcase
  assign szm = section.settings.box_size_mobile
  case szm
    when 'small'
      assign box_max_m = '280px'
    when 'medium'
      assign box_max_m = '340px'
    when 'large'
      assign box_max_m = '420px'
    else
      assign box_max_m = '100%'
  endcase
-%}
<section class="mm-label" id="product_label">
  <div class="mm-label-inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="mm-label-title reveal">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="mm-label-box reveal">
      {%- if section.settings.use_text != blank -%}
        <p class="mm-label-use">{{ section.settings.use_text }}</p>
      {%- endif -%}
      <div class="mm-label-frame">
        {%- if section.settings.label_image != blank -%}
          <img src="{{ section.settings.label_image | image_url: width: 1400 }}" alt="{{ section.settings.heading | default: 'Supplement Facts' }}" loading="lazy">
        {%- else -%}
          <img src="{{ 'upmen-label.jpg' | asset_url }}" alt="{{ section.settings.heading | default: 'Supplement Facts' }}" loading="lazy">
        {%- endif -%}
      </div>
      {%- if section.settings.disclaimer != blank -%}
        <p class="mm-label-disclaimer">{{ section.settings.disclaimer }}</p>
      {%- endif -%}
    </div>
    {%- if section.blocks.size > 0 -%}
      <div class="mm-label-badges">
        {%- for block in section.blocks -%}
          {%- liquid
            assign isz = block.settings.icon_size
            case isz
              when 'small'
                assign ico_d = '52px'
                assign ico_m = '44px'
                assign fz_d = '22px'
                assign fz_m = '18px'
              when 'large'
                assign ico_d = '84px'
                assign ico_m = '66px'
                assign fz_d = '38px'
                assign fz_m = '28px'
              when 'xl'
                assign ico_d = '110px'
                assign ico_m = '84px'
                assign fz_d = '50px'
                assign fz_m = '36px'
              else
                assign ico_d = '64px'
                assign ico_m = '52px'
                assign fz_d = '28px'
                assign fz_m = '22px'
            endcase
          -%}
          <div class="mm-label-badge reveal" {{ block.shopify_attributes }} style="--ico-d:{{ ico_d }};--ico-m:{{ ico_m }};--ico-fz-d:{{ fz_d }};--ico-fz-m:{{ fz_m }};">
            {%- if block.settings.icon_image != blank -%}
              <span class="ico has-img"><img src="{{ block.settings.icon_image | image_url: width: 300 }}" alt="{{ block.settings.text }}" loading="lazy"></span>
            {%- else -%}
              <span class="ico">{{ block.settings.icon }}</span>
            {%- endif -%}
            <span class="txt">{{ block.settings.text }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  .mm-label{background:#0a0503;padding:64px 20px;}
  .mm-label-inner{max-width:1080px;margin:0 auto;text-align:center;}
  .mm-label-title{font-family:var(--font-heading),sans-serif;font-weight:900;font-size:clamp(26px,4.5vw,44px);line-height:1.08;color:#fff;text-transform:uppercase;margin:0 0 32px;}
  .mm-label-title em,.mm-label-title strong{color:#ff5600;font-style:normal;}
  .mm-label-box{background:linear-gradient(180deg,#160b04 0%,#0f0702 100%);border:1px solid rgba(255,86,0,.35);border-radius:20px;padding:26px;max-width:{{ box_max }};margin:0 auto;box-shadow:0 0 60px rgba(255,86,0,.12);}
  .mm-label-use{font-weight:800;color:#ffd44d;text-transform:uppercase;letter-spacing:.04em;font-size:15px;margin:0 0 18px;}
  .mm-label-frame{background:#fff;border:3px solid #000;border-radius:10px;overflow:hidden;}
  .mm-label-frame img{display:block;width:100%;height:auto;}
  .mm-label-disclaimer{margin:16px 0 0;font-size:12px;line-height:1.5;color:rgba(255,255,255,.55);}
  .mm-label-badges{display:flex;justify-content:center;gap:34px;flex-wrap:wrap;margin-top:38px;}
  .mm-label-badge{display:flex;flex-direction:column;align-items:center;gap:10px;max-width:150px;}
  .mm-label-badge .ico{width:var(--ico-d,64px);height:var(--ico-d,64px);border-radius:50%;background:rgba(255,86,0,.12);border:2px solid #ff5600;display:flex;align-items:center;justify-content:center;font-size:var(--ico-fz-d,28px);overflow:hidden;}
  .mm-label-badge .ico.has-img img{width:70%;height:70%;object-fit:contain;display:block;}
  .mm-label-badge .txt{font-weight:800;color:#fff;font-size:14px;line-height:1.3;text-transform:uppercase;}
  @media(max-width:768px){
    .mm-label{padding:48px 16px;}
    .mm-label-box{max-width:{{ box_max_m }};padding:18px;}
    .mm-label-badges{gap:22px;}
    .mm-label-badge .ico{width:var(--ico-m,52px);height:var(--ico-m,52px);font-size:var(--ico-fz-m,22px);}
  }
</style>

{% schema %}
{
  "name": "Product Label",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Here's What's Inside Every Capsule"
    },
    {
      "type": "text",
      "id": "use_text",
      "label": "Suggested use text (optional)",
      "default": "Suggested use: take 5 capsules daily with food."
    },
    {
      "type": "image_picker",
      "id": "label_image",
      "label": "Label image (Supplement Facts)",
      "info": "If empty, the default Up Men label is shown."
    },
    {
      "type": "select",
      "id": "box_size",
      "label": "Label box size (desktop)",
      "options": [
        { "value": "small", "label": "Small (480px)" },
        { "value": "medium", "label": "Medium (620px)" },
        { "value": "large", "label": "Large (760px)" },
        { "value": "xl", "label": "Extra large (900px)" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "box_size_mobile",
      "label": "Label box size (mobile)",
      "options": [
        { "value": "small", "label": "Small (280px)" },
        { "value": "medium", "label": "Medium (340px)" },
        { "value": "large", "label": "Large (420px)" },
        { "value": "xl", "label": "Full width" }
      ],
      "default": "xl"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Disclaimer (optional)",
      "default": "* These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon (emoji)", "default": "🇺🇸", "info": "Used only when no image is uploaded below." },
        {
          "type": "image_picker",
          "id": "icon_image",
          "label": "Icon image (optional)",
          "info": "Replaces the emoji when uploaded."
        },
        {
          "type": "select",
          "id": "icon_size",
          "label": "Icon size",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" },
            { "value": "xl", "label": "Extra large" }
          ],
          "default": "medium"
        },
        { "type": "text", "id": "text", "label": "Text", "default": "Made in USA" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Label",
      "blocks": [
        { "type": "badge", "settings": { "icon": "🇺🇸", "text": "Made in USA" } },
        { "type": "badge", "settings": { "icon": "🧪", "text": "Third Party Tested" } },
        { "type": "badge", "settings": { "icon": "🚫", "text": "Non-GMO" } }
      ]
    }
  ]
}
{% endschema %}
