{%- comment -%} Footer — dark Mars footer with slogan, menus and disclaimer {%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.bg_mobile != blank -%}
  {%- assign ft_bg_mobile = section.settings.bg_mobile | image_url: width: 1200 -%}
{%- else -%}
  {%- assign ft_bg_mobile = 'Mobile-Footer_1.webp' | asset_url -%}
{%- endif -%}
{%- if section.settings.bg_desktop != blank -%}
  {%- assign ft_bg_desktop = section.settings.bg_desktop | image_url: width: 2400 -%}
{%- else -%}
  {%- assign ft_bg_desktop = 'Footer_1.webp' | asset_url -%}
{%- endif -%}
{%- case section.settings.height_mobile -%}
  {%- when 'small' -%}{%- assign minh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign minh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign minh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign minh_mobile = '100svh' -%}
  {%- else -%}{%- assign minh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.height_desktop -%}
  {%- when 'small' -%}{%- assign minh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign minh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign minh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign minh_desktop = '100vh' -%}
  {%- else -%}{%- assign minh_desktop = 'auto' -%}
{%- endcase -%}
<style>
  #mm-footer-{{ sid }} {
    background: #000 url('{{ ft_bg_mobile }}') center bottom / cover no-repeat;
    color: var(--text, #fff); padding: 72px 0 40px; position: relative;
    min-height: {{ minh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
  @media (min-width: 768px) {
    #mm-footer-{{ sid }} { background-image: url('{{ ft_bg_desktop }}'); min-height: {{ minh_desktop }}; }
  }
  #mm-footer-{{ sid }}::after { content: ''; position: absolute; inset: 0; background: rgba(0,0,0,0.55); pointer-events: none; }
  #mm-footer-{{ sid }} .mm-wrap { position: relative; z-index: 1; max-width: 1100px; margin: 0 auto; padding: 0 16px; }
  #mm-footer-{{ sid }} .mm-slogan {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(22px, 4vw, 38px)) * var(--fs-b, 1)); line-height: 1.2; margin: 0 0 12px; letter-spacing: 0.04em;
  }
  #mm-footer-{{ sid }} .mm-slogan .orange { color: var(--brand, #ff5600); }
  #mm-footer-{{ sid }} .mm-tag { text-align: center; font-size: calc((14px) * var(--fs-b, 1)); color: rgba(255,255,255,0.7); margin: 0 0 36px; }
  #mm-footer-{{ sid }} .mm-cta-row { text-align: center; margin-bottom: 48px; }
  #mm-footer-{{ sid }} .mm-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--brand, #ff5600); color: #fff; text-decoration: none;
    font-weight: 800; font-size: calc((16px) * var(--fs-b, 1)); text-transform: uppercase;
    padding: 16px 40px; border-radius: 6px; box-shadow: 0 8px 28px rgba(255,86,0,0.4);
  }
  #mm-footer-{{ sid }} .mm-cta:hover { filter: brightness(1.1); }
  #mm-footer-{{ sid }} .mm-cols {
    display: grid; grid-template-columns: 1fr; gap: 28px; text-align: center;
    padding-top: 36px; border-top: 1px solid rgba(255,255,255,0.15); margin-bottom: 36px;
  }
  @media (min-width: 600px) { #mm-footer-{{ sid }} .mm-cols { grid-template-columns: 1fr 1fr; text-align: left; } }
  @media (min-width: 900px) { #mm-footer-{{ sid }} .mm-cols { grid-template-columns: repeat(3, 1fr); } }
  @media (min-width: 1024px) { #mm-footer-{{ sid }} .mm-cols.cols-5 { grid-template-columns: repeat(5, 1fr); gap: 20px; } }
  @media (min-width: 1024px) { #mm-footer-{{ sid }} .mm-cols.cols-6 { grid-template-columns: repeat(6, 1fr); gap: 18px; } }
  #mm-footer-{{ sid }} .mm-col h3 {
    font-family: var(--font-heading); font-size: calc((12px) * var(--fs-h, 1)); font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--brand, #ff5600); margin: 0 0 14px;
  }
  #mm-footer-{{ sid }} .mm-col a, #mm-footer-{{ sid }} .mm-col span {
    display: block; color: rgba(255,255,255,0.8); text-decoration: none; font-size: calc((14px) * var(--fs-b, 1)); margin-bottom: 8px;
  }
  #mm-footer-{{ sid }} .mm-col a:hover { color: #fff; }
  #mm-footer-{{ sid }} .mm-social { display: flex; gap: 14px; justify-content: center; }
  @media (min-width: 768px) { #mm-footer-{{ sid }} .mm-social { justify-content: flex-start; } }
  #mm-footer-{{ sid }} .mm-social a {
    display: inline-flex; width: 38px; height: 38px; border: 1px solid rgba(255,255,255,0.3); border-radius: 50%;
    align-items: center; justify-content: center; color: #fff;
  }
  #mm-footer-{{ sid }} .mm-social a:hover { border-color: var(--brand, #ff5600); color: var(--brand, #ff5600); }
  #mm-footer-{{ sid }} .mm-legal {
    border-top: 1px solid rgba(255,255,255,0.15); padding-top: 24px;
    font-size: calc((11.5px) * var(--fs-b, 1)); line-height: 1.6; color: rgba(255,255,255,0.55); text-align: center;
  }
  #mm-footer-{{ sid }} .mm-legal p { margin: 0 0 10px; }
</style>

<footer id="mm-footer-{{ sid }}" role="contentinfo">
  <div class="mm-wrap">
    <h2 class="mm-slogan">{{ section.settings.slogan_pre }} <span class="orange">{{ section.settings.slogan_highlight }}</span></h2>
    <p class="mm-tag">{{ section.settings.tagline }}</p>
    <div class="mm-cta-row">
      <a href="{{ section.settings.cta_link | default: '#join_pkg' }}" class="mm-cta">{{ section.settings.cta_label }}</a>
    </div>

    {%- comment -%}
      Five link columns — shop, about, learn, support, legal — plus the social
      column. Each one is driven by its own block type, so the whole footer map
      is editable from the theme editor.
    {%- endcomment -%}
    {%- assign social_links = section.blocks | where: 'type', 'social_link' -%}
    {%- assign col_keys = 'shop,about,learn,support,legal' | split: ',' -%}
    <div class="mm-cols cols-6">
      {%- for key in col_keys -%}
        {%- assign title_key = key | append: '_title' -%}
        {%- assign block_type = key | append: '_link' -%}
        {%- assign col_title = section.settings[title_key] -%}
        {%- assign col_links = section.blocks | where: 'type', block_type -%}
        {%- comment -%} The original "Footer link — Explore" blocks live on under About. {%- endcomment -%}
        {%- if key == 'about' -%}
          {%- assign legacy_links = section.blocks | where: 'type', 'explore_link' -%}
        {%- else -%}
          {%- assign legacy_links = empty -%}
        {%- endif -%}
        {%- assign is_support = false -%}
        {%- if key == 'support' -%}{%- assign is_support = true -%}{%- endif -%}
        {%- if col_title != blank -%}
          <div class="mm-col">
            <h3>{{ col_title }}</h3>
            {%- if is_support -%}
              {%- assign email = section.settings.support_email | default: settings.contact_email -%}
              {%- if email != blank -%}
                <a href="mailto:{{ email }}">{{ section.settings.support_email_label | default: email }}</a>
              {%- endif -%}
            {%- endif -%}
            {%- for block in col_links -%}
              {%- if block.settings.label != blank -%}
                <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
              {%- endif -%}
            {%- endfor -%}
            {%- if legacy_links != empty -%}
              {%- for block in legacy_links -%}
                {%- if block.settings.label != blank -%}
                  <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
                {%- endif -%}
              {%- endfor -%}
            {%- endif -%}
            {%- if is_support and section.settings.support_menu != blank -%}
              {%- for link in section.settings.support_menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- endif -%}
            {%- if key == 'about' and col_links.size == 0 and section.settings.menu != blank -%}
              {%- comment -%} Fallback: a Shopify navigation menu, edited under Online Store → Navigation. {%- endcomment -%}
              {%- for link in section.settings.menu.links -%}
                <a href="{{ link.url }}">{{ link.title }}</a>
              {%- endfor -%}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
      {%- if section.settings.social_title != blank -%}
        <div class="mm-col">
          <h3>{{ section.settings.social_title }}</h3>
          {%- if social_links.size > 0 -%}
            <div class="mm-social">
              {%- for block in social_links -%}
                {%- if block.settings.url != blank -%}
                  {%- assign social_label = block.settings.label -%}
                  {%- if social_label == blank -%}{%- assign social_label = block.settings.network | capitalize -%}{%- endif -%}
                  <a href="{{ block.settings.url }}" aria-label="{{ social_label | escape }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{% render 'mm-social-icon', network: block.settings.network %}</a>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- elsif request.design_mode -%}
            <span>⚙️ Add "Social icon" blocks to this section.</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="mm-legal">
      <p>{{ section.settings.disclaimer }}</p>
      <p>© {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "header", "content": "Banner size" },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (55% of screen)" },
        { "value": "medium", "label": "Medium (70% of screen)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (520px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "bg_mobile", "label": "Background (mobile)" },
    { "type": "image_picker", "id": "bg_desktop", "label": "Background (desktop)" },
    { "type": "text", "id": "slogan_pre", "label": "Slogan", "default": "ONE GIANT BOOST" },
    { "type": "text", "id": "slogan_highlight", "label": "Slogan highlight (orange)", "default": "FOR MANKIND." },
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "Natural testosterone support for the modern man." },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "CLAIM 50% OFF NOW" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Column 1 — Shop" },
    { "type": "text", "id": "shop_title", "label": "Column title", "info": "Leave empty to hide the whole column.", "default": "SHOP" },
    { "type": "header", "content": "Column 2 — About" },
    { "type": "text", "id": "about_title", "label": "Column title", "info": "Leave empty to hide the whole column.", "default": "ABOUT" },
    { "type": "link_list", "id": "menu", "label": "Navigation menu (optional)", "info": "Used only when the About column has no link blocks." },
    { "type": "header", "content": "Column 3 — Learn" },
    { "type": "text", "id": "learn_title", "label": "Column title", "info": "Leave empty to hide the whole column.", "default": "LEARN" },
    { "type": "header", "content": "Column 4 — Support" },
    { "type": "text", "id": "support_title", "label": "Column title", "info": "Leave empty to hide the whole column.", "default": "SUPPORT" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "support@upmen.com", "info": "Leave empty to hide the email line." },
    { "type": "text", "id": "support_email_label", "label": "Email link text (optional)", "info": "Defaults to the email address itself." },
    { "type": "link_list", "id": "support_menu", "label": "Navigation menu (optional)", "info": "Shown after the email and the \"Footer link — Support\" blocks." },
    { "type": "header", "content": "Column 5 — Legal" },
    { "type": "text", "id": "legal_title", "label": "Column title", "info": "Leave empty to hide the whole column.", "default": "LEGAL" },
    { "type": "header", "content": "Column 6 — Follow us" },
    { "type": "text", "id": "social_title", "label": "Column title", "info": "Leave empty to hide the whole column.", "default": "FOLLOW US" },
    { "type": "paragraph", "content": "Add a \"Social icon\" block for each network. Without blocks the column shows only its title." },
    { "type": "header", "content": "Legal" },
    { "type": "textarea", "id": "disclaimer", "label": "Disclaimer", "default": "These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease. Results may vary. Consult your physician before use if you have a medical condition or take medication." }
  ],
  "max_blocks": 50,
  "blocks": [
    {
      "type": "shop_link",
      "name": "Link — Shop",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "3-Month Plan" },
        { "type": "text", "id": "url", "label": "Link", "default": "/#join_pkg", "info": "Accepts a path (/pages/contact), an anchor (#faq) or mailto:someone@example.com." }
      ]
    },
    {
      "type": "about_link",
      "name": "Link — About",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Ingredients" },
        { "type": "text", "id": "url", "label": "Link", "default": "/#ingredients", "info": "Accepts a path (/pages/contact), an anchor (#faq) or mailto:someone@example.com." }
      ]
    },
    {
      "type": "learn_link",
      "name": "Link — Learn",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "The UP MEN Journal" },
        { "type": "text", "id": "url", "label": "Link", "default": "/blogs/journal", "info": "Accepts a path (/pages/contact), an anchor (#faq) or mailto:someone@example.com." }
      ]
    },
    {
      "type": "legal_link",
      "name": "Link — Legal",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Privacy Policy" },
        { "type": "text", "id": "url", "label": "Link", "default": "/policies/privacy-policy", "info": "Accepts a path (/pages/contact), an anchor (#faq) or mailto:someone@example.com." }
      ]
    },
    {
      "type": "explore_link",
      "name": "Link — Explore (old)",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Ingredients" },
        { "type": "text", "id": "url", "label": "Link", "default": "#ingredients", "info": "Kept so existing footers do not lose links. These show under About — prefer \"Link — About\" for new ones." }
      ]
    },
    {
      "type": "support_link",
      "name": "Link — Support",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Help desk" },
        { "type": "text", "id": "url", "label": "Link", "default": "/pages/help-center", "info": "Accepts a path (/pages/contact), an anchor (#faq) or mailto:someone@example.com." }
      ]
    },
    {
      "type": "social_link",
      "name": "Social icon",
      "settings": [
        {
          "type": "select",
          "id": "network",
          "label": "Network",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "x", "label": "X (Twitter)" },
            { "value": "linkedin", "label": "LinkedIn" }
          ],
          "default": "instagram"
        },
        { "type": "text", "id": "url", "label": "Profile URL", "info": "Leave empty to hide this icon." },
        { "type": "text", "id": "label", "label": "Accessible label (optional)", "info": "Defaults to the network name." }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "shop_link", "settings": { "label": "3-Month Plan", "url": "/#join_pkg" } },
      { "type": "shop_link", "settings": { "label": "Monthly Plan", "url": "/#join_pkg" } },
      { "type": "shop_link", "settings": { "label": "Cart", "url": "/cart" } },
      { "type": "about_link", "settings": { "label": "Ingredients", "url": "/#ingredients" } },
      { "type": "about_link", "settings": { "label": "How it works", "url": "/#how-it-works" } },
      { "type": "about_link", "settings": { "label": "FAQ", "url": "/#faq" } },
      { "type": "about_link", "settings": { "label": "Subscription Policy", "url": "/policies/subscription-policy" } },
      { "type": "learn_link", "settings": { "label": "The UP MEN Journal", "url": "/blogs/journal" } },
      { "type": "learn_link", "settings": { "label": "UP MEN vs TRT", "url": "/blogs/journal/up-men-vs-trt" } },
      { "type": "learn_link", "settings": { "label": "UP MEN vs Nugenix", "url": "/blogs/journal/up-men-vs-nugenix" } },
      { "type": "learn_link", "settings": { "label": "UP MEN vs Inno Supps", "url": "/blogs/journal/up-men-vs-inno-supps-t-drive" } },
      { "type": "learn_link", "settings": { "label": "UP MEN vs Primal Viking", "url": "/blogs/journal/up-men-vs-primal-viking" } },
      { "type": "learn_link", "settings": { "label": "How to read a label", "url": "/blogs/journal/how-to-read-a-testosterone-label" } },
      { "type": "support_link", "settings": { "label": "Contact us", "url": "/pages/contact" } },
      { "type": "support_link", "settings": { "label": "Help desk", "url": "/pages/help-center" } },
      { "type": "support_link", "settings": { "label": "Refund Policy", "url": "/policies/refund-policy" } },
      { "type": "legal_link", "settings": { "label": "Terms + Conditions", "url": "/policies/terms-of-service" } },
      { "type": "legal_link", "settings": { "label": "Privacy Policy", "url": "/policies/privacy-policy" } },
      { "type": "legal_link", "settings": { "label": "Accessibility", "url": "/pages/accessibility" } }
    ]
  }
}
{% endschema %}
