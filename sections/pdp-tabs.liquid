{%- comment -%}
  PDP Tabs — the horizontal tab strip the reference page puts under the buy box.

  Each tab is a block, so the strip grows or shrinks without a code change. A tab
  can either show its own rich-text panel or act as a jump link to a section
  further down the page (that is how the reference uses "Ingredients" and
  "FAQ's": the strip is navigation, not just an accordion).

  Tabs degrade to plain stacked panels when JavaScript does not run: every panel
  is rendered, and the script hides the inactive ones on init.
{%- endcomment -%}
{%- assign sid = section.id -%}
{%- assign s = section.settings -%}

<style>
  #mm-pdp-tabs-{{ sid }} {
    background: var(--mars-black, #0a0503); color: var(--text, #fff);
    padding: 40px 0;
  }
  @media (min-width: 768px) { #mm-pdp-tabs-{{ sid }} { padding: 64px 0; } }
  #mm-pdp-tabs-{{ sid }} .mm-wrap { max-width: 980px; margin: 0 auto; padding: 0 16px; }
  #mm-pdp-tabs-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(22px, 4.2vw, 34px)) * var(--fs-h, 1)); margin: 0 0 24px; line-height: 1.2;
  }
  #mm-pdp-tabs-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }

  #mm-pdp-tabs-{{ sid }} .mm-tablist {
    display: flex; gap: 8px; overflow-x: auto; padding-bottom: 4px; margin: 0 0 20px;
    scrollbar-width: none; -ms-overflow-style: none;
    scroll-snap-type: x proximity;
  }
  #mm-pdp-tabs-{{ sid }} .mm-tablist::-webkit-scrollbar { display: none; }
  @media (min-width: 768px) { #mm-pdp-tabs-{{ sid }} .mm-tablist { justify-content: center; flex-wrap: wrap; overflow: visible; } }
  #mm-pdp-tabs-{{ sid }} .mm-tab {
    flex: 0 0 auto; scroll-snap-align: start; cursor: pointer;
    background: rgba(26,14,7,0.72); border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
    color: rgba(255,255,255,0.72); text-decoration: none;
    font-family: var(--font-heading); font-weight: 700; text-transform: uppercase;
    font-size: calc((11px) * var(--fs-b, 1)); letter-spacing: .05em;
    padding: 11px 16px; border-radius: 999px; white-space: nowrap;
    transition: background .16s ease, color .16s ease, border-color .16s ease;
  }
  @media (min-width: 768px) { #mm-pdp-tabs-{{ sid }} .mm-tab { font-size: calc((12px) * var(--fs-b, 1)); padding: 12px 20px; } }
  #mm-pdp-tabs-{{ sid }} .mm-tab:hover { color: #fff; border-color: rgba(255,86,0,0.5); }
  #mm-pdp-tabs-{{ sid }} .mm-tab[aria-selected="true"] {
    background: var(--brand, #ff5600); border-color: var(--brand, #ff5600); color: #fff;
  }
  #mm-pdp-tabs-{{ sid }} .mm-tab:focus-visible { outline: 2px solid var(--brand-yellow, #ff8a00); outline-offset: 2px; }

  #mm-pdp-tabs-{{ sid }} .mm-panel {
    background: rgba(26,14,7,0.72); border: 1px solid var(--mars-line, rgba(255,255,255,0.12));
    border-radius: 16px; padding: 20px;
  }
  @media (min-width: 768px) { #mm-pdp-tabs-{{ sid }} .mm-panel { padding: 32px; } }
  #mm-pdp-tabs-{{ sid }} .mm-panel + .mm-panel { margin-top: 12px; }
  #mm-pdp-tabs-{{ sid }} .mm-panel[hidden] { display: none; }
  #mm-pdp-tabs-{{ sid }} .mm-panel-title {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((15px) * var(--fs-b, 1)); margin: 0 0 12px; line-height: 1.3;
  }
  #mm-pdp-tabs-{{ sid }} .mm-body {
    font-family: var(--font-body); font-weight: 300; line-height: 1.75;
    font-size: calc((14.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.78);
  }
  #mm-pdp-tabs-{{ sid }} .mm-body p { margin: 0 0 14px; }
  #mm-pdp-tabs-{{ sid }} .mm-body p:last-child { margin-bottom: 0; }
  #mm-pdp-tabs-{{ sid }} .mm-body strong { color: #fff; font-weight: 700; }
  #mm-pdp-tabs-{{ sid }} .mm-body a { color: var(--brand, #ff5600); }
  #mm-pdp-tabs-{{ sid }} .mm-body ul { margin: 0 0 14px; padding-left: 20px; }
  #mm-pdp-tabs-{{ sid }} .mm-body li { margin-bottom: 6px; }
  #mm-pdp-tabs-{{ sid }} .mm-warn {
    margin: 12px 0 0; padding: 10px 12px; border-radius: 10px; line-height: 1.5;
    background: rgba(255,138,0,0.12); border: 1px solid rgba(255,138,0,0.45);
    font-size: calc((12px) * var(--fs-b, 1)); color: #ffd9b0;
  }
</style>

{%- capture mm_sel -%}mm-pdp-tabs-{{ section.id }}{%- endcapture -%}
{% render 'mm-section-colors', sel: mm_sel, s: section.settings %}

<section id="mm-pdp-tabs-{{ sid }}" class="reveal" data-testid="pdp-tabs">
  <div class="mm-wrap">
    {%- if s.title != blank or s.title_highlight != blank -%}
      <h2>{{ s.title }} {%- if s.title_highlight != blank %} <span class="orange">{{ s.title_highlight }}</span>{% endif -%}</h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="mm-tablist" role="tablist" aria-label="{{ s.aria_label | default: 'Product information' | escape }}">
        {%- for block in section.blocks -%}
          {%- if block.settings.jump_link != blank -%}
            <a class="mm-tab" href="{{ block.settings.jump_link }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- else -%}
            <button type="button" class="mm-tab" role="tab"
              id="tab-{{ sid }}-{{ block.id }}"
              aria-controls="panel-{{ sid }}-{{ block.id }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              data-tab="{{ block.id }}"
              {{ block.shopify_attributes }}>{{ block.settings.label }}</button>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- for block in section.blocks -%}
        {%- if block.settings.jump_link == blank -%}
          <div class="mm-panel" role="tabpanel"
            id="panel-{{ sid }}-{{ block.id }}"
            aria-labelledby="tab-{{ sid }}-{{ block.id }}"
            data-panel="{{ block.id }}">
            {%- if block.settings.heading != blank -%}
              <p class="mm-panel-title">{{ block.settings.heading }}</p>
            {%- endif -%}
            <div class="mm-body">{{ block.settings.content }}</div>
            {%- if request.design_mode and block.settings.content == blank -%}
              <div class="mm-warn">⚙️ This tab has no content yet. Add the copy in the block settings, or set a “Jump link” to turn it into a link to another section.</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    {%- elsif request.design_mode -%}
      <div class="mm-warn">⚙️ Add “Tab” blocks to this section.</div>
    {%- endif -%}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  var tabs = root.querySelectorAll('[data-tab]');
  var panels = root.querySelectorAll('[data-panel]');
  if (!tabs.length || !panels.length) return;

  function select(id) {
    tabs.forEach(function (t) {
      t.setAttribute('aria-selected', t.getAttribute('data-tab') === id ? 'true' : 'false');
    });
    panels.forEach(function (p) {
      p.hidden = p.getAttribute('data-panel') !== id;
    });
  }

  tabs.forEach(function (t, i) {
    t.addEventListener('click', function () { select(t.getAttribute('data-tab')); });
    t.addEventListener('keydown', function (e) {
      var next = null;
      if (e.key === 'ArrowRight') next = tabs[i + 1] || tabs[0];
      if (e.key === 'ArrowLeft') next = tabs[i - 1] || tabs[tabs.length - 1];
      if (!next) return;
      e.preventDefault();
      next.focus();
      select(next.getAttribute('data-tab'));
    });
  });

  /* Panels render open so the content is there without JS; collapse to the
     first one now that the script is running. */
  select(tabs[0].getAttribute('data-tab'));

  /* In the editor, jump straight to the tab the merchant clicked in the sidebar. */
  if (window.Shopify && window.Shopify.designMode) {
    root.addEventListener('shopify:block:select', function (e) {
      var t = e.target.getAttribute && e.target.getAttribute('data-tab');
      if (t) select(t);
    });
  }
})();
</script>

{% schema %}
{
  "name": "PDP Tabs",
  "tag": "section",
  "settings": [
    { "type": "header", "content": "Colours" },
    { "type": "paragraph", "content": "Leave a colour empty to keep the section's built-in styling." },
    { "type": "color", "id": "bg_color", "label": "Background" },
    { "type": "color", "id": "heading_color", "label": "Headings" },
    { "type": "color", "id": "text_color", "label": "Body text" },
    { "type": "color", "id": "accent_color", "label": "Accent" },
    { "type": "color", "id": "accent_on", "label": "Text on accent" },
    { "type": "color", "id": "panel_color", "label": "Cards and panels" },
    { "type": "color", "id": "border_color", "label": "Borders" },
    { "type": "text", "id": "title", "label": "Title" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)" },
    { "type": "text", "id": "aria_label", "label": "Screen-reader label for the tab strip", "default": "Product information" }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Tab",
      "settings": [
        { "type": "text", "id": "label", "label": "Tab label", "default": "Product Details" },
        { "type": "text", "id": "heading", "label": "Panel heading" },
        { "type": "richtext", "id": "content", "label": "Panel content" },
        { "type": "text", "id": "jump_link", "label": "Jump link (optional)", "info": "Set an anchor such as #ingredients or #faq to turn this tab into a link to another section instead of a panel." }
      ]
    }
  ],
  "presets": [
    {
      "name": "PDP Tabs",
      "blocks": [
        { "type": "tab", "settings": { "label": "Product Details", "heading": "WHAT UP MEN IS", "content": "<p>UP MEN is a men's dietary supplement with 9 active ingredients in each daily serving. It is designed to simplify the supplementation step inside a broader routine that can include nutrition, movement, training, sleep and consistent self-care.</p><p>Suggested use: take 5 capsules daily with food. Exact amounts are shown on the Supplement Facts panel.</p>" } },
        { "type": "tab", "settings": { "label": "What's Included", "heading": "YOUR PLAN AND YOUR WELCOME KIT", "content": "<p>The 90-day routine ships 3 bottles together and includes the Complete Welcome Kit: UP MEN Branded Thermal Bottle, UP MEN Crossbody Pack, Keychain Pill Case, Smart Activity Band and the UP MEN Men's Wellness Guide (digital, delivered by email).</p><p>The 30-day routine ships 1 bottle with the Starter Welcome Kit. Welcome gifts are included once with your first shipment and are not repeated on renewals.</p>" } },
        { "type": "tab", "settings": { "label": "Subscription", "heading": "HOW BILLING WORKS", "content": "<p>The 90-day plan is charged at the subscriber rate shown at checkout and renews at that same rate every 90 days unless you skip, pause or cancel before renewal. The 30-day plan renews every 30 days on the same terms.</p><p>To change or cancel a future renewal, contact UP MEN support before your next billing date.</p>" } },
        { "type": "tab", "settings": { "label": "Comparison", "jump_link": "#comparison" } },
        { "type": "tab", "settings": { "label": "Ingredients", "jump_link": "#ingredient-table" } },
        { "type": "tab", "settings": { "label": "FAQ's", "jump_link": "#faq" } }
      ]
    }
  ]
}
{% endschema %}
