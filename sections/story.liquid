{%- comment -%} Story — The Decline of T + The Solution benefit list {%- endcomment -%}
{%- assign sid = section.id -%}
{%- if section.settings.solution_bg_mobile != blank -%}
  {%- assign story_bg_mobile = section.settings.solution_bg_mobile | image_url: width: 1200 -%}
{%- else -%}
  {%- assign story_bg_mobile = 'The_Solution_BG_mobile.jpg' | asset_url -%}
{%- endif -%}
{%- if section.settings.solution_bg_desktop != blank -%}
  {%- assign story_bg_desktop = section.settings.solution_bg_desktop | image_url: width: 2400 -%}
{%- else -%}
  {%- assign story_bg_desktop = 'The_Solution_BG.jpg' | asset_url -%}
{%- endif -%}
{%- if section.settings.decline_bg_mobile != blank -%}
  {%- assign decline_bg_mobile = section.settings.decline_bg_mobile | image_url: width: 1200 -%}
{%- endif -%}
{%- if section.settings.decline_bg_desktop != blank -%}
  {%- assign decline_bg_desktop = section.settings.decline_bg_desktop | image_url: width: 2400 -%}
{%- endif -%}
{%- case section.settings.decline_height_mobile -%}
  {%- when 'small' -%}{%- assign dminh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign dminh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign dminh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign dminh_mobile = '100svh' -%}
  {%- else -%}{%- assign dminh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.decline_height_desktop -%}
  {%- when 'small' -%}{%- assign dminh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign dminh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign dminh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign dminh_desktop = '100vh' -%}
  {%- else -%}{%- assign dminh_desktop = 'auto' -%}
{%- endcase -%}
{%- assign stat_ov_color = section.settings.stat_overlay_color | default: '#ff5600' -%}
{%- assign stat_ov_op = section.settings.stat_overlay_opacity | default: 30 | divided_by: 100.0 -%}
{%- assign stat_ov_start = stat_ov_color | color_modify: 'alpha', stat_ov_op -%}
{%- assign stat_ov_end_op = stat_ov_op | divided_by: 3.0 -%}
{%- assign stat_ov_end = stat_ov_color | color_modify: 'alpha', stat_ov_end_op -%}
{%- case section.settings.height_mobile -%}
  {%- when 'small' -%}{%- assign minh_mobile = '55svh' -%}
  {%- when 'medium' -%}{%- assign minh_mobile = '70svh' -%}
  {%- when 'large' -%}{%- assign minh_mobile = '85svh' -%}
  {%- when 'full' -%}{%- assign minh_mobile = '100svh' -%}
  {%- else -%}{%- assign minh_mobile = 'auto' -%}
{%- endcase -%}
{%- case section.settings.height_desktop -%}
  {%- when 'small' -%}{%- assign minh_desktop = '520px' -%}
  {%- when 'medium' -%}{%- assign minh_desktop = '640px' -%}
  {%- when 'large' -%}{%- assign minh_desktop = '85vh' -%}
  {%- when 'full' -%}{%- assign minh_desktop = '100vh' -%}
  {%- else -%}{%- assign minh_desktop = 'auto' -%}
{%- endcase -%}
<style>
  /* ===== DECLINE ===== */
  #mm-decline-{{ sid }} {
    background-color: #0a0503;
    {% if decline_bg_mobile %}background-image: url('{{ decline_bg_mobile }}');{% endif %}
    background-size: cover; background-position: center; background-repeat: no-repeat;
    color: var(--text, #fff); padding: 64px 0; overflow-x: clip;
    min-height: {{ dminh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
  #mm-decline-{{ sid }} .mm-wrap { width: 100%; }
  @media (min-width: 768px) {
    #mm-decline-{{ sid }} {
      padding: 96px 0; min-height: {{ dminh_desktop }};
      {% if decline_bg_desktop %}background-image: url('{{ decline_bg_desktop }}');{% elsif decline_bg_mobile %}background-image: url('{{ decline_bg_mobile }}');{% endif %}
    }
  }
  #mm-decline-{{ sid }} .mm-wrap { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
  #mm-decline-{{ sid }} .mm-grid { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; justify-items: center; }
  @media (min-width: 768px) { #mm-decline-{{ sid }} .mm-grid { grid-template-columns: 1fr 1fr; gap: 48px; justify-items: stretch; } }
  #mm-decline-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((clamp(26px, 4.4vw, 42px)) * var(--fs-h, 1)); line-height: 1.15; margin: 0 0 20px;
  }
  #mm-decline-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-decline-{{ sid }} p { font-size: calc((16px) * var(--fs-b, 1)); line-height: 1.65; color: rgba(255,255,255,0.85); margin: 0 0 14px; }
  #mm-decline-{{ sid }} p strong { color: #fff; }
  #mm-decline-{{ sid }} .mm-text { max-width: 30rem; text-align: center; }
  @media (min-width: 768px) { #mm-decline-{{ sid }} .mm-text { text-align: left; } }
  #mm-decline-{{ sid }} .mm-stat {
    max-width: 440px; width: 100%; background: #1a0e07; border: 1px solid rgba(255,255,255,0.14);
    border-radius: 16px; padding: 40px 28px; text-align: center;
  }
  #mm-decline-{{ sid }} .mm-stat.has-img {
    position: relative; overflow: hidden;
    background:
      {% if section.settings.stat_overlay_enabled %}linear-gradient(180deg, {{ stat_ov_start }}, {{ stat_ov_end }}),{% endif %}
      url('{{ section.settings.stat_image | image_url: width: 880 }}') center / cover no-repeat, #1a0e07;
  }
  #mm-decline-{{ sid }} .mm-stat .big {
    font-family: var(--font-heading); font-size: calc((clamp(56px, 9vw, 88px)) * var(--fs-h, 1)); font-weight: 800;
    color: var(--brand, #ff5600); line-height: 1; display: block; margin-bottom: 12px;
  }
  #mm-decline-{{ sid }} .mm-stat .lbl {
    font-family: var(--font-heading); font-size: calc((13px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.16em;
    text-transform: uppercase; color: rgba(255,255,255,0.85); display: block; margin-bottom: 18px;
  }
  #mm-decline-{{ sid }} .mm-stat .big {
    opacity: 0; transform: translateY(12px); transition: opacity 0.5s ease, transform 0.5s ease;
  }
  #mm-decline-{{ sid }} .mm-stat.chart-on .big { opacity: 1; transform: translateY(0); }
  #mm-decline-{{ sid }} .mm-chart {
    display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: end;
    height: 150px; margin: 6px 6px 10px; position: relative;
  }
  #mm-decline-{{ sid }} .mm-col { position: relative; display: flex; flex-direction: column; justify-content: flex-end; height: 100%; }
  #mm-decline-{{ sid }} .mm-col .fill {
    width: 100%; border-radius: 8px 8px 3px 3px;
    background: linear-gradient(180deg, var(--brand, #ff5600), rgba(255,86,0,0.45));
    transform: scaleY(0); transform-origin: bottom;
    transition: transform 0.9s cubic-bezier(.2,.7,.2,1);
  }
  #mm-decline-{{ sid }} .mm-col:nth-child(2) .fill { transition-delay: 0.25s; }
  #mm-decline-{{ sid }} .mm-col:nth-child(3) .fill { transition-delay: 0.5s; background: linear-gradient(180deg, #ff2d2d, rgba(255,45,45,0.4)); }
  #mm-decline-{{ sid }} .mm-stat.chart-on .mm-col .fill { transform: scaleY(1); }
  #mm-decline-{{ sid }} .mm-col .pct {
    position: absolute; left: 0; right: 0; text-align: center;
    font-family: var(--font-heading); font-weight: 800; font-size: calc((13px) * var(--fs-b, 1)); color: #fff;
    opacity: 0; transition: opacity 0.4s ease;
  }
  #mm-decline-{{ sid }} .mm-col .pct { top: -22px; }
  #mm-decline-{{ sid }} .mm-stat.chart-on .mm-col .pct { opacity: 1; }
  #mm-decline-{{ sid }} .mm-col:nth-child(1) .pct { transition-delay: 0.7s; }
  #mm-decline-{{ sid }} .mm-col:nth-child(2) .pct { transition-delay: 0.95s; }
  #mm-decline-{{ sid }} .mm-col:nth-child(3) .pct { transition-delay: 1.2s; }
  #mm-decline-{{ sid }} .mm-arrow {
    position: absolute; inset: 0; pointer-events: none; overflow: visible;
  }
  #mm-decline-{{ sid }} .mm-arrow path {
    fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round;
    stroke-dasharray: 400; stroke-dashoffset: 400;
    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.6));
  }
  #mm-decline-{{ sid }} .mm-arrow .head {
    fill: none; stroke: #fff; stroke-width: 3; stroke-linecap: round; stroke-linejoin: round;
    stroke-dasharray: none; stroke-dashoffset: 0;
    opacity: 0; transition: opacity 0.3s ease 1.5s; filter: drop-shadow(0 2px 6px rgba(0,0,0,0.6));
  }
  #mm-decline-{{ sid }} .mm-stat.chart-on .mm-arrow path { transition: stroke-dashoffset 1.2s ease 0.6s; stroke-dashoffset: 0; }
  #mm-decline-{{ sid }} .mm-stat.chart-on .mm-arrow .head { opacity: 1; }
  #mm-decline-{{ sid }} .mm-stat .yrs { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; margin: 0 6px; font-family: var(--font-heading); font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.1em; color: rgba(255,255,255,0.7); }
  #mm-decline-{{ sid }} .mm-stat .yrs span { text-align: center; }
  #mm-decline-{{ sid }} .mm-stat .cap {
    display: block; margin-top: 14px; font-size: calc((11.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.6); line-height: 1.4;
  }
  @media (prefers-reduced-motion: reduce) {
    #mm-decline-{{ sid }} .mm-stat .big,
    #mm-decline-{{ sid }} .mm-col .fill,
    #mm-decline-{{ sid }} .mm-col .pct,
    #mm-decline-{{ sid }} .mm-arrow .head { opacity: 1; transform: none; transition: none; }
    #mm-decline-{{ sid }} .mm-arrow path { stroke-dashoffset: 0; transition: none; }
  }

  /* ===== SOLUTION ===== */
  #mm-solution-{{ sid }} {
    background: #120804 url('{{ story_bg_mobile }}') center / cover no-repeat;
    color: var(--text, #fff); padding: 64px 0; overflow-x: clip;
    min-height: {{ minh_mobile }}; display: flex; flex-direction: column; justify-content: center;
  }
  @media (min-width: 768px) {
    #mm-solution-{{ sid }} { background-image: url('{{ story_bg_desktop }}'); padding: 96px 0; min-height: {{ minh_desktop }}; }
  }
  #mm-solution-{{ sid }} .mm-wrap { max-width: 1100px; margin: 0 auto; padding: 0 16px; }
  #mm-solution-{{ sid }} .mm-grid { display: grid; grid-template-columns: 1fr; gap: 32px; align-items: center; justify-items: center; }
  @media (min-width: 768px) { #mm-solution-{{ sid }} .mm-grid { grid-template-columns: {% if section.settings.solution_image != blank %}1fr 1fr{% else %}minmax(0, 640px){% endif %}; gap: 48px; justify-items: stretch; justify-content: center; } }
  #mm-solution-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase;
    font-size: calc((clamp(26px, 4.4vw, 42px)) * var(--fs-h, 1)); line-height: 1.15; margin: 0 0 16px; text-align: center;
  }
  @media (min-width: 768px) { #mm-solution-{{ sid }} h2 { text-align: left; } }
  #mm-solution-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-solution-{{ sid }} .mm-lede { font-size: calc((15.5px) * var(--fs-b, 1)); line-height: 1.6; color: rgba(255,255,255,0.85); margin: 0 0 24px; text-align: center; }
  @media (min-width: 768px) { #mm-solution-{{ sid }} .mm-lede { text-align: left; } }
  #mm-solution-{{ sid }} .mm-benefits { list-style: none; margin: 0 0 28px; padding: 0; display: flex; flex-direction: column; gap: 14px; width: 100%; max-width: 30rem; }
  #mm-solution-{{ sid }} .mm-benefit {
    display: flex; align-items: flex-start; gap: 12px;
    background: rgba(10,5,3,0.6); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; padding: 14px 16px;
  }
  #mm-solution-{{ sid }} .mm-benefit .ic {
    width: 34px; height: 34px; border-radius: 8px; background: var(--brand, #ff5600);
    display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: calc((16px) * var(--fs-b, 1));
    overflow: hidden;
  }
  #mm-solution-{{ sid }} .mm-benefit .ic img {
    width: 100%; height: 100%; object-fit: contain; display: block; padding: 5px;
  }
  #mm-solution-{{ sid }} .mm-benefit h3 {
    font-family: var(--font-heading); font-size: calc((13px) * var(--fs-h, 1)); font-weight: 700; letter-spacing: 0.1em;
    text-transform: uppercase; margin: 0 0 2px;
  }
  #mm-solution-{{ sid }} .mm-benefit p { font-size: calc((13.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.75); margin: 0; line-height: 1.45; }
  #mm-solution-{{ sid }} .mm-img { max-width: 460px; width: 100%; }
  #mm-solution-{{ sid }} .mm-img img { width: 100%; height: auto; display: block; border-radius: 16px; }
  #mm-solution-{{ sid }} .mm-cta-row { text-align: center; }
  @media (min-width: 768px) { #mm-solution-{{ sid }} .mm-cta-row { text-align: left; } }
  #mm-solution-{{ sid }} .mm-cta {
    display: inline-flex; align-items: center; gap: 10px;
    background: var(--brand, #ff5600); color: #fff; text-decoration: none;
    font-weight: 800; font-size: calc((16px) * var(--fs-b, 1)); text-transform: uppercase;
    padding: 16px 40px; border-radius: 6px; box-shadow: 0 8px 28px rgba(255,86,0,0.4);
  }
  #mm-solution-{{ sid }} .mm-cta:hover { filter: brightness(1.1); }
</style>

<section id="mm-decline-{{ sid }}" class="reveal" data-testid="story-decline">
  <div class="mm-wrap">
    <div class="mm-grid">
      <div class="mm-text">
        <h2>{{ section.settings.decline_title_pre }} <span class="orange">{{ section.settings.decline_title_highlight }}</span></h2>
        <p>{{ section.settings.decline_p1 }}</p>
        <p>{{ section.settings.decline_p2 }}</p>
        <p><strong>{{ section.settings.decline_p3 }}</strong></p>
      </div>
      <div class="mm-stat{% if section.settings.stat_image != blank %} has-img{% endif %}" data-stat-chart role="img" aria-label="Average testosterone levels dropping 1% every year since 1980: 100% in 1980, around 80% in 2000, around 55% today">
        <span class="big">-1%</span>
        <span class="lbl">{{ section.settings.stat_label }}</span>
        <div class="mm-chart">
          <div class="mm-col"><span class="pct">100%</span><div class="fill" style="height: 100%;"></div></div>
          <div class="mm-col"><span class="pct">80%</span><div class="fill" style="height: 80%;"></div></div>
          <div class="mm-col"><span class="pct">55%</span><div class="fill" style="height: 55%;"></div></div>
          <svg class="mm-arrow" viewBox="0 0 300 150" preserveAspectRatio="none" aria-hidden="true">
            <path d="M 30 22 Q 150 32 262 62" />
            <path class="head" d="M 248 50 L 263 62 L 244 68" />
          </svg>
        </div>
        <div class="yrs"><span>1980</span><span>2000</span><span>TODAY</span></div>
        <span class="cap">{{ section.settings.stat_caption }}</span>
      </div>
    </div>
  </div>
</section>

<script>
(function(){
  var stat = document.querySelector('#mm-decline-{{ sid }} [data-stat-chart]');
  if (!stat) return;
  var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var inDesignMode = window.Shopify && window.Shopify.designMode;
  if (reduced || inDesignMode || !('IntersectionObserver' in window)) {
    stat.classList.add('chart-on');
    return;
  }
  var io = new IntersectionObserver(function(entries){
    entries.forEach(function(entry){
      if (entry.isIntersecting) {
        stat.classList.add('chart-on');
        io.disconnect();
      }
    });
  }, { threshold: 0.4 });
  io.observe(stat);
})();
</script>

<section id="mm-solution-{{ sid }}" class="reveal" data-testid="story-solution">
  <div class="mm-wrap">
    <div class="mm-grid">
      <div>
        <h2><span class="orange">{{ section.settings.solution_title }}</span></h2>
        <p class="mm-lede">{{ section.settings.solution_lede }}</p>
        <ul class="mm-benefits">
          {%- for block in section.blocks -%}
            <li class="mm-benefit" {{ block.shopify_attributes }}>
              <span class="ic" aria-hidden="true">
                {%- if block.settings.icon_image != blank -%}
                  <img src="{{ block.settings.icon_image | image_url: width: 68 }}" alt="" loading="lazy">
                {%- else -%}
                  {{ block.settings.icon }}
                {%- endif -%}
              </span>
              <div>
                <h3>{{ block.settings.title }}</h3>
                <p>{{ block.settings.text }}</p>
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="mm-cta-row">
          <a href="{{ section.settings.cta_link | default: '#join_pkg' }}" class="mm-cta">{{ section.settings.cta_label }}</a>
        </div>
      </div>
      {%- if section.settings.solution_image != blank -%}
        <div class="mm-img">
          <img src="{{ section.settings.solution_image | image_url: width: 920 }}" alt="The solution — Up Men" loading="lazy">
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Story (Custom)",
  "settings": [
    { "type": "text", "id": "decline_title_pre", "label": "Decline title", "default": "THE DECLINE OF T:" },
    { "type": "text", "id": "decline_title_highlight", "label": "Decline title highlight", "default": "A MODERN EPIDEMIC" },
    { "type": "textarea", "id": "decline_p1", "label": "Paragraph 1", "default": "Testosterone levels have been dropping by 1% every year since 1980. Stress, poor sleep, processed diets, and toxins are destroying natural hormone production." },
    { "type": "textarea", "id": "decline_p2", "label": "Paragraph 2", "default": "The impact? Low testosterone drains energy, strength, and focus — making it harder to perform at your best in life and the gym." },
    { "type": "textarea", "id": "decline_p3", "label": "Paragraph 3 (bold)", "default": "The good news: Up Men helps you reclaim your edge with natural testosterone support for energy, focus, and strength." },
    { "type": "text", "id": "solution_title", "label": "Solution title", "default": "THE SOLUTION?" },
    { "type": "textarea", "id": "solution_lede", "label": "Solution intro", "default": "Maintaining balanced testosterone levels is pivotal for contributing to an overall sense of well-being. Encouraging our body's natural hormonal function can help us men:" },
    { "type": "text", "id": "cta_label", "label": "CTA label", "default": "TRY IT NOW" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    { "type": "header", "content": "Decline banner size (top section)" },
    {
      "type": "select",
      "id": "decline_height_mobile",
      "label": "Decline banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (55% of screen)" },
        { "value": "medium", "label": "Medium (70% of screen)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "decline_height_desktop",
      "label": "Decline banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (520px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Stat box (-1% chart)" },
    { "type": "text", "id": "stat_label", "label": "Chart label", "default": "AVERAGE TESTOSTERONE LEVELS SINCE 1980" },
    { "type": "text", "id": "stat_caption", "label": "Chart caption (below years)", "default": "Men today have roughly half the testosterone their grandfathers had at the same age.*" },
    { "type": "image_picker", "id": "stat_image", "label": "Background image or GIF", "info": "Shown behind the -1% chart. GIFs are supported." },
    { "type": "checkbox", "id": "stat_overlay_enabled", "label": "Apply color gradient over image", "default": true },
    { "type": "color", "id": "stat_overlay_color", "label": "Gradient color", "default": "#1a0e07" },
    { "type": "range", "id": "stat_overlay_opacity", "label": "Gradient opacity (%)", "min": 0, "max": 90, "step": 5, "default": 45 },
    { "type": "header", "content": "Solution banner size (bottom section)" },
    {
      "type": "select",
      "id": "height_mobile",
      "label": "Banner height (mobile)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (55% of screen)" },
        { "value": "medium", "label": "Medium (70% of screen)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "height_desktop",
      "label": "Banner height (desktop)",
      "options": [
        { "value": "auto", "label": "Auto (fit content)" },
        { "value": "small", "label": "Small (520px)" },
        { "value": "medium", "label": "Medium (640px)" },
        { "value": "large", "label": "Large (85% of screen)" },
        { "value": "full", "label": "Full screen" }
      ],
      "default": "auto"
    },
    { "type": "header", "content": "Images" },
    { "type": "image_picker", "id": "decline_bg_mobile", "label": "Decline background (mobile)" },
    { "type": "image_picker", "id": "decline_bg_desktop", "label": "Decline background (desktop)" },
    { "type": "image_picker", "id": "solution_bg_mobile", "label": "Solution background (mobile)" },
    { "type": "image_picker", "id": "solution_bg_desktop", "label": "Solution background (desktop)" },
    { "type": "image_picker", "id": "solution_image", "label": "Solution image (optional)" }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        { "type": "image_picker", "id": "icon_image", "label": "Icon image (overrides emoji)" },
        { "type": "text", "id": "icon", "label": "Emoji icon (fallback)", "default": "⚡" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
