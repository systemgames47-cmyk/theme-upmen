{%- comment -%} Top announcement bar — Up Men offer strip {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-topbar-{{ sid }} {
    background: #000; color: #fff; text-align: center;
    padding: 10px 12px; font-family: var(--font-heading);
    font-size: calc((11px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    display: flex; align-items: center; justify-content: center; gap: 8px; flex-wrap: wrap;
  }
  {%- assign topbar_bg_mobile = section.settings.bg_mobile | default: section.settings.bg_desktop -%}
  {%- if topbar_bg_mobile != blank -%}
  #mm-topbar-{{ sid }} {
    background: #000 url('{{ topbar_bg_mobile | image_url: width: 1200 }}') center / cover no-repeat;
  }
  {%- endif -%}
  {%- if section.settings.bg_desktop != blank -%}
  @media (min-width: 768px) {
    #mm-topbar-{{ sid }} {
      background: #000 url('{{ section.settings.bg_desktop | image_url: width: 2400 }}') center / cover no-repeat;
    }
  }
  {%- endif -%}
  #mm-topbar-{{ sid }} .mm-pill {
    background: var(--brand, #ff5600); color: var(--text, #fff); padding: 3px 10px; border-radius: 4px;
    font-weight: 800;
  }
  #mm-topbar-{{ sid }} .mm-count { font-variant-numeric: tabular-nums; color: var(--brand, #ff5600); font-weight: 800; }
  @media (min-width: 768px) { #mm-topbar-{{ sid }} { font-size: calc((12px) * var(--fs-b, 1)); } }
</style>

<div id="mm-topbar-{{ sid }}" role="region" aria-label="Announcements">
  <span>{{ section.settings.pre_text }}</span>
  <span class="mm-pill">{{ section.settings.highlight }}</span>
  <span>{{ section.settings.post_text }}</span>
  {%- if section.settings.show_countdown and section.settings.countdown_target != blank -%}
    <span class="mm-count" data-countdown-block data-target="{{ section.settings.countdown_target }}">
      <span data-unit="days">--</span>d :
      <span data-unit="hours">--</span>h :
      <span data-unit="minutes">--</span>m :
      <span data-unit="seconds">--</span>s
    </span>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Top Banner",
  "settings": [
    { "type": "text", "id": "pre_text", "label": "Text before highlight", "default": "CLAIM YOUR OFFER" },
    { "type": "text", "id": "highlight", "label": "Highlighted text", "default": "50% OFF" },
    { "type": "text", "id": "post_text", "label": "Text after highlight", "default": "+ $70 FREE GIFTS" },
    { "type": "checkbox", "id": "show_countdown", "label": "Show countdown", "default": false },
    {
      "type": "text",
      "id": "countdown_target",
      "label": "Deadline (ISO)",
      "info": "Format: 2026-08-01T23:59:59",
      "default": "2026-08-01T23:59:59"
    },
    { "type": "header", "content": "Background image" },
    { "type": "image_picker", "id": "bg_mobile", "label": "Background image (mobile)" },
    { "type": "image_picker", "id": "bg_desktop", "label": "Background image (desktop)", "info": "If only one image is uploaded, it is used on all screen sizes." }
  ],
  "presets": [{ "name": "Top Banner" }]
}
{% endschema %}
