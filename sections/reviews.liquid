{%- comment -%} Reviews — summary + distribution + review list, Mars dark styling, block-based with uploadable photos {%- endcomment -%}
{%- assign sid = section.id -%}
<style>
  #mm-rv-{{ sid }} { background: var(--mars-black, #0a0503); color: var(--text, #fff); padding: 56px 0; }
  @media (min-width: 768px) { #mm-rv-{{ sid }} { padding: 80px 0; } }
  #mm-rv-{{ sid }} .mm-wrap { max-width: 1024px; margin: 0 auto; padding: 0 16px; }
  #mm-rv-{{ sid }} h2 {
    font-family: var(--font-heading); font-weight: 800; text-transform: uppercase; text-align: center;
    font-size: calc((clamp(24px, 4.2vw, 38px)) * var(--fs-h, 1)); margin: 0 0 36px;
  }
  #mm-rv-{{ sid }} h2 .orange { color: var(--brand, #ff5600); }
  #mm-rv-{{ sid }} .mm-summary { display: grid; grid-template-columns: 1fr; gap: 32px; padding-bottom: 32px; border-bottom: 1px solid var(--mars-line, rgba(255,255,255,0.12)); align-items: start; }
  @media (min-width: 768px) { #mm-rv-{{ sid }} .mm-summary { grid-template-columns: repeat(3, 1fr); gap: 40px; } }
  #mm-rv-{{ sid }} .mm-avg-row { text-align: center; }
  @media (min-width: 768px) { #mm-rv-{{ sid }} .mm-avg-row { text-align: left; } }
  #mm-rv-{{ sid }} .mm-avg { display: inline-flex; align-items: center; gap: 10px; }
  #mm-rv-{{ sid }} .mm-avg .num { font-family: var(--font-heading); font-size: calc((40px) * var(--fs-b, 1)); font-weight: 800; line-height: 1; }
  @media (min-width: 768px) { #mm-rv-{{ sid }} .mm-avg .num { font-size: calc((48px) * var(--fs-b, 1)); } }
  #mm-rv-{{ sid }} .mm-stars { display: inline-flex; align-items: center; gap: 2px; }
  #mm-rv-{{ sid }} .mm-stars svg { width: 16px; height: 16px; }
  #mm-rv-{{ sid }} .mm-stars.lg svg { width: 22px; height: 22px; }
  #mm-rv-{{ sid }} .mm-stars.sm svg { width: 13px; height: 13px; }
  #mm-rv-{{ sid }} .mm-stars .full { fill: var(--brand-yellow, #ff8a00); color: var(--brand-yellow, #ff8a00); }
  #mm-rv-{{ sid }} .mm-stars .empty { fill: rgba(255,255,255,0.15); color: rgba(255,255,255,0.15); }
  #mm-rv-{{ sid }} .mm-total { font-size: calc((13px) * var(--fs-b, 1)); color: rgba(255,255,255,0.6); margin-top: 8px; }
  #mm-rv-{{ sid }} .mm-dist { display: flex; flex-direction: column; gap: 6px; }
  #mm-rv-{{ sid }} .mm-dist .row { display: flex; align-items: center; gap: 8px; font-size: calc((12.5px) * var(--fs-b, 1)); }
  #mm-rv-{{ sid }} .mm-dist .bar { flex: 1; height: 8px; background: rgba(255,255,255,0.08); border-radius: 2px; overflow: hidden; }
  #mm-rv-{{ sid }} .mm-dist .bar > div { height: 100%; background: var(--brand-yellow, #ff8a00); }
  #mm-rv-{{ sid }} .mm-dist .count { color: rgba(255,255,255,0.6); font-variant-numeric: tabular-nums; width: 60px; text-align: right; }
  #mm-rv-{{ sid }} .mm-photos { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
  #mm-rv-{{ sid }} .mm-photos > div { aspect-ratio: 1/1; overflow: hidden; border-radius: 4px; background: var(--mars-panel, #1a0e07); }
  #mm-rv-{{ sid }} .mm-photos img { width: 100%; height: 100%; object-fit: cover; display: block; }
  #mm-rv-{{ sid }} .mm-photos .mm-ph-sq {
    width: 100%; height: 100%; border: 2px dashed rgba(255,86,0,0.4); border-radius: 4px;
    display: flex; align-items: center; justify-content: center; text-align: center; padding: 6px;
    font-family: var(--font-heading); font-size: calc((8px) * var(--fs-b, 1)); font-weight: 700; letter-spacing: 0.08em;
    text-transform: uppercase; color: rgba(255,255,255,0.45); line-height: 1.5;
  }
  #mm-rv-{{ sid }} .mm-tabs { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 20px 0; border-bottom: 1px solid var(--mars-line, rgba(255,255,255,0.12)); flex-wrap: wrap; }
  #mm-rv-{{ sid }} .mm-tabs .left { display: flex; align-items: center; gap: 12px; font-size: calc((14px) * var(--fs-b, 1)); }
  #mm-rv-{{ sid }} .mm-tabs .active { font-weight: 700; border-bottom: 2px solid var(--brand, #ff5600); padding-bottom: 4px; }
  #mm-rv-{{ sid }} .mm-tabs .num { color: rgba(255,255,255,0.6); }
  #mm-rv-{{ sid }} .mm-tabs .filter { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--mars-line, rgba(255,255,255,0.2)); border-radius: 6px; padding: 6px 12px; font-size: calc((13px) * var(--fs-b, 1)); color: rgba(255,255,255,0.8); }
  #mm-rv-{{ sid }} .mm-list > article { padding: 24px 0; border-bottom: 1px solid var(--mars-line, rgba(255,255,255,0.12)); }
  #mm-rv-{{ sid }} .mm-list > article:last-child { border-bottom: none; }
  #mm-rv-{{ sid }} .mm-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 12px; }
  #mm-rv-{{ sid }} .mm-who { display: flex; align-items: flex-start; gap: 12px; }
  #mm-rv-{{ sid }} .mm-avatar { position: relative; flex-shrink: 0; }
  #mm-rv-{{ sid }} .mm-avatar .ini { width: 40px; height: 40px; border-radius: 9999px; background: var(--mars-panel, #1a0e07); border: 1px solid var(--mars-line, rgba(255,255,255,0.12)); color: rgba(255,255,255,0.7); font-weight: 700; font-size: calc((12px) * var(--fs-b, 1)); display: flex; align-items: center; justify-content: center; }
  #mm-rv-{{ sid }} .mm-avatar .badge { position: absolute; bottom: -2px; right: -2px; width: 16px; height: 16px; color: var(--brand-green, #39c46e); background: var(--mars-black, #0a0503); border-radius: 9999px; }
  #mm-rv-{{ sid }} .mm-name-line { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  #mm-rv-{{ sid }} .mm-name { font-weight: 700; font-size: calc((14px) * var(--fs-h, 1)); }
  #mm-rv-{{ sid }} .mm-verified { font-size: calc((12px) * var(--fs-b, 1)); color: var(--brand-green, #39c46e); font-weight: 600; }
  #mm-rv-{{ sid }} .mm-country { display: flex; align-items: center; gap: 6px; font-size: calc((12px) * var(--fs-b, 1)); color: rgba(255,255,255,0.55); margin-top: 2px; }
  #mm-rv-{{ sid }} .mm-date { font-size: calc((12px) * var(--fs-b, 1)); color: rgba(255,255,255,0.4); flex-shrink: 0; font-variant-numeric: tabular-nums; }
  #mm-rv-{{ sid }} .mm-title-row { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; flex-wrap: wrap; }
  #mm-rv-{{ sid }} .mm-rtitle { font-weight: 700; font-size: calc((14.5px) * var(--fs-h, 1)); }
  #mm-rv-{{ sid }} .mm-body { font-size: calc((14.5px) * var(--fs-b, 1)); color: rgba(255,255,255,0.8); line-height: 1.65; margin: 0 0 16px; }
  #mm-rv-{{ sid }} .mm-rphotos { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 4px; }
  #mm-rv-{{ sid }} .mm-rphotos > div { width: 96px; height: 96px; overflow: hidden; border-radius: 4px; background: var(--mars-panel, #1a0e07); }
  #mm-rv-{{ sid }} .mm-rphotos img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>

<section id="mm-rv-{{ sid }}" class="reveal" data-testid="reviews">
  <div class="mm-wrap">
    <h2>{{ section.settings.title_pre }} <span class="orange">{{ section.settings.title_highlight }}</span></h2>

    <div class="mm-summary">
      <div class="mm-avg-row">
        <div class="mm-avg">
          <span class="num">{{ section.settings.avg_rating }}</span>
          <span class="mm-stars lg">
            {%- for i in (1..5) -%}
              <svg class="full" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3.5 7 7.5 1-5.5 5.5 1.5 7.5-7-4-7 4 1.5-7.5L1 9l7.5-1z"/></svg>
            {%- endfor -%}
          </span>
        </div>
        <p class="mm-total">Based on {{ section.settings.total_reviews }} reviews</p>
      </div>

      <div class="mm-dist">
        {%- assign d_stars = '5|4|3|2|1' | split: '|' -%}
        {%- assign d_pcts = section.settings.dist_pcts | split: '|' -%}
        {%- assign d_counts = section.settings.dist_counts | split: '|' -%}
        {%- for n_str in d_stars -%}
          {%- assign idx = forloop.index0 -%}
          {%- assign n = n_str | times: 1 -%}
          <div class="row">
            <span class="mm-stars sm">
              {%- for i in (1..5) -%}
                <svg class="{% if i <= n %}full{% else %}empty{% endif %}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3.5 7 7.5 1-5.5 5.5 1.5 7.5-7-4-7 4 1.5-7.5L1 9l7.5-1z"/></svg>
              {%- endfor -%}
            </span>
            <div class="bar"><div style="width:{{ d_pcts[idx] | default: 0 }}%;"></div></div>
            <span class="count">({{ d_counts[idx] | default: '0' }})</span>
          </div>
        {%- endfor -%}
      </div>

      <div class="mm-photos">
        {%- assign pics = 'photo_1,photo_2,photo_3,photo_4' | split: ',' -%}
        {%- for pic_id in pics -%}
          {%- assign pic = section.settings[pic_id] -%}
          <div>
            {%- if pic != blank -%}
              <img src="{{ pic | image_url: width: 400 }}" alt="Customer photo {{ forloop.index }}" loading="lazy">
            {%- else -%}
              {%- assign rv_preview = 'upmen-preview-review' | append: forloop.index | append: '.jpg' -%}
              <img src="{{ rv_preview | asset_url }}" alt="Customer photo {{ forloop.index }}" loading="lazy">
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="mm-tabs">
      <div class="left">
        <span class="active">Reviews</span>
        <span class="num">{{ section.settings.total_reviews }}</span>
      </div>
      <div class="filter">
        With Photos
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
      </div>
    </div>

    <div class="mm-list">
      {%- for block in section.blocks -%}
        <article {{ block.shopify_attributes }}>
          <div class="mm-head">
            <div class="mm-who">
              <div class="mm-avatar">
                <div class="ini">{{ block.settings.name | slice: 0, 1 }}{{ block.settings.name | split: ' ' | last | slice: 0, 1 }}</div>
                <svg class="badge" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2.39 2.39L17.66 1.5l1.34 3.31L22.5 5l-.5 3.45L24 11l-2.34 1.95.5 3.45-3.5.19-1.34 3.31-3.27-.89L12 21l-2.05-2.39-3.27.89-1.34-3.31L1.84 16l.5-3.45L0 11l2.34-1.95L1.84 5l3.5-.19L6.68 1.5l3.27.89z"/></svg>
              </div>
              <div>
                <div class="mm-name-line">
                  <span class="mm-name">{{ block.settings.name }}</span>
                  <span class="mm-verified">Verified Purchase</span>
                </div>
                <div class="mm-country">
                  <span>{{ block.settings.flag }}</span>
                  <span>{{ block.settings.country }}</span>
                </div>
              </div>
            </div>
            <span class="mm-date">{{ block.settings.date }}</span>
          </div>
          <div class="mm-title-row">
            <span class="mm-stars">
              {%- assign rating = block.settings.rating -%}
              {%- for i in (1..5) -%}
                <svg class="{% if i <= rating %}full{% else %}empty{% endif %}" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1l3.5 7 7.5 1-5.5 5.5 1.5 7.5-7-4-7 4 1.5-7.5L1 9l7.5-1z"/></svg>
              {%- endfor -%}
            </span>
            <h3 class="mm-rtitle">{{ block.settings.title }}</h3>
          </div>
          <p class="mm-body">{{ block.settings.body }}</p>
          {%- if block.settings.photo != blank -%}
            <div class="mm-rphotos">
              <div><img src="{{ block.settings.photo | image_url: width: 300 }}" alt="Review photo — {{ block.settings.name }}" loading="lazy"></div>
            </div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reviews",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "title_pre", "label": "Title", "default": "WHAT MEN ARE" },
    { "type": "text", "id": "title_highlight", "label": "Title highlight (orange)", "default": "SAYING" },
    { "type": "text", "id": "avg_rating", "label": "Average rating", "default": "4.8" },
    { "type": "text", "id": "total_reviews", "label": "Total reviews", "default": "4,548" },
    { "type": "text", "id": "dist_pcts", "label": "Star bar widths %, 5→1 (separate with |)", "default": "86|8|3|1|2" },
    { "type": "text", "id": "dist_counts", "label": "Star counts, 5→1 (separate with |)", "default": "3,911|364|136|46|91" },
    { "type": "header", "content": "Customer photo grid" },
    { "type": "image_picker", "id": "photo_1", "label": "Customer photo 1" },
    { "type": "image_picker", "id": "photo_2", "label": "Customer photo 2" },
    { "type": "image_picker", "id": "photo_3", "label": "Customer photo 3" },
    { "type": "image_picker", "id": "photo_4", "label": "Customer photo 4" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "name", "label": "Customer name", "default": "John D." },
        { "type": "text", "id": "flag", "label": "Country flag emoji", "default": "🇺🇸" },
        { "type": "text", "id": "country", "label": "Country", "default": "United States" },
        { "type": "text", "id": "date", "label": "Date", "default": "06/15/2026" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Review title", "default": "Real results" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Great product, real difference in energy and focus." },
        { "type": "image_picker", "id": "photo", "label": "Review photo" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Reviews",
      "blocks": [
        { "type": "review", "settings": { "name": "Marcus T.", "flag": "🇺🇸", "country": "United States", "date": "06/28/2026", "rating": 5, "title": "MY ENERGY IS BACK — FOR REAL", "body": "I'm 41 and had been feeling flat for a couple of years: dragging through the afternoon, no drive in the gym, short fuse at home. Six weeks into Up Men and my mornings feel completely different. I wake up before my alarm, my lifts are climbing again, and my wife noticed the difference before I even said anything. The 90-day guarantee is what got me to try it — I won't be needing it." } },
        { "type": "review", "settings": { "name": "David R.", "flag": "🇺🇸", "country": "United States", "date": "06/11/2026", "rating": 5, "title": "Finally something that isn't hype", "body": "I've tried at least four different T-boosters over the years and this is the first one where I can actually feel the difference. Sharper at work, better sleep, and recovery between training days is noticeably faster. The ingredient doses match what the studies use, which is why I picked it in the first place." } },
        { "type": "review", "settings": { "name": "James K.", "flag": "🇨🇦", "country": "Canada", "date": "05/30/2026", "rating": 5, "title": "Third month, still impressed", "body": "Ordered the Launch Kit, now on my third month. The focus improvement showed up first (around week two), then strength and drive followed. No jitters, no crash, nothing weird — just steady improvement. The free gifts were actually useful too, especially the tracker." } },
        { "type": "review", "settings": { "name": "Robert M.", "flag": "🇺🇸", "country": "United States", "date": "05/17/2026", "rating": 5, "title": "Skeptical husband, converted", "body": "My wife bought this for me as a not-so-subtle hint. I rolled my eyes — and then a month later realized I was training four days a week again and actually had energy left after work. Bloodwork at my last checkup came back better than it's been in years. I owe her one." } }
      ]
    }
  ]
}
{% endschema %}
