{%- assign product = product -%}
{%- assign variant = product.selected_or_first_available_variant -%}

<section class="product-page" data-section-id="{{ section.id }}">
  <div class="container">
    <div class="layout">
      <div class="gallery">
        {%- if product.featured_image -%}
          <img src="{{ product.featured_image | image_url: width: 800 }}" alt="{{ product.title }}">
        {%- else -%}
          <img src="{{ 'MM_ProductImages_PDP_1x1__1.png' | asset_url }}" alt="{{ product.title }}">
        {%- endif -%}
      </div>

      <div>
        <h1>{{ product.title }}</h1>
        <p class="price">{{ variant.price | money }}</p>

        <div class="desc">{{ product.description }}</div>

        {%- form 'product', product, class: 'product-form js-product-form' -%}
          <input type="hidden" name="id" value="{{ variant.id }}" data-variant-id-input>

          {%- if product.has_only_default_variant == false -%}
            {%- for option in product.options_with_values -%}
              <div class="qty-row">
                <label>{{ option.name }}</label>
                <select name="options[{{ option.name }}]" data-option-selector data-option-index="{{ forloop.index0 }}">
                  {%- for value in option.values -%}
                    <option value="{{ value }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
                  {%- endfor -%}
                </select>
              </div>
            {%- endfor -%}
          {%- endif -%}

          <div class="qty-row">
            <label for="qty-{{ section.id }}">Quantity</label>
            <input id="qty-{{ section.id }}" type="number" name="quantity" value="1" min="1">
          </div>

          <button type="submit" class="btn btn-green btn-block btn-lg" data-submit-btn {% unless variant.available %}disabled{% endunless %}>
            {%- if variant.available -%}
              Add to Cart
            {%- else -%}
              Sold Out
            {%- endif -%}
          </button>

          {%- comment -%} Variant data for client-side option mapping {%- endcomment -%}
          <script type="application/json" data-product-variants-json>
            [
              {%- for v in product.variants -%}
                {
                  "id": {{ v.id }},
                  "available": {{ v.available }},
                  "price": {{ v.price | json }},
                  "options": {{ v.options | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Page",
  "settings": []
}
{% endschema %}
